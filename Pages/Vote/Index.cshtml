@page
@model CmsBillboard.DynamicContent.Pages.Vote.IndexModel
@{
    Layout = null;
    var survey = Model.Survey;
    bool isOnPremise = string.Equals(Model.Mode, "onpremise", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Vote: @(survey?.CampaignTitle ?? "Survey")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-body: #0A0F1D;
            --bg-card: #131C31;
            --primary: #38BDF8;
            --primary-hover: #0284C7;
            --accent: #10B981;
            --border: rgba(255, 255, 255, 0.1);
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 16px;
        }

        .container {
            max-width: 480px;
            margin: 0 auto;
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* Top Brand Header */
        .header-card {
            background: linear-gradient(135deg, #131C31, #1E293B);
            border-radius: 18px;
            border: 1px solid var(--border);
            padding: 20px;
            text-align: center;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        }

        .header-badge {
            display: inline-block;
            background: rgba(56, 189, 248, 0.15);
            color: var(--primary);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.5px;
            padding: 4px 12px;
            border-radius: 12px;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .survey-brand {
            font-size: 13px;
            font-weight: 700;
            color: #38BDF8;
            letter-spacing: 1px;
        }

        .survey-title {
            font-size: 19px;
            font-weight: 800;
            margin-top: 4px;
            line-height: 1.3;
        }

        .site-indicator {
            margin-top: 8px;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        /* Mode Banner */
        .mode-banner {
            background: rgba(245, 158, 11, 0.12);
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 14px;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: #FCD34D;
            line-height: 1.4;
        }

        /* Question Box (Mode Full) */
        .question-box {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 16px;
            font-size: 16px;
            font-weight: 700;
            color: #F1F5F9;
            line-height: 1.4;
        }

        /* Name Input Card */
        .form-group {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 16px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: #94A3B8;
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            background: #0B1120;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 15px;
            font-weight: 600;
            color: #FFFFFF;
            outline: none;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.25);
        }

        /* Option Selection Cards */
        .options-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .option-item {
            background: var(--bg-card);
            border: 2px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
        }

        .option-item:hover, .option-item:active {
            border-color: rgba(56, 189, 248, 0.5);
            background: rgba(30, 41, 59, 0.8);
        }

        .option-item.selected {
            border-color: #38BDF8;
            background: rgba(56, 189, 248, 0.12);
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.2);
        }

        .option-letter {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 18px;
            color: #FFFFFF;
            flex-shrink: 0;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        }

        .option-details {
            flex: 1;
        }

        .option-name {
            font-size: 16px;
            font-weight: 700;
            color: #FFFFFF;
        }

        .option-check {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: transparent;
            transition: all 0.2s ease;
        }

        .option-item.selected .option-check {
            border-color: #38BDF8;
            background-color: #38BDF8;
            color: #0F172A;
            font-weight: 900;
        }

        /* Submit Button */
        .btn-submit {
            background: linear-gradient(135deg, #38BDF8, #0284C7);
            color: #FFFFFF;
            border: none;
            border-radius: 16px;
            padding: 16px;
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.5px;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(2, 132, 199, 0.4);
            transition: all 0.2s ease;
            width: 100%;
            margin-top: 8px;
        }

        .btn-submit:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            box-shadow: none;
        }

        /* State Alerts */
        .alert-box {
            background: var(--bg-card);
            border-radius: 18px;
            padding: 24px 20px;
            text-align: center;
            display: none;
        }

        .alert-success {
            border: 1px solid rgba(16, 185, 129, 0.3);
            background: rgba(16, 185, 129, 0.1);
        }

        .alert-error {
            border: 1px solid rgba(239, 68, 68, 0.3);
            background: rgba(239, 68, 68, 0.1);
        }

        .alert-icon {
            font-size: 40px;
            margin-bottom: 12px;
        }

        .alert-title {
            font-size: 18px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .alert-desc {
            font-size: 14px;
            color: var(--text-muted);
            line-height: 1.4;
        }

        /* Footer */
        .footer {
            margin-top: auto;
            text-align: center;
            padding: 16px 0;
            font-size: 11px;
        /* Fullscreen Cooldown Lock Overlay (Menutupi Seluruh Layar Tanpa Perlu Scroll) */
        .cooldown-fullscreen-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(6, 10, 20, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 99999;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            box-sizing: border-box;
            animation: fadeInOverlay 0.35s ease-out;
            overflow-y: auto;
        }

        .cooldown-card {
            background: linear-gradient(135deg, rgba(17, 24, 39, 0.95), rgba(15, 23, 42, 0.98));
            border: 1px solid rgba(245, 158, 11, 0.35);
            border-radius: 28px;
            padding: clamp(24px, 5vw, 36px) clamp(20px, 4vw, 28px);
            max-width: 440px;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 16px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9), 0 0 40px rgba(245, 158, 11, 0.15);
            position: relative;
        }

        .cooldown-icon-wrap {
            position: relative;
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background: rgba(245, 158, 11, 0.15);
            border: 2px solid rgba(245, 158, 11, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
        }

        .cooldown-pulse-ring {
            position: absolute;
            inset: -8px;
            border-radius: 50%;
            border: 2px solid rgba(245, 158, 11, 0.3);
            animation: pulse-ring 2.2s infinite ease-out;
        }

        @@keyframes pulse-ring {
            0% { transform: scale(0.9); opacity: 0.8; }
            50% { transform: scale(1.15); opacity: 0.2; }
            100% { transform: scale(1.3); opacity: 0; }
        }

        .cooldown-badge {
            background: rgba(245, 158, 11, 0.18);
            border: 1px solid rgba(245, 158, 11, 0.45);
            color: #FCD34D;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.5px;
            padding: 5px 14px;
            border-radius: 20px;
            text-transform: uppercase;
        }

        .cooldown-title {
            font-size: clamp(20px, 4.5vw, 24px);
            font-weight: 900;
            color: #FFFFFF;
            line-height: 1.25;
            margin-top: -4px;
        }

        .cooldown-desc {
            font-size: 13px;
            color: #CBD5E1;
            line-height: 1.55;
        }

        .cooldown-timer-box {
            background: rgba(0, 0, 0, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 16px 20px;
            width: 100%;
            box-sizing: border-box;
            box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.5);
        }

        .cooldown-timer-label {
            font-size: 10px;
            font-weight: 800;
            color: #94A3B8;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .cooldown-timer-digits {
            font-size: clamp(38px, 10vw, 54px);
            font-weight: 900;
            color: #F59E0B;
            letter-spacing: 3px;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            text-shadow: 0 0 20px rgba(245, 158, 11, 0.5);
            line-height: 1.1;
            margin: 6px 0 10px 0;
        }

        .cooldown-progress-bar {
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            overflow: hidden;
        }

        .cooldown-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #F59E0B, #10B981);
            border-radius: 10px;
            transition: width 0.5s ease;
        }

        .cooldown-meta-info {
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 100%;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 14px;
            padding: 12px 14px;
            font-size: 12px;
            color: #E2E8F0;
            box-sizing: border-box;
        }

        .cooldown-meta-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .cooldown-choice-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(56, 189, 248, 0.15);
            border: 1px solid rgba(56, 189, 248, 0.35);
            color: #38BDF8;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .cooldown-footer-hint {
            font-size: 11px;
            color: #94A3B8;
            line-height: 1.5;
        }

        @@keyframes fadeInOverlay {
            from { opacity: 0; transform: scale(0.97); }
            to { opacity: 1; transform: scale(1); }
        }
    </style>
</head>
<body>
    <div class="container">
        
        @if (!Model.IsTokenValid)
        {
            <!-- Security Error Alert when Token is Tampered/Expired -->
            <div class="alert-box alert-error" style="display: block; margin-top: 40px;">
                <div class="alert-icon">⛔</div>
                <h2 class="alert-title">Akses Ditolak: Token Tidak Sah</h2>
                <p class="alert-desc">@Model.TokenErrorMessage</p>
                <p class="alert-desc" style="margin-top: 12px; font-size: 12px; color: #94A3B8;">
                    Tautan QR Code ini tidak valid, parameternya telah dimodifikasi, atau masa berlaku token telah habis. Silakan scan ulang dari layar Videotron.
                </p>
            </div>
        }
        else
        {
            <!-- Header -->
            <header class="header-card">
                @{
                    bool isBrandGenius = string.Equals(survey?.ContentType, "BrandGenius", StringComparison.OrdinalIgnoreCase);
                    bool isQuiz = string.Equals(survey?.ContentType, "BrandIQ", StringComparison.OrdinalIgnoreCase);
                }
                <span class="header-badge" style="@(isBrandGenius ? "background: rgba(245, 158, 11, 0.2); color: #FCD34D;" : (isQuiz ? "background: rgba(16, 185, 129, 0.2); color: #6EE7B7;" : ""))">
                    @(isBrandGenius ? "🎯 BRAND GENIUS GAME" : (isQuiz ? "🧠 BRANDIQ QUIZ" : "WARNA WARNI DOOH"))
                </span>
                <div class="survey-brand">@(survey?.ClientName ?? "Brand")</div>
                <h1 class="survey-title">@(survey?.CampaignTitle ?? "Survey")</h1>
                <div class="site-indicator">
                    <span>📍 Lokasi Layar:</span>
                    <strong style="color:#38BDF8;">@Model.Site</strong>
                </div>
            </header>

            <!-- Mode Notification -->
            @if (isBrandGenius)
            {
                <div class="mode-banner" style="background: rgba(245, 158, 11, 0.15); border-color: rgba(245, 158, 11, 0.4); color: #FCD34D;">
                    <span style="font-size: 24px;">👀</span>
                    <div>
                        <strong style="font-size: 14px;">Mode On-Premise Brand Genius:</strong>
                        <div style="font-size: 12px; margin-top: 2px;">Potongan logo disamarkan di layar HP! Perhatikan layar Videotron di depan Anda untuk melengkapi dan menebak brand/jingle dengan tepat.</div>
                    </div>
                </div>
            }
            else if (isOnPremise)
            {
                <div class="mode-banner">
                    <span style="font-size: 20px;">👀</span>
                    <div>
                        <strong>Mode On-Premise:</strong>
                        <div>Pertanyaan dan live hasil ditampilkan di layar Videotron di hadapan Anda.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="question-box">
                    ❓ @(Model.Question?.QuestionText ?? "Silakan pilih jawaban Anda:")
                </div>
            }

            <!-- Success Alert (Shown if already voted or after successful vote) -->
            <div id="successCard" class="alert-box alert-success">
                <div class="alert-icon" id="successIcon">🎉</div>
                <h2 class="alert-title" id="successTitle">Voting Terkirim!</h2>
                <p class="alert-desc" id="successDesc">
                    Terima kasih telah berpartisipasi! Pilihan Anda telah tercatat dan langsung dihitung pada live score di layar Videotron.
                </p>
                <div id="votedChoiceBadge" style="margin-top: 14px; font-weight: 700; color: #10B981;"></div>
                
                @if (isBrandGenius || survey?.ParticipationMode == "multipletime")
                {
                    <div id="playAgainContainer" style="margin-top: 18px;">
                        <button type="button" onclick="playAgain()" class="btn-submit" style="background: linear-gradient(135deg, #F59E0B, #D97706); box-shadow: 0 8px 20px rgba(217, 119, 6, 0.4);">
                            🔄 Coba Tebak Lagi (Main Lagi)
                        </button>
                    </div>
                }
            </div>

            <!-- Error Alert -->
            <div id="errorCard" class="alert-box alert-error">
                <div class="alert-icon">⚠️</div>
                <h2 class="alert-title" id="errorTitle">Pemberitahuan</h2>
                <p class="alert-desc" id="errorDesc"></p>
            </div>

            <!-- Voting Form Container -->
            <form id="voteForm" onsubmit="handleVoteSubmit(event)">
                
                @if (!string.IsNullOrWhiteSpace(survey?.WelcomeMessage))
                {
                    <div style="background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 12px; padding: 12px 16px; margin-bottom: 12px; font-size: 13px; color: #38BDF8;">
                        👋 @survey.WelcomeMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(survey?.InstructionComment))
                {
                    <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 12px; padding: 10px 14px; margin-bottom: 14px; font-size: 12px; color: #FCD34D;">
                        ℹ️ @survey.InstructionComment
                    </div>
                }

                <!-- User Name Input -->
                <div class="form-group" style="margin-bottom: 12px;">
                    <label class="form-label" for="userNameInput">Nama Anda (Panggilan):</label>
                    <input type="text" id="userNameInput" class="form-control" placeholder="Contoh: Budi, Lisa, dll." maxlength="50" required />
                </div>

                <!-- Phone Number Input (Revisi Bos: Name | Phone) -->
                <div class="form-group" style="margin-bottom: 14px;">
                    <label class="form-label" for="phoneInput">Nomor WhatsApp / HP:</label>
                    <input type="tel" id="phoneInput" class="form-control" placeholder="Contoh: 081234567890" maxlength="20" />
                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Digunakan untuk verifikasi partisipasi & hadiah.</div>
                </div>

                <!-- Options Cards -->
                <div class="options-group">
                    @if (Model.Question?.Options != null)
                    {
                        foreach (var opt in Model.Question.Options)
                        {
                            <div class="option-item" onclick="selectOption('@opt.OptionKey')" id="optItem-@opt.OptionKey">
                                <div class="option-letter" style="background-color: @opt.ColorHex;">
                                    @opt.OptionKey
                                </div>
                                @if (!string.IsNullOrWhiteSpace(opt.OptionImageUrl))
                                {
                                    <img src="@opt.OptionImageUrl" alt="" style="width: 36px; height: 36px; border-radius: 8px; object-fit: cover; margin-right: 10px;" />
                                }
                                <div class="option-details">
                                    <div class="option-name">@opt.OptionText</div>
                                </div>
                                <div class="option-check" id="check-@opt.OptionKey">✓</div>
                            </div>
                        }
                    }
                </div>

                <!-- Submit Button -->
                <button type="submit" id="submitBtn" class="btn-submit" disabled>
                    Pilih Opsi Terlebih Dahulu
                </button>
            </form>
        }

        <!-- Footer -->
        <footer class="footer">
            Warna Warni Advertising &copy; 2026 — Dynamic DOOH Interactive
        </footer>

    </div>

    <!-- Fullscreen Cooldown Lock Overlay (Menutupi Seluruh Layar Tanpa Perlu Scroll) -->
    <div id="cooldownFullscreenOverlay" class="cooldown-fullscreen-overlay">
        <div class="cooldown-card">
            <div class="cooldown-icon-wrap">
                <span class="cooldown-icon">⏳</span>
                <div class="cooldown-pulse-ring"></div>
            </div>
            <div class="cooldown-badge">JEDA PARTISIPASI AKTIF</div>
            <h2 class="cooldown-title">Sesi Anda Sedang Istirahat</h2>
            <p class="cooldown-desc" id="fsCooldownDesc">
                Suara Anda telah tercatat dan ditayangkan di layar Videotron! Demi ketertiban bersama, Anda dapat berpartisipasi kembali setelah jeda waktu selesai:
            </p>

            <!-- Giant Digital Countdown Timer -->
            <div class="cooldown-timer-box">
                <div class="cooldown-timer-label">WAKTU TERSISA</div>
                <div id="fsCooldownTimer" class="cooldown-timer-digits">10:00</div>
                <div class="cooldown-progress-bar">
                    <div id="fsCooldownProgress" class="cooldown-progress-fill" style="width: 100%;"></div>
                </div>
            </div>

            <div class="cooldown-meta-info">
                <div class="cooldown-meta-item">
                    <span>📍</span>
                    <span>Lokasi Layar: <strong id="fsCooldownSite">@Model.Site</strong></span>
                </div>
                <div class="cooldown-meta-item">
                    <span>⏱️</span>
                    <span>Jeda Waktu: <strong id="fsCooldownGap">@(survey?.GapDurationMinutes ?? 10) Menit</strong></span>
                </div>
                <div class="cooldown-meta-item" id="fsCooldownChoiceWrap" style="display: none;">
                    <span>🎯</span>
                    <span>Pilihan Terakhir: <strong id="fsCooldownChoiceKey" class="cooldown-choice-badge">Opsi A</strong></span>
                </div>
            </div>

            <div class="cooldown-footer-hint">
                💡 Layar ini akan terbuka secara otomatis begitu hitungan mundur selesai. Silakan perhatikan hasil polling langsung di layar Videotron!
            </div>
        </div>
    </div>

    @if (Model.IsTokenValid)
    {
        <script>
            const surveyId = "@Model.Id";
            const siteId = "@Model.Site";
            const voteToken = "@Model.Token";
            let selectedOptionKey = null;

            // Persistent Device Fingerprint
            function getDeviceFingerprint() {
                let fp = localStorage.getItem("dc_device_fp");
                if (!fp) {
                    fp = "dev_" + Math.random().toString(36).substring(2, 12) + "_" + Date.now();
                    localStorage.setItem("dc_device_fp", fp);
                }
                return fp;
            }

            const deviceFingerprint = getDeviceFingerprint();

            // Geolocation Detection (Revisi Bos: locationTag detect)
            const locationTagDetect = @(Model.Survey?.LocationTagDetect == true ? "true" : "false");
            let userLat = null;
            let userLng = null;

            if (locationTagDetect && navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (pos) => {
                        userLat = pos.coords.latitude;
                        userLng = pos.coords.longitude;
                        console.log("GPS Location captured:", userLat, userLng);
                    },
                    (err) => {
                        console.warn("GPS Location access:", err.message);
                    },
                    { timeout: 8000, enableHighAccuracy: true }
                );
            }

            // Fullscreen Cooldown Management
            let cooldownRemainingSeconds = 0;
            let totalCooldownDuration = 600;
            let waitInterval = null;

            const cooldownFullscreenOverlay = document.getElementById("cooldownFullscreenOverlay");
            const fsCooldownTimer = document.getElementById("fsCooldownTimer");
            const fsCooldownProgress = document.getElementById("fsCooldownProgress");
            const fsCooldownChoiceWrap = document.getElementById("fsCooldownChoiceWrap");
            const fsCooldownChoiceKey = document.getElementById("fsCooldownChoiceKey");

            function startCooldownTimer(seconds, totalSeconds = 600, choiceKey = null) {
                cooldownRemainingSeconds = seconds;
                totalCooldownDuration = Math.max(seconds, totalSeconds);

                if (choiceKey && fsCooldownChoiceWrap && fsCooldownChoiceKey) {
                    fsCooldownChoiceKey.textContent = `Opsi ${choiceKey}`;
                    fsCooldownChoiceWrap.style.display = "flex";
                }

                if (waitInterval) clearInterval(waitInterval);

                updateTimerDisplay();

                const successCard = document.getElementById("successCard");
                if (successCard && successCard.style.display === "block") {
                    setTimeout(() => {
                        if (cooldownRemainingSeconds > 0) {
                            successCard.style.display = "none";
                            if (cooldownFullscreenOverlay) cooldownFullscreenOverlay.style.display = "flex";
                        }
                    }, 4000);
                } else {
                    if (cooldownFullscreenOverlay) cooldownFullscreenOverlay.style.display = "flex";
                }

                waitInterval = setInterval(() => {
                    cooldownRemainingSeconds--;
                    if (cooldownRemainingSeconds <= 0) {
                        stopCooldownTimer();
                    } else {
                        updateTimerDisplay();
                    }
                }, 1000);
            }

            function updateTimerDisplay() {
                const mins = Math.floor(cooldownRemainingSeconds / 60);
                const secs = cooldownRemainingSeconds % 60;
                const str = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
                if (fsCooldownTimer) fsCooldownTimer.textContent = str;

                if (fsCooldownProgress) {
                    const pct = Math.max(0, Math.min(100, (cooldownRemainingSeconds / totalCooldownDuration) * 100));
                    fsCooldownProgress.style.width = `${pct}%`;
                }
            }

            function stopCooldownTimer() {
                if (waitInterval) clearInterval(waitInterval);
                cooldownRemainingSeconds = 0;
                if (cooldownFullscreenOverlay) cooldownFullscreenOverlay.style.display = "none";
                playAgain();
            }

            // Check if user already voted locally or on server
            async function checkAlreadyVoted() {
                try {
                    const res = await fetch(`/api/survey/check-wait-time?surveyId=${encodeURIComponent(surveyId)}&fingerprint=${encodeURIComponent(deviceFingerprint)}`);
                    if (res.ok) {
                        const data = await res.json();
                        if (data.isCooldown && data.remainingSeconds > 0) {
                            const lastChoice = localStorage.getItem(`voted_${surveyId}`);
                            startCooldownTimer(data.remainingSeconds, (data.gapMinutes || 10) * 60, lastChoice);
                            return;
                        } else if (data.isOneTimeDone) {
                            const localVote = localStorage.getItem(`voted_${surveyId}`);
                            showAlreadyVotedState(localVote);
                            return;
                        }
                    }
                } catch (err) {
                    console.error("Check wait time error:", err);
                }

                const localVote = localStorage.getItem(`voted_${surveyId}`);
                if (localVote) {
                    showAlreadyVotedState(localVote);
                }
            }

            function showAlreadyVotedState(chosenKey) {
                const voteForm = document.getElementById("voteForm");
                if (voteForm) voteForm.style.display = "none";
                const successCard = document.getElementById("successCard");
                const successTitle = document.getElementById("successTitle");
                const successDesc = document.getElementById("successDesc");
                const badge = document.getElementById("votedChoiceBadge");

                if (successTitle) successTitle.innerText = "Anda Sudah Memberikan Suara!";
                if (successDesc) successDesc.innerText = "Sistem menerapkan aturan 1 Perangkat = 1 Kali Vote. Terima kasih atas partisipasi Anda!";
                if (badge && chosenKey) {
                    badge.innerText = `Pilihan Anda: Opsi ${chosenKey}`;
                }
                if (successCard) successCard.style.display = "block";
            }

            // Option Selection
            function selectOption(key) {
                selectedOptionKey = key;

                // Remove selected class from all
                document.querySelectorAll(".option-item").forEach(item => {
                    item.classList.remove("selected");
                });

                // Add selected class to clicked
                const selectedItem = document.getElementById(`optItem-${key}`);
                if (selectedItem) {
                    selectedItem.classList.add("selected");
                }

                // Update submit button
                const submitBtn = document.getElementById("submitBtn");
                submitBtn.disabled = false;
                submitBtn.innerText = `KIRIM SUARA: OPSI ${key}`;
            }

            // Telemetry Detection
            const pageLoadTime = Date.now();

            function getDeviceTelemetry() {
                const ua = navigator.userAgent || "";
                let deviceType = "Mobile";
                if (/(tablet|ipad|playbook|silk)|(android(?!.*mobi))/i.test(ua)) {
                    deviceType = "Tablet";
                } else if (!/Mobile|Android|iP(hone|od)|IEMobile|BlackBerry|Kindle|Silk-Accelerated/i.test(ua)) {
                    deviceType = "Desktop";
                }

                let brand = "Other";
                let model = "";
                let os = "Unknown";
                let browser = "Unknown";

                if (/iPhone|iPad|iPod/i.test(ua)) {
                    os = "iOS";
                    brand = "Apple";
                    model = /iPhone/i.test(ua) ? "iPhone" : "iPad";
                } else if (/Android/i.test(ua)) {
                    os = "Android";
                    if (/Samsung|SM-|GT-/i.test(ua)) brand = "Samsung";
                    else if (/Xiaomi|Redmi|POCO/i.test(ua)) brand = "Xiaomi";
                    else if (/Oppo|CPH/i.test(ua)) brand = "Oppo";
                    else if (/Vivo|V2/i.test(ua)) brand = "Vivo";
                    else if (/Realme|RMX/i.test(ua)) brand = "Realme";
                    else if (/Pixel/i.test(ua)) brand = "Google Pixel";
                    else brand = "Android Generic";
                } else if (/Windows/i.test(ua)) {
                    os = "Windows";
                    brand = "PC";
                } else if (/Macintosh|Mac OS X/i.test(ua)) {
                    os = "macOS";
                    brand = "Apple Mac";
                }

                if (/Instagram/i.test(ua)) browser = "Instagram App";
                else if (/TikTok/i.test(ua)) browser = "TikTok App";
                else if (/FBAN|FBAV/i.test(ua)) browser = "Facebook App";
                else if (/SamsungBrowser/i.test(ua)) browser = "Samsung Internet";
                else if (/Chrome/i.test(ua) && !/Edg/i.test(ua)) browser = "Chrome";
                else if (/Safari/i.test(ua) && !/Chrome/i.test(ua)) browser = "Safari";
                else if (/Edg/i.test(ua)) browser = "Edge";
                else if (/Firefox/i.test(ua)) browser = "Firefox";

                const screenRes = `${window.screen.width}x${window.screen.height}`;
                const userLang = navigator.language || navigator.userLanguage || "id-ID";
                const timeToVote = Math.round((Date.now() - pageLoadTime) / 100) / 10;

                return {
                    deviceType,
                    deviceBrand: brand,
                    deviceModel: model,
                    operatingSystem: os,
                    browserName: browser,
                    screenResolution: screenRes,
                    userLanguage: userLang,
                    timeToVoteSeconds: timeToVote,
                    userAgent: ua.substring(0, 500)
                };
            }

            // Handle Form Submission
            async function handleVoteSubmit(event) {
                event.preventDefault();
                if (!selectedOptionKey) return;

                const submitBtn = document.getElementById("submitBtn");
                submitBtn.disabled = true;
                submitBtn.innerText = "Mengirim Suara...";

                const userName = document.getElementById("userNameInput").value.trim() || "Audiens Mobile";
                const phoneInput = document.getElementById("phoneInput");
                const phoneNumber = phoneInput ? phoneInput.value.trim() : null;
                const tel = getDeviceTelemetry();

                const payload = {
                    token: voteToken,
                    surveyId: surveyId,
                    questionId: @(Model.Question?.Id ?? 0),
                    optionKey: selectedOptionKey,
                    userName: userName,
                    phoneNumber: phoneNumber,
                    siteId: siteId,
                    deviceFingerprint: deviceFingerprint,
                    deviceType: tel.deviceType,
                    deviceBrand: tel.deviceBrand,
                    deviceModel: tel.deviceModel,
                    operatingSystem: tel.operatingSystem,
                    browserName: tel.browserName,
                    screenResolution: tel.screenResolution,
                    userLanguage: tel.userLanguage,
                    timeToVoteSeconds: tel.timeToVoteSeconds,
                    userAgent: tel.userAgent,
                    latitude: userLat,
                    longitude: userLng
                };

                try {
                    const response = await fetch("/api/survey/vote", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                        // Save to local storage to block subsequent attempts
                        localStorage.setItem(`voted_${surveyId}`, selectedOptionKey);
                        if (result.isCorrect !== undefined && result.isCorrect !== null) {
                            localStorage.setItem(`voted_correct_${surveyId}`, result.isCorrect ? "true" : "false");
                            if (result.correctOptionKey) {
                                localStorage.setItem(`voted_key_${surveyId}`, result.correctOptionKey);
                            }
                        }
                        
                        document.getElementById("voteForm").style.display = "none";
                        const iconEl = document.getElementById("successIcon");
                        const titleEl = document.getElementById("successTitle");
                        const descEl = document.getElementById("successDesc");
                        const badgeEl = document.getElementById("votedChoiceBadge");

                        if (result.isCorrect === true) {
                            if (iconEl) iconEl.innerText = "🏆";
                            if (titleEl) {
                                titleEl.innerText = "Luar Biasa, Jawaban Anda BENAR!";
                                titleEl.style.color = "#10B981";
                            }
                            if (descEl) descEl.innerText = result.message || "Pilihan Anda tepat! Skor Anda telah masuk ke live counter di layar Videotron.";
                            if (badgeEl) {
                                badgeEl.innerHTML = `<div style="display:inline-flex; align-items:center; gap:8px; padding: 8px 16px; background: rgba(16, 185, 129, 0.15); border: 1px solid #10B981; border-radius: 20px; color: #6EE7B7; font-weight:800;"><span>✓ OPSI ${selectedOptionKey}</span><span style="font-size:12px; background:#10B981; color:#0A0F1D; padding:2px 8px; border-radius:10px;">BENAR</span></div>`;
                            }
                        } else if (result.isCorrect === false) {
                            if (iconEl) iconEl.innerText = "❌";
                            if (titleEl) {
                                titleEl.innerText = "Tebakan Belum Tepat!";
                                titleEl.style.color = "#F87171";
                            }
                            if (descEl) descEl.innerText = result.message || "Pilihan Anda belum tepat.";
                            if (badgeEl) {
                                badgeEl.innerHTML = `<div style="display:inline-flex; flex-direction:column; gap:6px; align-items:center;"><div style="padding: 6px 14px; background: rgba(239, 68, 68, 0.15); border: 1px solid #EF4444; border-radius: 20px; color: #FCA5A5; font-size:13px; font-weight:700;">Pilihan Anda: Opsi ${selectedOptionKey} (Salah)</div><div style="color: #6EE7B7; font-size: 13px; font-weight:700;">🎯 Kunci Jawaban: Opsi ${result.correctOptionKey || ''}</div></div>`;
                            }
                        } else {
                            if (iconEl) iconEl.innerText = "🎉";
                            if (titleEl) {
                                titleEl.innerText = "Voting Terkirim!";
                                titleEl.style.color = "#FFFFFF";
                            }
                            if (descEl) descEl.innerText = "Terima kasih telah berpartisipasi! Pilihan Anda telah tercatat dan langsung dihitung pada live score di layar Videotron.";
                            if (badgeEl) badgeEl.innerText = `Pilihan Anda: Opsi ${selectedOptionKey}`;
                        }

                        document.getElementById("successCard").style.display = "block";

                        if (result.remainingSeconds > 0) {
                            startCooldownTimer(result.remainingSeconds, (result.gapDurationMinutes || 10) * 60, selectedOptionKey);
                        }
                    } else {
                        if (response.status === 429 && result.remainingSeconds > 0) {
                            startCooldownTimer(result.remainingSeconds, (result.gapDurationMinutes || 10) * 60, selectedOptionKey);
                        }
                        document.getElementById("errorDesc").innerText = result.message || "Gagal mengirimkan suara.";
                        document.getElementById("errorCard").style.display = "block";
                        submitBtn.disabled = false;
                        submitBtn.innerText = `KIRIM SUARA: OPSI ${selectedOptionKey}`;
                    }
                } catch (err) {
                    console.error("Submission failed:", err);
                    document.getElementById("errorDesc").innerText = "Koneksi ke server bermasalah. Silakan coba lagi.";
                    document.getElementById("errorCard").style.display = "block";
                    submitBtn.disabled = false;
                    submitBtn.innerText = `KIRIM SUARA: OPSI ${selectedOptionKey}`;
                }
            }

            // Function for Brand Genius & Multi-time play: Try Again
            function playAgain() {
                localStorage.removeItem(`voted_${surveyId}`);
                localStorage.removeItem(`voted_correct_${surveyId}`);
                localStorage.removeItem(`voted_key_${surveyId}`);

                selectedOptionKey = null;
                document.querySelectorAll(".option-item").forEach(item => item.classList.remove("selected"));

                const submitBtn = document.getElementById("submitBtn");
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerText = "Pilih Opsi Terlebih Dahulu";
                }

                const successCard = document.getElementById("successCard");
                if (successCard) successCard.style.display = "none";

                const errorCard = document.getElementById("errorCard");
                if (errorCard) errorCard.style.display = "none";

                const form = document.getElementById("voteForm");
                if (form) form.style.display = "block";

                window.scrollTo({ top: 0, behavior: "smooth" });
            }

            // Initialize on page load
            checkAlreadyVoted();
        </script>
    }
</body>
</html>
