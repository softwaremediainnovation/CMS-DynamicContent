@page
@model CmsBillboard.DynamicContent.Pages.Screen.DynamicContentModel
@{
    Layout = null;
    var survey = Model.DynamicContentResult;
}
@if (!Model.IsTokenValid)
{
    <!DOCTYPE html>
    <html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Akses Layar Ditolak — Warna Warni Dynamic DOOH</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
        <style>
            body {
                background: #070B14;
                color: #FFFFFF;
                font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
                margin: 0;
                background-image: radial-gradient(circle at 50% 50%, rgba(239, 68, 68, 0.12) 0%, transparent 60%);
            }
            .error-card {
                background: rgba(15, 23, 42, 0.95);
                border: 1px solid rgba(239, 68, 68, 0.4);
                border-radius: 24px;
                padding: clamp(24px, 4vh, 44px);
                max-width: 520px;
                width: 100%;
                text-align: center;
                box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(239, 68, 68, 0.2);
            }
            .error-icon {
                font-size: 54px;
                margin-bottom: 16px;
                animation: pulse-warn 2s infinite ease-in-out;
            }
            @@keyframes pulse-warn {
                0%, 100% { transform: scale(1); }
                50% { transform: scale(1.08); }
            }
            .error-title {
                color: #EF4444;
                font-size: clamp(20px, 2.2vw, 26px);
                font-weight: 900;
                margin-bottom: 12px;
                letter-spacing: 0.5px;
            }
            .error-desc {
                color: #CBD5E1;
                font-size: 15px;
                line-height: 1.6;
                margin-bottom: 22px;
            }
            .error-meta {
                background: rgba(0, 0, 0, 0.35);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                padding: 12px 16px;
                font-size: 13px;
                color: #94A3B8;
                font-family: monospace;
                word-break: break-all;
            }
        </style>
    </head>
    <body>
        <div class="error-card">
            <div class="error-icon">🛡️</div>
            <h1 class="error-title">AKSES LAYAR DITOLAK</h1>
            <p class="error-desc">@(Model.TokenErrorMessage ?? "Token otorisasi layar tidak valid atau telah dimodifikasi secara ilegal.")</p>
            <div class="error-meta">Status: 401 Unauthorized</div>
        </div>
    </body>
    </html>
    return;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <title>@(survey?.CampaignTitle ?? "Interactive DOOH Survey") — Warna Warni Advertising</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-base: #070B14;
            --bg-card: rgba(15, 23, 42, 0.75);
            --border-card: rgba(56, 189, 248, 0.2);
            --primary: #38BDF8;
            --accent: #F43F5E;
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;

            /* Responsive Scaling Variables */
            --pad-x: clamp(12px, 2.5vw, 40px);
            --pad-y: clamp(10px, 1.8vh, 28px);
            --gap-main: clamp(12px, 2vw, 32px);
            --title-size: clamp(18px, 2vw, 32px);
            --question-size: clamp(13px, 1.3vw, 20px);
            --opt-text-size: clamp(12px, 1.1vw, 17px);
            --qr-size: clamp(135px, 18vh, 195px);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(30, 58, 138, 0.25) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(13, 148, 136, 0.2) 0%, transparent 40%);
        }

        /* Top Bar */
        .top-navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: clamp(8px, 1.4vh, 18px) var(--pad-x);
            background: rgba(11, 19, 36, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            z-index: 100;
            flex-shrink: 0;
        }

        .brand-badge {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-logo-text {
            font-size: clamp(16px, 1.5vw, 20px);
            font-weight: 900;
            letter-spacing: 2px;
            background: linear-gradient(135deg, #FF3366, #FF9933);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .brand-subtext {
            font-size: clamp(10px, 0.9vw, 13px);
            font-weight: 600;
            color: var(--text-muted);
            letter-spacing: 1px;
            padding-left: 12px;
            border-left: 2px solid rgba(255, 255, 255, 0.2);
        }

        .header-meta {
            display: flex;
            align-items: center;
            gap: clamp(8px, 1vw, 16px);
        }

        .location-tag {
            background: rgba(56, 189, 248, 0.12);
            color: #38BDF8;
            border: 1px solid rgba(56, 189, 248, 0.3);
            padding: 5px clamp(10px, 1vw, 16px);
            border-radius: 20px;
            font-size: clamp(10px, 0.9vw, 13px);
            font-weight: 700;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .live-tag {
            background: rgba(239, 68, 68, 0.15);
            color: #EF4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
            padding: 5px clamp(10px, 1vw, 16px);
            border-radius: 20px;
            font-size: clamp(10px, 0.9vw, 13px);
            font-weight: 800;
            letter-spacing: 1.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #EF4444;
            box-shadow: 0 0 10px #EF4444;
            animation: pulse-red 1.5s infinite;
        }

        @@keyframes pulse-red {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.4); opacity: 1; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }

        /* Main Workspace: Split View (Default Landscape) */
        .main-stage {
            flex: 1;
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            gap: var(--gap-main);
            padding: var(--pad-y) var(--pad-x);
            min-height: 0;
            overflow: hidden;
        }

        /* Left Pane: Advertising Creative */
        .ad-container {
            background: #0B132B;
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            overflow: hidden;
            position: relative;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .ad-container img, .ad-container svg {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        /* Right Pane: Interactive Survey & Results */
        .survey-container {
            background: var(--bg-card);
            border-radius: 24px;
            border: 1px solid var(--border-card);
            backdrop-filter: blur(20px);
            padding: clamp(14px, 2.2vh, 32px) clamp(16px, 2.2vw, 36px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            min-height: 0;
            overflow: hidden;
        }

        .survey-header-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #38BDF8;
            font-size: clamp(10px, 0.9vw, 13px);
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: clamp(4px, 0.8vh, 10px);
        }

        .survey-title {
            font-size: var(--title-size);
            font-weight: 800;
            line-height: 1.25;
            color: #FFFFFF;
            margin-bottom: 4px;
        }

        .survey-question {
            font-size: var(--question-size);
            font-weight: 600;
            color: #94A3B8;
            margin-bottom: clamp(10px, 1.6vh, 22px);
        }

        /* Options Bars */
        .options-list {
            display: flex;
            flex-direction: column;
            gap: clamp(8px, 1.2vh, 14px);
            margin-bottom: clamp(10px, 1.6vh, 24px);
            min-height: 0;
        }

        .option-card {
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: clamp(8px, 1.1vh, 14px) clamp(12px, 1.4vw, 18px);
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .option-card.vote-flash {
            animation: card-flash 1s ease-out;
        }

        @@keyframes card-flash {
            0% { transform: scale(1.02); border-color: #38BDF8; box-shadow: 0 0 20px rgba(56, 189, 248, 0.5); }
            100% { transform: scale(1); border-color: rgba(255, 255, 255, 0.08); box-shadow: none; }
        }

        .option-progress-bg {
            width: 0;
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            background: rgba(56, 189, 248, 0.2);
            border-radius: 14px;
            transition: width 0.7s cubic-bezier(0.25, 1, 0.5, 1);
            z-index: 1;
        }

        .option-content {
            position: relative;
            z-index: 2;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .option-left {
            display: flex;
            align-items: center;
            gap: clamp(8px, 1vw, 14px);
            min-width: 0;
        }

        .option-badge {
            width: clamp(26px, 2.5vw, 34px);
            height: clamp(26px, 2.5vw, 34px);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: clamp(12px, 1.1vw, 15px);
            color: #FFFFFF;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            flex-shrink: 0;
        }

        .option-text {
            font-size: var(--opt-text-size);
            font-weight: 700;
            color: #F8FAFC;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .option-right {
            display: flex;
            align-items: baseline;
            gap: clamp(6px, 0.8vw, 10px);
            flex-shrink: 0;
        }

        .option-percent {
            font-size: clamp(16px, 1.8vw, 24px);
            font-weight: 900;
            color: #FFFFFF;
        }

        .option-count {
            font-size: clamp(10px, 0.9vw, 13px);
            font-weight: 600;
            color: #94A3B8;
        }

        /* Bottom Call To Action & QR */
        .bottom-cta-box {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: clamp(12px, 1.5vw, 22px);
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid rgba(56, 189, 248, 0.3);
            border-radius: 18px;
            padding: clamp(10px, 1.4vh, 16px) clamp(12px, 1.5vw, 20px);
            align-items: center;
            flex-shrink: 0;
        }

        .qr-frame {
            background: #FFFFFF !important;
            padding: 8px;
            border-radius: 14px;
            width: var(--qr-size);
            height: var(--qr-size);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
            flex-shrink: 0;
            color-scheme: light !important;
            forced-color-adjust: none !important;
            cursor: pointer;
            position: relative;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .qr-frame:hover {
            transform: scale(1.03);
            box-shadow: 0 0 25px rgba(56, 189, 248, 0.5);
        }

        .qr-zoom-badge {
            position: absolute;
            bottom: -9px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(15, 23, 42, 0.95);
            color: #38BDF8;
            border: 1px solid rgba(56, 189, 248, 0.4);
            border-radius: 12px;
            padding: 2px 8px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
            pointer-events: none;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .qr-frame canvas,
        .qr-frame img,
        .qr-frame svg {
            width: 100% !important;
            height: 100% !important;
            max-width: 100% !important;
            max-height: 100% !important;
            object-fit: contain;
            border-radius: 6px;
            background: #FFFFFF !important;
            color-scheme: light !important;
            forced-color-adjust: none !important;
            display: block;
        }

        /* Fullscreen / Pop-up QR Modal */
        .qr-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(7, 11, 20, 0.88);
            backdrop-filter: blur(14px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        .qr-modal.active {
            display: flex;
            opacity: 1;
        }

        .qr-modal-content {
            background: #0F172A;
            border: 1px solid rgba(56, 189, 248, 0.4);
            border-radius: 24px;
            padding: clamp(20px, 3vh, 36px);
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            max-width: 90vw;
            position: relative;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 40px rgba(56, 189, 248, 0.25);
            animation: modal-pop 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes modal-pop {
            0% { transform: scale(0.9); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .qr-modal-close {
            position: absolute;
            top: 14px;
            right: 18px;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: #FFFFFF;
            font-size: 24px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }

        .qr-modal-close:hover {
            background: rgba(239, 68, 68, 0.4);
        }

        .qr-modal-title {
            font-size: clamp(18px, 2vw, 24px);
            font-weight: 800;
            color: #FFFFFF;
            margin-bottom: 4px;
        }

        .qr-modal-subtitle {
            font-size: clamp(12px, 1.1vw, 14px);
            color: #94A3B8;
            margin-bottom: 18px;
        }

        .qr-modal-frame {
            background: #FFFFFF !important;
            padding: 14px;
            border-radius: 18px;
            width: clamp(260px, 42vh, 400px);
            height: clamp(260px, 42vh, 400px);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            margin-bottom: 16px;
        }

        .qr-modal-frame canvas,
        .qr-modal-frame img,
        .qr-modal-frame svg {
            width: 100% !important;
            height: 100% !important;
            object-fit: contain;
            display: block;
        }

        .qr-modal-tip {
            font-size: 12px;
            color: #64748B;
        }

        .cta-content {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
        }

        .cta-heading {
            font-size: clamp(13px, 1.2vw, 16px);
            font-weight: 800;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .cta-instruction {
            font-size: clamp(11px, 0.9vw, 13px);
            font-weight: 500;
            color: #94A3B8;
            line-height: 1.35;
        }

        .cta-meta-row {
            display: flex;
            align-items: center;
            gap: clamp(8px, 1vw, 16px);
            margin-top: 4px;
        }

        .total-badge {
            background: rgba(16, 185, 129, 0.15);
            color: #10B981;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: clamp(10px, 0.8vw, 12px);
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .rule-badge {
            background: rgba(245, 158, 11, 0.15);
            color: #F59E0B;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: clamp(10px, 0.8vw, 12px);
            font-weight: 700;
        }

        /* Brand Genius LED Right / Wrong Counter Badges */
        .brandgenius-stats-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .stat-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 14px;
            font-size: clamp(11px, 0.9vw, 13px);
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .stat-pill-right {
            background: rgba(16, 185, 129, 0.18);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: #10B981;
        }

        .stat-pill-wrong {
            background: rgba(239, 68, 68, 0.18);
            border: 1px solid rgba(239, 68, 68, 0.4);
            color: #F87171;
        }

        .stat-pill-accuracy {
            background: rgba(245, 158, 11, 0.18);
            border: 1px solid rgba(245, 158, 11, 0.4);
            color: #FCD34D;
        }

        .omitted-logo-badge {
            position: absolute;
            top: 14px;
            left: 14px;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(245, 158, 11, 0.4);
            color: #FCD34D;
            padding: 6px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            z-index: 10;
        }

        /* ==================== RESPONSIVE: PORTRAIT / VERTICAL LED ==================== */
        @@media (orientation: portrait), (max-aspect-ratio: 1/1) {
            .main-stage {
                grid-template-columns: 1fr;
                grid-template-rows: minmax(160px, 36vh) 1fr;
                gap: clamp(10px, 1.4vh, 20px);
                padding: clamp(8px, 1.2vh, 16px) clamp(10px, 2vw, 24px);
            }
            .ad-container {
                max-height: 38vh;
                border-radius: 18px;
            }
            .survey-container {
                border-radius: 18px;
                padding: clamp(12px, 1.6vh, 24px) clamp(12px, 2vw, 24px);
            }
            .survey-title {
                font-size: clamp(16px, 2.8vw, 26px);
            }
            .survey-question {
                font-size: clamp(12px, 2vw, 17px);
                margin-bottom: clamp(6px, 1vh, 14px);
            }
            .options-list {
                gap: clamp(6px, 0.9vh, 10px);
                margin-bottom: clamp(8px, 1vh, 14px);
            }
            .bottom-cta-box {
                padding: clamp(8px, 1vh, 14px) clamp(10px, 1.5vw, 16px);
                gap: clamp(10px, 1.5vw, 16px);
            }
        }

        /* ==================== RESPONSIVE: COMPACT / LOW-RES LED ==================== */
        @@media (max-height: 560px), (max-width: 820px) {
            .top-navbar {
                padding: 4px var(--pad-x);
            }
            .brand-logo-text { font-size: 14px; letter-spacing: 1px; }
            .brand-subtext { display: none; }
            .location-tag, .live-tag {
                padding: 3px 10px;
                font-size: 10px;
            }
            .survey-header-badge { display: none; }
            .survey-title { font-size: 15px; margin-bottom: 2px; }
            .survey-question { font-size: 12px; margin-bottom: 6px; }
            .options-list { gap: 5px; margin-bottom: 8px; }
            .option-card { padding: 5px 10px; }
            .option-badge { width: 24px; height: 24px; font-size: 11px; }
            .option-text { font-size: 12px; }
            .option-percent { font-size: 14px; }
            .option-count { font-size: 10px; }
            .bottom-cta-box {
                padding: 6px 10px;
                gap: 10px;
            }
            .qr-frame { width: 55px; height: 55px; padding: 3px; }
            .cta-heading { font-size: 12px; }
            .cta-instruction { display: none; }
            .total-badge, .rule-badge { font-size: 10px; padding: 2px 8px; }
        }
    </style>
</head>
<body>

    <!-- Header Navbar -->
    <header class="top-navbar">
        <div class="brand-badge">
            <span class="brand-logo-text">WARNA WARNI</span>
            <span class="brand-subtext">DYNAMIC DOOH STUDIO</span>
        </div>
        <div class="header-meta">
            <div class="location-tag">
                <span>📍</span>
                <span id="siteBadge">@(Model.Site.ToUpper())</span>
            </div>
            <div class="live-tag">
                <span class="live-dot"></span>
                <span>LIVE RESULTS</span>
            </div>
        </div>
    </header>

    <!-- Main Workspace -->
    <main class="main-stage">
        
        <!-- Left Column: Commercial Creative / Ad -->
        <section class="ad-container">
            @if (string.Equals(survey?.ContentType, "BrandGenius", StringComparison.OrdinalIgnoreCase))
            {
                <div class="omitted-logo-badge">
                    <span>🎯</span>
                    <span>BRAND GENIUS: PERHATIKAN LOGO DI SINI</span>
                </div>
            }
            <img src="@(!string.IsNullOrWhiteSpace(survey?.BannerImageUrl) ? survey.BannerImageUrl : "/images/samsung_galaxy_fold.svg")" alt="@(survey?.CampaignTitle ?? "Commercial")" />
        </section>

        <!-- Right Column: Interactive Survey & Live Results -->
        <section class="survey-container">
            <div>
                @{
                    bool isBrandGenius = string.Equals(survey?.ContentType, "BrandGenius", StringComparison.OrdinalIgnoreCase);
                    bool isQuiz = string.Equals(survey?.ContentType, "BrandIQ", StringComparison.OrdinalIgnoreCase);
                }
                <div class="survey-header-badge" style="@(isBrandGenius ? "background: rgba(245, 158, 11, 0.2); border-color: #F59E0B; color: #FCD34D;" : (isQuiz ? "background: rgba(16, 185, 129, 0.2); border-color: #10B981; color: #6EE7B7;" : ""))">
                    <span>@(isBrandGenius ? "🎯 BRAND GENIUS INTERACTIVE GAME" : (isQuiz ? "🧠 BRANDIQ TRIVIA QUIZ" : "⚡ INTERACTIVE BILLBOARD SURVEY"))</span>
                </div>
                <h1 class="survey-title" id="surveyTitle">@(survey?.CampaignTitle ?? "SURVEY PENGGUNA SAMSUNG MOBILE")</h1>
                <p class="survey-question" id="surveyQuestion">@(survey?.QuestionText ?? "Manakah fitur Samsung yang PALING ANDA SUKAI?")</p>

                @if (isBrandGenius || isQuiz)
                {
                    <!-- Live Guess Right vs Wrong Counter (Khusus Brand Genius / Quiz) -->
                    <div class="brandgenius-stats-bar" id="geniusStatsBar">
                        <div class="stat-pill stat-pill-right" id="statPillRight" title="Peserta yang menebak benar">
                            <span>✅ Benar:</span>
                            <span id="geniusRightCount">@(survey?.CorrectVotesCount ?? 0)</span>
                        </div>
                        <div class="stat-pill stat-pill-wrong" id="statPillWrong" title="Peserta yang menebak salah">
                            <span>❌ Salah:</span>
                            <span id="geniusWrongCount">@(survey?.IncorrectVotesCount ?? 0)</span>
                        </div>
                        <div class="stat-pill stat-pill-accuracy" id="statPillAccuracy" title="Akurasi tebakan audiens">
                            <span>🎯 Akurasi:</span>
                            <span id="geniusAccuracyPct">@(survey?.AccuracyRatePct ?? 0)%</span>
                        </div>
                    </div>
                }

                <!-- Options List with Live Progress Bars -->
                <div class="options-list" id="optionsContainer">
                    @if (survey?.Options != null)
                    {
                        foreach (var opt in survey.Options)
                        {
                            <div class="option-card" id="card-@opt.OptionKey">
                                <div class="option-progress-bg" id="bar-@opt.OptionKey" 
                                     style="width: @(opt.PercentageCss)%; background: @(opt.ColorHex)40; border-right: 3px solid @(opt.ColorHex);"></div>
                                <div class="option-content">
                                    <div class="option-left">
                                        <div class="option-badge" style="background-color: @opt.ColorHex;">
                                            @opt.OptionKey
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(opt.OptionImageUrl))
                                        {
                                            <img src="@opt.OptionImageUrl" alt="" style="width: 32px; height: 32px; border-radius: 8px; object-fit: cover;" />
                                        }
                                        <span class="option-text">@opt.OptionText</span>
                                    </div>
                                    <div class="option-right">
                                        <span class="option-percent" id="pct-@opt.OptionKey" style="color: @opt.ColorHex;">
                                            @(opt.Percentage)%
                                        </span>
                                        <span class="option-count" id="cnt-@opt.OptionKey">(@opt.VoteCount suara)</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Bottom QR Code Scan Callout -->
            <div class="bottom-cta-box">
                <div class="qr-frame" id="qrContainer" onclick="openQrModal()" title="Klik untuk memperbesar QR Code (atau tekan tombol Q)">
                    @Html.Raw(Model.QrCodeSvg)
                    <div class="qr-zoom-badge">🔍 Perbesar</div>
                </div>
                <div class="cta-content">
                    <div class="cta-heading">
                        <span>📱 Pindai QR untuk Memilih!</span>
                    </div>
                    <p class="cta-instruction">
                        Buka kamera smartphone Anda, arahkan ke QR Code di samping untuk memberikan suara langsung secara realtime.
                    </p>
                    <div class="cta-meta-row">
                        <div class="total-badge">
                            <span>👥</span>
                            <span id="totalVotesText">Total Suara: @(survey?.TotalVotes ?? 0)</span>
                        </div>
                        <div class="rule-badge">
                            1 Perangkat = 1 Kali Vote
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Fullscreen / Pop-up QR Modal for Easy Smartphone Scanning -->
    <div id="qrModal" class="qr-modal" onclick="closeQrModal(event)">
        <div class="qr-modal-content" onclick="event.stopPropagation()">
            <button class="qr-modal-close" onclick="closeQrModal(event)" title="Tutup (ESC)">&times;</button>
            <h3 class="qr-modal-title">📱 Scan QR Code untuk Memilih</h3>
            <p class="qr-modal-subtitle">Arahkan kamera smartphone Anda ke QR Code besar di bawah ini</p>
            <div class="qr-modal-frame" id="modalQrContainer"></div>
            <p class="qr-modal-tip">💡 Tip: Klik di luar kotak atau tekan <b>ESC</b> / <b>Q</b> untuk menutup</p>
        </div>
    </div>

    <!-- SignalR Client for Realtime Live Updates -->
    <script src="/js/signalr.min.js"></script>
    <script>
        const surveyId = "@Model.Id";
        const siteId = "@Model.Site";

        // Initialize SignalR Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/dynamic-content")
            .withAutomaticReconnect([0, 2000, 5000, 10000])
            .build();

        // Update UI from Realtime Data (Supports both camelCase and PascalCase DTO properties)
        function updateSurveyDisplay(data) {
            if (!data) return;
            const incomingId = data.surveyId || data.dynamicContentId || "";
            if (incomingId && surveyId && incomingId.toLowerCase() !== surveyId.toLowerCase()) return;

            // 1. Update Total Votes
            const totalCount = data.totalVotes ?? data.TotalVotes;
            const totalElem = document.getElementById("totalVotesText");
            if (totalElem && totalCount !== undefined) {
                totalElem.innerText = `Total Suara: ${totalCount}`;
            }

            // Update Brand Genius / Quiz Right vs Wrong Counters
            const rightCount = data.correctVotesCount ?? data.CorrectVotesCount;
            const wrongCount = data.incorrectVotesCount ?? data.IncorrectVotesCount;
            const accuracyPct = data.accuracyRatePct ?? data.AccuracyRatePct;

            const rightEl = document.getElementById("geniusRightCount");
            const wrongEl = document.getElementById("geniusWrongCount");
            const accEl = document.getElementById("geniusAccuracyPct");

            if (rightEl && rightCount !== undefined) rightEl.innerText = rightCount;
            if (wrongEl && wrongCount !== undefined) wrongEl.innerText = wrongCount;
            if (accEl && accuracyPct !== undefined) accEl.innerText = `${accuracyPct}%`;

            // 2. Update Options Progress Bars, Percentages, and Counts
            const options = data.options || data.Options;
            if (options && Array.isArray(options)) {
                options.forEach(opt => {
                    const key = opt.optionKey || opt.OptionKey;
                    if (!key) return;

                    const card = document.getElementById(`card-${key}`);
                    const bar = document.getElementById(`bar-${key}`);
                    const pct = document.getElementById(`pct-${key}`);
                    const cnt = document.getElementById(`cnt-${key}`);

                    const percentage = opt.percentage ?? opt.Percentage ?? 0;
                    const voteCount = opt.voteCount ?? opt.VoteCount ?? 0;

                    if (bar) {
                        bar.style.width = `${percentage}%`;
                    }
                    if (pct) {
                        pct.innerText = `${percentage}%`;
                    }
                    if (cnt) {
                        cnt.innerText = `(${voteCount} suara)`;
                    }

                    // Trigger pulse animation
                    if (card) {
                        card.classList.remove("vote-flash");
                        void card.offsetWidth; // Trigger reflow
                        card.classList.add("vote-flash");
                    }
                });
            }
        }

        // Listen for Realtime Vote Updates via SignalR
        connection.on("ReceiveVoteUpdate", function (data) {
            console.log("Realtime Vote Update Received:", data);
            updateSurveyDisplay(data);
        });

        // Polling fallback to guarantee 100% realtime sync even if network/WebSockets drops
        async function pollSurveyResults() {
            try {
                const resp = await fetch(`/api/dynamic-content/${encodeURIComponent(surveyId)}/results?site=${encodeURIComponent(siteId)}`, {
                    headers: { "Cache-Control": "no-cache" }
                });
                if (resp.ok) {
                    const data = await resp.json();
                    updateSurveyDisplay(data);
                }
            } catch (e) {
                // Silently ignore background polling errors
            }
        }

        // Start Connection and Join Screen Group
        async function startSignalR() {
            try {
                await connection.start();
                console.log("Connected to SignalR DynamicContentHub!");
                await connection.invoke("JoinContentScreen", surveyId, siteId);
            } catch (err) {
                console.error("SignalR connection error:", err);
                setTimeout(startSignalR, 5000);
            }
        }

        connection.onreconnected(async () => {
            console.log("SignalR reconnected, rejoining group and syncing...");
            try {
                await connection.invoke("JoinContentScreen", surveyId, siteId);
                pollSurveyResults();
            } catch (e) { }
        });

        startSignalR();
        // Polling fallback every 3 seconds for bulletproof videotron synchronization
        setInterval(pollSurveyResults, 3000);
    </script>
    <script src="/lib/qrcode/easy.qrcode.min.js"></script>
    <script>
        // Modal Open/Close Controls
        function openQrModal() {
            const modal = document.getElementById("qrModal");
            if (modal) {
                modal.classList.add("active");
            }
        }

        function closeQrModal(event) {
            if (event) event.stopPropagation();
            const modal = document.getElementById("qrModal");
            if (modal) {
                modal.classList.remove("active");
            }
        }

        // Keyboard controls: ESC to close, Q to toggle
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
                closeQrModal();
            } else if (e.key === "q" || e.key === "Q") {
                const modal = document.getElementById("qrModal");
                if (modal && modal.classList.contains("active")) {
                    closeQrModal();
                } else {
                    openQrModal();
                }
            }
        });

        // Render high-contrast, crisp canvas QR code (Level L for minimal density and larger dots)
        (function () {
            const container = document.getElementById("qrContainer");
            const modalContainer = document.getElementById("modalQrContainer");
            const voteUrl = "@Html.Raw(Model.VoteUrl)";

            if (voteUrl && typeof QRCode !== "undefined") {
                // 1. Render in main screen card: high-res 480x480, Level L
                if (container) {
                    // Keep the zoom badge
                    const badge = container.querySelector(".qr-zoom-badge");
                    container.innerHTML = "";
                    new QRCode(container, {
                        text: voteUrl,
                        width: 480,
                        height: 480,
                        colorDark: "#000000",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.L,
                        quietZone: 8,
                        quietZoneColor: "#ffffff"
                    });
                    if (badge) {
                        container.appendChild(badge);
                    }
                }

                // 2. Render in Click-to-Enlarge Modal: high-res 600x600, Level L
                if (modalContainer) {
                    modalContainer.innerHTML = "";
                    new QRCode(modalContainer, {
                        text: voteUrl,
                        width: 600,
                        height: 600,
                        colorDark: "#000000",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.L,
                        quietZone: 10,
                        quietZoneColor: "#ffffff"
                    });
                }
            }
        })();
    </script>
</body>
</html>
