@page
@model CmsBillboard.DynamicContent.Pages.Screen.PhotoCommentModel
@{
    Layout = null;
    var content = Model.DynamicContent;
    var themeColor = !string.IsNullOrEmpty(content?.ThemeColorHex) ? content.ThemeColorHex : "#D97706";
    var campaignTitle = content?.CampaignTitle ?? "Live Greetings & Photo";
    var clientName = content?.ClientName ?? "PT Industri Jamu dan Farmasi Sido Muncul Tbk";
    var headline = !string.IsNullOrEmpty(content?.AdHeadline) ? content.AdHeadline : "Orang Pintar Minum Tolak Angin";
    var subheadline = !string.IsNullOrEmpty(content?.AdSubheadline) 
        ? content.AdSubheadline 
        : "Kirimkan foto selfie & ucapan hangatmu sekarang ke layar Videotron!";
    var brandLogo = content?.BrandLogoUrl ?? "";
    var bannerImg = content?.BannerImageUrl ?? "";
}
@if (!Model.IsTokenValid)
{
    <!DOCTYPE html>
    <html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Akses Layar Ditolak — Warna Warni Dynamic DOOH</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
        <style>
            body {
                background: #070B14;
                color: #FFFFFF;
                font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
                margin: 0;
                background-image: radial-gradient(circle at 50% 50%, rgba(239, 68, 68, 0.12) 0%, transparent 60%);
            }
            .error-card {
                background: rgba(15, 23, 42, 0.95);
                border: 1px solid rgba(239, 68, 68, 0.4);
                border-radius: 24px;
                padding: clamp(24px, 4vh, 44px);
                max-width: 520px;
                width: 100%;
                text-align: center;
                box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(239, 68, 68, 0.2);
            }
            .error-icon {
                font-size: 54px;
                margin-bottom: 16px;
                animation: pulse-warn 2s infinite ease-in-out;
            }
            @@keyframes pulse-warn {
                0%, 100% { transform: scale(1); }
                50% { transform: scale(1.08); }
            }
            .error-title {
                color: #EF4444;
                font-size: clamp(20px, 2.2vw, 26px);
                font-weight: 900;
                margin-bottom: 12px;
                letter-spacing: 0.5px;
            }
            .error-desc {
                color: #CBD5E1;
                font-size: 15px;
                line-height: 1.6;
                margin-bottom: 22px;
            }
            .error-meta {
                background: rgba(0, 0, 0, 0.35);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                padding: 12px 16px;
                font-size: 13px;
                color: #94A3B8;
                font-family: monospace;
                word-break: break-all;
            }
        </style>
    </head>
    <body>
        <div class="error-card">
            <div class="error-icon">🛡️</div>
            <h1 class="error-title">AKSES LAYAR DITOLAK</h1>
            <p class="error-desc">@(Model.TokenErrorMessage ?? "Token otorisasi layar tidak valid atau telah dimodifikasi secara ilegal.")</p>
            <div class="error-meta">Status: 401 Unauthorized</div>
        </div>
    </body>
    </html>
    return;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <title>@campaignTitle — Videotron Live Display</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: @themeColor;
            --primary-glow: @(themeColor)4D;
            --primary-bright: #F59E0B;
            --bg-base: #060911;
            --bg-card: rgba(15, 23, 42, 0.88);
            --border-card: rgba(255, 255, 255, 0.12);
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(217, 119, 6, 0.18) 0%, transparent 45%),
                radial-gradient(circle at 90% 80%, rgba(16, 185, 129, 0.12) 0%, transparent 45%),
                linear-gradient(180deg, #05080E 0%, #0A101D 100%);
        }

        /* Top Bar */
        .top-navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 32px;
            background: rgba(10, 16, 30, 0.92);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            z-index: 100;
            flex-shrink: 0;
            height: 64px;
        }

        .brand-badge {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-logo-img {
            max-height: 40px;
            max-width: 130px;
            object-fit: contain;
            filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5));
        }

        .brand-title-wrap {
            display: flex;
            flex-direction: column;
        }

        .brand-logo-text {
            font-size: 17px;
            font-weight: 900;
            letter-spacing: 1px;
            background: linear-gradient(135deg, #F59E0B, #EF4444);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
        }

        .brand-subtext {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        .nav-right-meta {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .hud-stat-pill {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid var(--border-card);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
        }

        .hud-pill-label {
            color: var(--text-muted);
            font-weight: 600;
        }

        .hud-pill-val {
            color: #FCD34D;
            font-weight: 900;
            font-family: monospace;
            font-size: 14px;
        }

        .location-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(245, 158, 11, 0.15);
            border: 1px solid rgba(245, 158, 11, 0.4);
            color: #FCD34D;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #EF4444;
            box-shadow: 0 0 10px #EF4444;
            animation: pulse-live 1.6s infinite;
        }

        @@keyframes pulse-live {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.4; }
        }

        .clock-display {
            font-size: 14px;
            font-weight: 800;
            color: #FFFFFF;
            letter-spacing: 1px;
            font-family: monospace;
            background: rgba(255, 255, 255, 0.06);
            padding: 6px 12px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Main Split Layout: Left QR Callout, Right Giant Billboard */
        .billboard-container {
            flex: 1;
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 24px;
            padding: 18px 32px;
            height: calc(100vh - 64px);
            overflow: hidden;
            align-items: center;
        }

        /* Left Side: QR Code Card & Activation HUD */
        .left-panel {
            display: flex;
            flex-direction: column;
            gap: 16px;
            height: 100%;
            justify-content: center;
        }

        .qr-card {
            background: var(--bg-card);
            border: 2px solid rgba(245, 158, 11, 0.45);
            border-radius: 24px;
            padding: 22px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 14px;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 24px var(--primary-glow);
            position: relative;
        }

        .qr-badge-pulse {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(239, 68, 68, 0.2);
            border: 1px solid rgba(239, 68, 68, 0.5);
            color: #FCA5A5;
            font-size: 10px;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 20px;
            letter-spacing: 1px;
        }

        .qr-callout-title {
            font-size: 17px;
            font-weight: 900;
            color: #FFFFFF;
            line-height: 1.3;
        }

        .qr-callout-sub {
            font-size: 11px;
            color: var(--text-muted);
            line-height: 1.4;
        }

        .qr-box {
            width: 210px;
            height: 210px;
            background: #FFFFFF !important;
            border-radius: 16px;
            padding: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
            color-scheme: light !important;
            forced-color-adjust: none !important;
        }

        .qr-box canvas,
        .qr-box img,
        .qr-box svg {
            width: 100% !important;
            height: 100% !important;
            max-width: 100% !important;
            max-height: 100% !important;
            object-fit: contain;
            border-radius: 8px;
            background: #FFFFFF !important;
            color-scheme: light !important;
            forced-color-adjust: none !important;
            display: block;
        }

        .qr-steps {
            display: flex;
            flex-direction: column;
            gap: 6px;
            width: 100%;
            text-align: left;
            font-size: 11px;
            color: #CBD5E1;
        }

        .qr-step-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .qr-step-num {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--primary);
            color: #FFFFFF;
            font-weight: 800;
            font-size: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .qr-link-box {
            font-size: 10px;
            color: #94A3B8;
            word-break: break-all;
            background: rgba(0,0,0,0.4);
            padding: 6px 10px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.08);
            font-family: monospace;
            width: 100%;
            text-align: center;
        }

        .qr-link-box a {
            color: #38BDF8;
            text-decoration: underline;
        }

        /* Right Side: The Giant Realistic Billboard Stage */
        .billboard-stage-wrap {
            display: flex;
            flex-direction: column;
            gap: 16px;
            height: 100%;
            justify-content: center;
            overflow: hidden;
        }

        /* Billboard Exterior Frame (Steel Truss & Floodlight FX) */
        .billboard-frame {
            position: relative;
            background: #0A0D14;
            border: 4px solid #1E293B;
            border-radius: 18px;
            padding: 8px;
            box-shadow: 
                0 24px 60px rgba(0, 0, 0, 0.9),
                0 0 0 2px rgba(255, 255, 255, 0.05),
                inset 0 0 40px rgba(0, 0, 0, 0.8);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Top Truss Floodlights */
        .billboard-lights {
            position: absolute;
            top: -16px;
            left: 0;
            right: 0;
            display: flex;
            justify-content: space-around;
            pointer-events: none;
            z-index: 10;
        }

        .floodlight {
            width: 32px;
            height: 12px;
            background: #475569;
            border-radius: 4px;
            box-shadow: 0 0 16px rgba(255, 255, 200, 0.4);
            position: relative;
        }

        .floodlight::after {
            content: '';
            position: absolute;
            top: 100%;
            left: -30px;
            width: 92px;
            height: 120px;
            background: radial-gradient(ellipse at 50% 0%, rgba(254, 240, 138, 0.25) 0%, transparent 75%);
            pointer-events: none;
        }

        /* The Billboard Canvas (Aspect Ratio 1200 / 560 = 2.142) */
        .billboard-canvas {
            position: relative;
            width: 100%;
            aspect-ratio: 1200 / 560;
            max-height: calc(100vh - 210px);
            background: #EAB308;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.35);
        }

        /* Clean Background Image */
        .billboard-bg-img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: fill;
            z-index: 1;
        }

        /* Participant Head Slot (Precisely aligned above the brown shirt body) */
        .participant-head-slot {
            position: absolute;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.4s ease;
            overflow: hidden;
            max-width: 100%;
            max-height: 100%;
        }

        .participant-head-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: contrast(1.05) brightness(1.02);
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .participant-head-img.shape-ellipse {
            -webkit-mask-image: radial-gradient(ellipse 48% 48% at 50% 48%, black 72%, transparent 100%);
            mask-image: radial-gradient(ellipse 48% 48% at 50% 48%, black 72%, transparent 100%);
            clip-path: ellipse(48% 48% at 50% 48%);
        }

        .participant-head-img.shape-circle {
            -webkit-mask-image: radial-gradient(circle 48% at 50% 50%, black 72%, transparent 100%);
            mask-image: radial-gradient(circle 48% at 50% 50%, black 72%, transparent 100%);
            clip-path: circle(48% at 50% 50%);
            border-radius: 50%;
        }

        .participant-head-img.shape-rounded {
            border-radius: 18px;
            -webkit-mask-image: none;
            mask-image: none;
            clip-path: none;
        }

        .participant-head-img.shape-rectangle {
            border-radius: 0;
            -webkit-mask-image: none;
            mask-image: none;
            clip-path: none;
        }

        /* Shirt Collar & Tolak Angin Box Front Overlay (Ensures chin/neck tucks inside collar) */
        .billboard-collar-overlay {
            position: absolute;
            left: 65.0%;
            top: 32.14%;
            width: 33.33%;
            height: 34.82%;
            z-index: 3;
            pointer-events: none;
        }

        .collar-overlay-img {
            width: 100%;
            height: 100%;
            object-fit: fill;
        }

        /* Dynamic Speech Banner (Bottom-Right of Billboard Canvas) */
        .billboard-speech-banner {
            position: absolute;
            left: 65.00%;
            top: 78.00%;
            width: 30.00%;
            height: 16.00%;
            background: linear-gradient(180deg, #FFF9BD 0%, #FEE87D 100%);
            border-radius: 8px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(217, 119, 6, 0.25);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: clamp(6px, 0.9vw, 12px) clamp(8px, 1.2vw, 15px);
            z-index: 4;
            box-sizing: border-box;
            transition: all 0.3s ease;
        }

        .speech-quote-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            overflow: hidden;
        }

        .speech-quote-text {
            font-size: clamp(10px, 1.05vw, 15px);
            font-weight: 800;
            color: #1E293B;
            line-height: 1.25;
            letter-spacing: -0.2px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .speech-author-row {
            display: flex;
            align-items: center;
            gap: 6px;
            padding-top: 3px;
            border-top: 1px dashed rgba(180, 83, 9, 0.2);
            flex-shrink: 0;
        }

        .speech-author-name {
            font-size: clamp(9px, 0.9vw, 12px);
            font-weight: 900;
            color: #92400E;
            text-transform: uppercase;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 50%;
        }

        .speech-verified-badge {
            font-size: clamp(8px, 0.72vw, 10px);
            font-weight: 800;
            color: #047857;
            background: rgba(16, 185, 129, 0.2);
            padding: 1px 6px;
            border-radius: 8px;
            white-space: nowrap;
        }

        .speech-time-tag {
            font-size: clamp(8px, 0.72vw, 10px);
            color: #78716C;
            font-weight: 600;
            margin-left: auto;
            white-space: nowrap;
        }

        /* Recent Photos Ribbon (Bottom Strip) */
        .recent-strip-card {
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid var(--border-card);
            border-radius: 16px;
            padding: 10px 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            overflow: hidden;
            height: 72px;
            flex-shrink: 0;
        }

        .strip-label {
            display: flex;
            flex-direction: column;
            gap: 2px;
            font-size: 11px;
            font-weight: 800;
            color: var(--text-muted);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            width: 80px;
            flex-shrink: 0;
            line-height: 1.2;
        }

        .strip-live-indicator {
            font-size: 9px;
            color: #10B981;
            font-weight: 900;
        }

        .strip-list {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            flex: 1;
            scrollbar-width: none;
        }

        .strip-list::-webkit-scrollbar {
            display: none;
        }

        .strip-item {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 4px 12px 4px 4px;
            border-radius: 24px;
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .strip-item.active {
            border-color: var(--primary-bright);
            background: rgba(245, 158, 11, 0.25);
            box-shadow: 0 0 12px var(--primary-glow);
        }

        .strip-thumb {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .strip-info {
            display: flex;
            flex-direction: column;
        }

        .strip-name {
            font-size: 11px;
            font-weight: 800;
            color: #FFFFFF;
            white-space: nowrap;
        }

        .strip-time {
            font-size: 9px;
            color: var(--text-muted);
        }

        /* Camera Flash Overlay */
        .flash-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #FFFFFF;
            opacity: 0;
            pointer-events: none;
            z-index: 999;
        }

        .animate-flash {
            animation: cameraFlash 0.5s cubic-bezier(0.1, 0.9, 0.2, 1);
        }

        @@keyframes cameraFlash {
            0% { opacity: 0.95; }
            40% { opacity: 0.3; }
            100% { opacity: 0; }
        }

        /* Pop In Animation for Face and Speech */
        .animate-celebrate {
            animation: popBillboard 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @@keyframes popBillboard {
            0% { transform: scale(0.96); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    <!-- Full-screen Camera Flash FX -->
    <div id="flashOverlay" class="flash-overlay"></div>

    <!-- Top Navigation Bar -->
    <header class="top-navbar">
        <div class="brand-badge">
            @if (!string.IsNullOrEmpty(brandLogo))
            {
                <img src="@brandLogo" alt="@clientName" class="brand-logo-img" />
            }
            <div class="brand-title-wrap">
                <span class="brand-logo-text">@clientName</span>
                <span class="brand-subtext">@headline • DOOH Interactive Activation</span>
            </div>
        </div>

        <div class="nav-right-meta">
            <div class="hud-stat-pill">
                <span class="hud-pill-label">Foto Tayang:</span>
                <span class="hud-pill-val" id="counterPhotos">@Model.TotalPhotos</span>
            </div>
            <div class="hud-stat-pill">
                <span class="hud-pill-label">Partisipan:</span>
                <span class="hud-pill-val" id="counterUsers">@Model.TotalParticipants</span>
            </div>
            <div class="location-pill">
                <span class="live-dot"></span>
                <span>@Model.Site</span>
            </div>
            <div class="clock-display" id="clockDisplay">12:00:00 WIB</div>
        </div>
    </header>

    <!-- Main Billboard Layout -->
    <main class="billboard-container">
        <!-- Left Side: QR Code Callout -->
        <section class="left-panel">
            <div class="qr-card">
                <span class="qr-badge-pulse">LIVE DOOH ACTIVATION</span>
                <h2 class="qr-callout-title">Scan & Jadi Endorser!</h2>
                <p class="qr-callout-sub">Foto selfie & ucapanmu akan menggantikan wajah di iklan Tolak Angin ini secara live!</p>

                <div class="qr-box" id="qrContainer">
                    @Html.Raw(Model.QrCodeSvg)
                </div>

                <div class="qr-steps">
                    <div class="qr-step-item">
                        <span class="qr-step-num">1</span>
                        <span>Scan kode QR dengan ponselmu</span>
                    </div>
                    <div class="qr-step-item">
                        <span class="qr-step-num">2</span>
                        <span>Selfie pas di siluet Tolak Angin</span>
                    </div>
                    <div class="qr-step-item">
                        <span class="qr-step-num">3</span>
                        <span>Kirim & langsung tayang di billboard!</span>
                    </div>
                </div>

                <div class="qr-link-box">
                    🔗 <a href="@Model.VoteUrl" target="_blank">@Model.VoteUrl</a>
                </div>
            </div>
        </section>

        <!-- Right Side: The Tolak Angin Billboard Stage -->
        <section class="billboard-stage-wrap">
            <!-- Steel Truss Framed Billboard Structure -->
            <div class="billboard-frame" id="billboardFrame">
                <!-- Floodlights Effect -->
                <div class="billboard-lights">
                    <div class="floodlight"></div>
                    <div class="floodlight"></div>
                    <div class="floodlight"></div>
                </div>

                <!-- Dynamic Billboard Canvas -->
                <div class="billboard-canvas" id="billboardCanvas">
                    <!-- Billboard Creative Background -->
                    <img src="@(string.IsNullOrEmpty(bannerImg) ? "/images/tolak_billboard_clean.png" : bannerImg)" alt="Billboard Creative" class="billboard-bg-img" />

                    <!-- Participant Face Placement Slot -->
                    <div class="participant-head-slot" id="headSlot" style="left: @(Model.SlotConfig.FaceXCss)%; top: @(Model.SlotConfig.FaceYCss)%; width: @(Model.SlotConfig.FaceWidthCss)%; height: @(Model.SlotConfig.FaceHeightCss)%;">
                        <img id="heroPhoto" class="participant-head-img shape-@(Model.SlotConfig.FaceShape ?? "ellipse")" src="/images/placeholder-avatar.svg" alt="Foto Partisipan" />
                    </div>

                    <!-- Collar & Front Overlay (Optional) -->
                    @if (!string.IsNullOrWhiteSpace(Model.SlotConfig.CollarOverlayUrl))
                    {
                        <div class="billboard-collar-overlay">
                            <img src="@Model.SlotConfig.CollarOverlayUrl" alt="Collar Front" class="collar-overlay-img" />
                        </div>
                    }

                    <!-- Dynamic Speech Banner -->
                    <div class="billboard-speech-banner" id="billboardSpeechBanner" style="left: @(Model.SlotConfig.SpeechXCss)%; top: @(Model.SlotConfig.SpeechYCss)%; width: @(Model.SlotConfig.SpeechWidthCss)%; height: @(Model.SlotConfig.SpeechHeightCss)%; background: @(Model.SlotConfig.SpeechBgColor ?? "linear-gradient(180deg, #FFF9BD 0%, #FEE87D 100%)"); color: @(Model.SlotConfig.SpeechTextColor ?? "#1E293B");">
                        <div class="speech-quote-wrap">
                            <p class="speech-quote-text" id="heroComment" style="color: @(Model.SlotConfig.SpeechTextColor ?? "#1E293B");">
                                Saya sudah minum Tolak Angin hari ini, anda apa sudah?
                            </p>
                        </div>
                        <div class="speech-author-row">
                            <span class="speech-author-name" id="heroName" style="color: @(Model.SlotConfig.SpeechTextColor ?? "#1E293B");">— Alfin</span>
                            <span class="speech-verified-badge">✓ Terverifikasi</span>
                            <span class="speech-time-tag" id="heroTime">Baru saja</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Photos Ribbon (Bottom Strip) -->
            <div class="recent-strip-card">
                <div class="strip-label">
                    <span>Foto Terbaru</span>
                    <span class="strip-live-indicator">● REAL-TIME</span>
                </div>
                <div class="strip-list" id="stripList">
                    <!-- Populated via JavaScript -->
                </div>
            </div>
        </section>
    </main>

    <!-- SignalR Script -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const contentId = "@Model.Id";
        const siteId = "@Model.Site";

        // DOM elements
        const flashOverlay = document.getElementById("flashOverlay");
        const headSlot = document.getElementById("headSlot");
        const heroPhoto = document.getElementById("heroPhoto");
        const billboardSpeechBanner = document.getElementById("billboardSpeechBanner");
        const heroName = document.getElementById("heroName");
        const heroTime = document.getElementById("heroTime");
        const heroComment = document.getElementById("heroComment");
        const counterPhotos = document.getElementById("counterPhotos");
        const counterUsers = document.getElementById("counterUsers");
        const stripList = document.getElementById("stripList");
        const clockDisplay = document.getElementById("clockDisplay");

        function normalizePhoto(p) {
            if (!p) return null;
            return {
                id: p.id || p.Id || 0,
                userName: p.userName || p.UserName || "Anonim",
                commentText: p.commentText || p.CommentText || "Saya sudah minum Tolak Angin hari ini, anda apa sudah?",
                photoUrl: p.photoUrl || p.PhotoUrl || "/images/placeholder-avatar.svg",
                siteId: p.siteId || p.SiteId || siteId,
                timeAgo: p.timeAgo || p.TimeAgo || "Baru saja"
            };
        }

        // Web Audio Synthesizer for Camera Shutter sound
        function playCameraChime() {
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                const ctx = new AudioCtx();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = "sine";
                osc.frequency.setValueAtTime(880, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(1760, ctx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.2, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.25);
            } catch (e) { }
        }

        // Initial Data from Server
        const rawInitial = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InitialPhotos));
        let photoList = [];
        (rawInitial || []).forEach(item => {
            const norm = normalizePhoto(item);
            if (norm && !photoList.some(p => (norm.id && p.id === norm.id) || (norm.photoUrl && p.photoUrl === norm.photoUrl))) {
                photoList.push(norm);
            }
        });
        let currentIndex = 0;
        let autoRotateTimer = null;

        // Render Spotlight on Billboard
        function displayPhoto(rawItem, isNewLive = false) {
            const item = normalizePhoto(rawItem);
            if (!item) return;

            if (isNewLive) {
                // Trigger camera flash FX
                flashOverlay.classList.remove("animate-flash");
                void flashOverlay.offsetWidth;
                flashOverlay.classList.add("animate-flash");
                playCameraChime();
            }

            // Animate head slot & speech banner
            headSlot.classList.remove("animate-celebrate");
            billboardSpeechBanner.classList.remove("animate-celebrate");
            void headSlot.offsetWidth;
            headSlot.classList.add("animate-celebrate");
            billboardSpeechBanner.classList.add("animate-celebrate");

            heroPhoto.src = item.photoUrl;
            heroName.textContent = item.userName ? `— ${item.userName}` : "— Partisipan";
            heroTime.textContent = item.timeAgo;
            heroComment.textContent = item.commentText && item.commentText.trim().length > 0 
                ? item.commentText 
                : "Saya sudah minum Tolak Angin hari ini, anda apa sudah?";

            renderRibbon();
        }

        // Render Recent Ribbon with strict distinct deduplication
        function renderRibbon() {
            stripList.innerHTML = "";
            const uniquePhotos = [];
            photoList.forEach(rawP => {
                const p = normalizePhoto(rawP);
                if (p && !uniquePhotos.some(u => (p.id && u.id === p.id) || (p.photoUrl && u.photoUrl === p.photoUrl))) {
                    uniquePhotos.push(p);
                }
            });

            uniquePhotos.slice(0, 10).forEach((p, idx) => {
                const el = document.createElement("div");
                el.className = "strip-item" + (idx === currentIndex ? " active" : "");
                el.innerHTML = `
                    <img class="strip-thumb" src="${p.photoUrl}" alt="${p.userName}" onerror="this.src='/images/placeholder-avatar.svg'" />
                    <div class="strip-info">
                        <span class="strip-name">${p.userName}</span>
                        <span class="strip-time">${p.timeAgo}</span>
                    </div>
                `;
                el.addEventListener("click", () => {
                    currentIndex = idx;
                    displayPhoto(photoList[currentIndex], false);
                    resetAutoRotate();
                });
                stripList.appendChild(el);
            });
        }

        // Auto rotate every 8 seconds if no new live submissions
        function startAutoRotate() {
            autoRotateTimer = setInterval(() => {
                if (photoList.length > 1) {
                    currentIndex = (currentIndex + 1) % photoList.length;
                    displayPhoto(photoList[currentIndex], false);
                }
            }, 8000);
        }

        function resetAutoRotate() {
            if (autoRotateTimer) clearInterval(autoRotateTimer);
            startAutoRotate();
        }

        // Clock display
        function updateClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const mins = String(now.getMinutes()).padStart(2, '0');
            const secs = String(now.getSeconds()).padStart(2, '0');
            clockDisplay.textContent = `${hours}:${mins}:${secs} WIB`;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // SignalR Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/dynamic-content")
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .build();

        connection.on("NewPhotoComment", (payload) => {
            console.log("⚡ SignalR: New Photo Comment Received!", payload);

            if (payload && payload.item) {
                const normalized = normalizePhoto(payload.item);
                if (!normalized) return;

                // Strict deduplication: check if this photo ID or URL is already in photoList
                const alreadyExists = photoList.some(p => 
                    (normalized.id && p.id === normalized.id) || 
                    (normalized.photoUrl && p.photoUrl === normalized.photoUrl)
                );

                if (alreadyExists) {
                    console.log(`⚠️ Photo ID ${normalized.id} already exists in screen photoList, skipping duplicate.`);
                    return;
                }

                photoList.unshift(normalized);
                currentIndex = 0;

                // Update counters
                if (payload.totalPhotos !== undefined) counterPhotos.textContent = payload.totalPhotos;
                if (payload.totalParticipants !== undefined) counterUsers.textContent = payload.totalParticipants;

                // Display immediately with camera flash!
                displayPhoto(normalized, true);
                resetAutoRotate();
            }
        });

        connection.on("PhotoTakenDown", (payload) => {
            console.log("⛔ SignalR: Photo Taken Down Received!", payload);
            if (payload && payload.photoId) {
                const targetId = Number(payload.photoId);
                const wasShowing = photoList.length > 0 && Number(photoList[currentIndex]?.id) === targetId;

                photoList = photoList.filter(p => Number(p.id) !== targetId);
                renderRibbon();

                if (photoList.length > 0) {
                    if (wasShowing) {
                        currentIndex = currentIndex % photoList.length;
                        displayPhoto(photoList[currentIndex], false);
                    }
                } else {
                    heroPhoto.src = "/images/placeholder-avatar.svg";
                    heroName.textContent = "— Partisipan";
                    heroComment.textContent = "Saya sudah minum Tolak Angin hari ini, anda apa sudah?";
                }
            }
        });

        async function startSignalR() {
            try {
                await connection.start();
                console.log("Connected to SignalR DynamicContentHub");

                // Join groups
                try { await connection.invoke("JoinContentScreen", contentId, siteId); } catch(e) {}
                try { await connection.invoke("JoinDynamicContentGroup", contentId); } catch(e) {}
            } catch (err) {
                console.error("SignalR connection error:", err);
                setTimeout(startSignalR, 4000);
            }
        }

        // Polling fallback to keep screen 100% in sync
        async function pollFeed() {
            try {
                const resp = await fetch(`/api/photo-comment/feed?id=${encodeURIComponent(contentId)}&site=${encodeURIComponent(siteId)}`, {
                    headers: { "ngrok-skip-browser-warning": "true" }
                });
                if (resp.ok) {
                    const data = await resp.json();
                    if (data && data.recentPhotos && data.recentPhotos.length > 0) {
                        const top = normalizePhoto(data.recentPhotos[0]);
                        const currentTopId = photoList.length > 0 ? (photoList[0].id || photoList[0].Id) : 0;
                        if (top && top.id && top.id !== currentTopId) {
                            // Filter duplicates from incoming feed
                            const deduped = [];
                            data.recentPhotos.forEach(item => {
                                const norm = normalizePhoto(item);
                                if (norm && !deduped.some(p => (norm.id && p.id === norm.id) || (norm.photoUrl && p.photoUrl === norm.photoUrl))) {
                                    deduped.push(norm);
                                }
                            });
                            photoList = deduped;
                            if (data.totalPhotos !== undefined) counterPhotos.textContent = data.totalPhotos;
                            if (data.totalParticipants !== undefined) counterUsers.textContent = data.totalParticipants;
                            currentIndex = 0;
                            displayPhoto(top, true);
                            resetAutoRotate();
                        }
                    }
                }
            } catch (e) { }
        }

        // Initialize Display
        document.addEventListener("DOMContentLoaded", () => {
            if (photoList.length > 0) {
                displayPhoto(photoList[0], false);
            }
            startAutoRotate();
            startSignalR();
            setInterval(pollFeed, 4000);
        });
    </script>
    <script src="/lib/qrcode/easy.qrcode.min.js"></script>
    <script>
        // Render high-contrast, crisp canvas QR code (immune to dark mode extensions)
        (function () {
            const container = document.getElementById("qrContainer");
            const voteUrl = "@Html.Raw(Model.VoteUrl)";
            if (container && typeof QRCode !== "undefined" && voteUrl) {
                container.innerHTML = "";
                new QRCode(container, {
                    text: voteUrl,
                    width: 220,
                    height: 220,
                    colorDark: "#000000",
                    colorLight: "#ffffff",
                    correctLevel: QRCode.CorrectLevel.M,
                    quietZone: 8,
                    quietZoneColor: "#ffffff"
                });
            }
        })();
    </script>
</body>
</html>
