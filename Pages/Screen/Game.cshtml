@page
@model CmsBillboard.DynamicContent.Pages.Screen.GameModel
@{
    Layout = null;
}
@if (!Model.IsTokenValid)
{
    <!DOCTYPE html>
    <html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Akses Layar Ditolak — Warna Warni Dynamic DOOH</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
        <style>
            body {
                background: #070B14;
                color: #FFFFFF;
                font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
                margin: 0;
                background-image: radial-gradient(circle at 50% 50%, rgba(239, 68, 68, 0.12) 0%, transparent 60%);
            }
            .error-card {
                background: rgba(15, 23, 42, 0.95);
                border: 1px solid rgba(239, 68, 68, 0.4);
                border-radius: 24px;
                padding: clamp(24px, 4vh, 44px);
                max-width: 520px;
                width: 100%;
                text-align: center;
                box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(239, 68, 68, 0.2);
            }
            .error-icon {
                font-size: 54px;
                margin-bottom: 16px;
                animation: pulse-warn 2s infinite ease-in-out;
            }
            @@keyframes pulse-warn {
                0%, 100% { transform: scale(1); }
                50% { transform: scale(1.08); }
            }
            .error-title {
                color: #EF4444;
                font-size: clamp(20px, 2.2vw, 26px);
                font-weight: 900;
                margin-bottom: 12px;
                letter-spacing: 0.5px;
            }
            .error-desc {
                color: #CBD5E1;
                font-size: 15px;
                line-height: 1.6;
                margin-bottom: 22px;
            }
            .error-meta {
                background: rgba(0, 0, 0, 0.35);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                padding: 12px 16px;
                font-size: 13px;
                color: #94A3B8;
                font-family: monospace;
                word-break: break-all;
            }
        </style>
    </head>
    <body>
        <div class="error-card">
            <div class="error-icon">🛡️</div>
            <h1 class="error-title">AKSES LAYAR DITOLAK</h1>
            <p class="error-desc">@(Model.TokenErrorMessage ?? "Token otorisasi layar tidak valid atau telah dimodifikasi secara ilegal.")</p>
            <div class="error-meta">Status: 401 Unauthorized / Invalid HMAC Signature</div>
        </div>
    </body>
    </html>
    return;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@Model.CampaignTitle — DOOH Dynamic Game Display</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }

        html, body {
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #070b14;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #ffffff;
        }

        .screen-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Iframe Runner Game */
        .game-frame {
            width: 100%;
            height: 100%;
            border: none;
            outline: none;
            display: block;
            background-color: transparent;
        }

        /* Watermark Indikator Lokasi & CMS (Opsional, kecil di pojok kanan bawah) */
        .site-indicator-pill {
            position: absolute;
            bottom: 12px;
            right: 14px;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: rgba(255, 255, 255, 0.7);
            font-size: 11px;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 9999px;
            pointer-events: none;
            z-index: 9999;
            letter-spacing: 0.5px;
        }

        /* Error Stage jika folder game belum diupload */
        .error-stage {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            padding: 40px;
            text-align: center;
            background: radial-gradient(circle at center, #1e293b 0%, #070b14 100%);
        }

        .error-card {
            background: rgba(30, 41, 59, 0.9);
            border: 2px solid #ef4444;
            border-radius: 20px;
            padding: 32px 40px;
            max-width: 600px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        }

        .error-title {
            color: #ef4444;
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .error-desc {
            color: #94a3b8;
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .help-box {
            background: rgba(15, 23, 42, 0.8);
            border: 1px dashed rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 14px;
            font-family: monospace;
            font-size: 13px;
            color: #facc15;
            text-align: left;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class="screen-container">
        @if (Model.GameFound)
        {
            <iframe class="game-frame" 
                    src="@Model.GameIframeSrc" 
                    title="@Model.CampaignTitle" 
                    allow="autoplay; fullscreen" 
                    loading="eager">
            </iframe>
            
            <div class="site-indicator-pill">
                📍 @Model.Site | DOOH Dynamic Content
            </div>
        }
        else
        {
            <div class="error-stage">
                <div class="error-card">
                    <h1 class="error-title">Game Tidak Ditemukan</h1>
                    <p class="error-desc">@Model.ErrorMessage</p>
                    <div class="help-box">
                        Lokasi yang diharapkan:<br />
                        <strong>wwwroot/games/@(Model.Game ?? Model.Id)/index.html</strong>
                    </div>
                </div>
            </div>
        }
    </div>
</body>
</html>
