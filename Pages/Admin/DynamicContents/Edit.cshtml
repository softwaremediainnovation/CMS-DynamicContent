@page
@model CmsBillboard.DynamicContent.Pages.Admin.DynamicContents.EditModel
@inject CmsBillboard.DynamicContent.Services.ISecurityTokenService TokenService
@{
    Layout = null;
    ViewData["Title"] = $"Edit Dynamic Content: {Model.Input.CampaignTitle}";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-base: #070B14;
            --bg-card: #0F172A;
            --bg-card-alt: #1E293B;
            --primary: #38BDF8;
            --primary-hover: #0284C7;
            --danger: #EF4444;
            --danger-hover: #DC2626;
            --warning: #F59E0B;
            --border: rgba(255, 255, 255, 0.1);
            --border-glow: rgba(56, 189, 248, 0.25);
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: 
                radial-gradient(circle at 10% 10%, rgba(30, 58, 138, 0.2) 0%, transparent 40%),
                radial-gradient(circle at 90% 90%, rgba(13, 148, 136, 0.15) 0%, transparent 40%);
        }

        .admin-nav {
            background: rgba(11, 19, 36, 0.9);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
            padding: 16px 36px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-logo {
            font-size: 20px;
            font-weight: 900;
            background: linear-gradient(135deg, #FF3366, #FF9933);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 1.5px;
        }

        .main-container {
            flex: 1;
            max-width: 960px;
            margin: 0 auto;
            width: 100%;
            padding: 32px 24px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .header-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(135deg, #0F172A, #1E293B);
            border: 1px solid var(--border-glow);
            border-radius: 20px;
            padding: 22px 28px;
        }

        .header-title {
            font-size: 22px;
            font-weight: 800;
        }

        .btn-back {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: rgba(30, 41, 59, 0.6);
            transition: all 0.2s ease;
        }

        .btn-back:hover {
            color: #FFFFFF;
            border-color: var(--primary);
        }

        /* 3-Interface Pills Banner */
        .interfaces-banner {
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 18px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .banner-text {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-muted);
        }

        .pills-group {
            display: flex;
            gap: 10px;
        }

        .btn-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-pill-instruction {
            background: rgba(56, 189, 248, 0.15);
            color: #38BDF8;
            border: 1px solid rgba(56, 189, 248, 0.3);
        }

        .btn-pill-controller {
            background: rgba(245, 158, 11, 0.15);
            color: #FBBF24;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .btn-pill-result {
            background: rgba(139, 92, 246, 0.15);
            color: #A78BFA;
            border: 1px solid rgba(139, 92, 246, 0.3);
        }

        .btn-pill:hover {
            transform: translateY(-2px);
            filter: brightness(1.2);
        }

        /* Form Sections */
        .form-section {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 28px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 12px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }

        .form-grid-full {
            grid-column: span 2;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .form-control {
            width: 100%;
            background: #0B1120;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 600;
            color: #FFFFFF;
            outline: none;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
        }

        .color-picker {
            width: 100%;
            height: 42px;
            padding: 2px;
            background: #0B1120;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            cursor: pointer;
        }

        .option-row {
            display: grid;
            grid-template-columns: 45px 1.2fr 1fr 60px auto 80px;
            gap: 12px;
            align-items: center;
            background: rgba(30, 41, 59, 0.4);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 12px 16px;
            margin-bottom: 10px;
        }

        .quiz-correct-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 12px;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 10px;
            font-size: 12px;
            font-weight: 700;
            color: #6EE7B7;
            cursor: pointer;
            user-select: none;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .quiz-correct-label:hover {
            background: rgba(16, 185, 129, 0.25);
        }

        .option-badge {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 16px;
            color: #FFFFFF;
        }

        .vote-badge {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            text-align: right;
        }

        /* Buttons Action Row */
        .actions-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 24px 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }

        .btn-save {
            background: linear-gradient(135deg, #38BDF8, #0284C7);
            color: #FFFFFF;
            border: none;
            border-radius: 14px;
            padding: 14px 32px;
            font-size: 15px;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(2, 132, 199, 0.4);
            transition: all 0.2s ease;
        }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(2, 132, 199, 0.5);
        }

        .btn-reset {
            background: rgba(245, 158, 11, 0.15);
            color: #FBBF24;
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 14px;
            padding: 14px 24px;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-reset:hover {
            background: #F59E0B;
            color: #0F172A;
        }

        .btn-delete {
            background: rgba(239, 68, 68, 0.15);
            color: #F87171;
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 14px;
            padding: 14px 24px;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-delete:hover {
            background: #EF4444;
            color: #FFFFFF;
        }

        /* --- Module 6 Slot Editor & Switch Toggle Styles --- */
        .mode-switch-pills {
            display: inline-flex;
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 4px;
            gap: 4px;
        }

        .mode-switch-btn {
            background: transparent;
            border: 1px solid transparent;
            color: var(--text-muted);
            padding: 8px 16px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .mode-switch-btn:hover {
            color: #FFFFFF;
            background: rgba(255, 255, 255, 0.05);
        }

        .mode-switch-btn.active#btnModeAuto {
            background: linear-gradient(135deg, #0284C7, #0EA5E9);
            color: #FFFFFF;
            border-color: #38BDF8;
            box-shadow: 0 0 14px rgba(56, 189, 248, 0.4);
        }

        .mode-switch-btn.active#btnModeManual {
            background: linear-gradient(135deg, #D97706, #F59E0B);
            color: #0F172A;
            border-color: #FCD34D;
            box-shadow: 0 0 14px rgba(245, 158, 11, 0.4);
        }

        .btn-detect-ai {
            background: linear-gradient(135deg, #0284C7, #38BDF8);
            color: #FFFFFF;
            border: none;
            border-radius: 10px;
            padding: 10px 18px;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
        }

        .btn-detect-ai:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(2, 132, 199, 0.5);
        }

        .btn-upload-ad {
            background: rgba(30, 41, 59, 0.8);
            border: 1px solid var(--border);
            color: #CBD5E1;
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-upload-ad:hover {
            background: #334155;
            color: #FFFFFF;
            border-color: var(--primary);
        }

        .btn-refresh-preview {
            background: rgba(30, 41, 59, 0.8);
            border: 1px solid var(--border);
            color: #94A3B8;
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-refresh-preview:hover {
            color: #FFFFFF;
        }

        .btn-reset-coords {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #94A3B8;
            border-radius: 8px;
            padding: 4px 10px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-reset-coords:hover {
            color: #F87171;
            border-color: #EF4444;
        }

        /* Interactive Billboard Canvas */
        .slot-canvas-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 1200 / 560;
            background: #0B0F19;
            border: 2px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.7);
            user-select: none;
        }

        .slot-canvas-img {
            width: 100%;
            height: 100%;
            object-fit: fill;
            display: block;
            pointer-events: none;
        }

        /* Draggable & Resizable Slot Boxes */
        .slot-box {
            position: absolute;
            box-sizing: border-box;
            cursor: move;
            user-select: none;
            touch-action: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .slot-box-face {
            border: 2px dashed #10B981;
            background: rgba(16, 185, 129, 0.22);
            box-shadow: 0 0 16px rgba(16, 185, 129, 0.35);
            z-index: 20;
        }

        .slot-box-face:hover, .slot-box-face.active {
            border-color: #34D399;
            box-shadow: 0 0 24px rgba(16, 185, 129, 0.6);
        }

        .slot-box-mask-preview {
            position: absolute;
            inset: 3px;
            border: 1px dashed rgba(255, 255, 255, 0.7);
            border-radius: 50%;
            pointer-events: none;
        }

        .slot-box-speech {
            border: 2px dashed #F59E0B;
            background: rgba(245, 158, 11, 0.25);
            box-shadow: 0 0 16px rgba(245, 158, 11, 0.35);
            z-index: 21;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .slot-box-speech:hover, .slot-box-speech.active {
            border-color: #FCD34D;
            box-shadow: 0 0 24px rgba(245, 158, 11, 0.6);
        }

        .slot-box-badge {
            position: absolute;
            top: -22px;
            left: 0;
            background: rgba(16, 185, 129, 0.9);
            color: #FFFFFF;
            font-size: 10px;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 6px;
            white-space: nowrap;
            pointer-events: none;
        }

        .slot-resize-handle {
            position: absolute;
            bottom: -5px;
            right: -5px;
            width: 14px;
            height: 14px;
            background: #FFFFFF;
            border: 2px solid #10B981;
            border-radius: 3px;
            cursor: se-resize;
            z-index: 30;
        }

        .face-pill-btn {
            background: rgba(16, 185, 129, 0.2);
            border: 1px solid rgba(16, 185, 129, 0.5);
            color: #6EE7B7;
            padding: 4px 10px;
            border-radius: 14px;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s;
        }

        .face-pill-btn:hover, .face-pill-btn.active {
            background: #10B981;
            color: #0F172A;
        }
    </style>
</head>
<body>

    <header class="admin-nav">
        <span class="brand-logo">WARNA WARNI DYNAMIC DOOH</span>
        <a href="/Admin/Index" class="btn-back">← Kembali ke Dashboard</a>
    </header>

    <main class="main-container">
        
        <div class="header-box">
            <div>
                <h1 class="header-title">Edit Konten: @Model.Input.CampaignTitle</h1>
                <div style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">
                    ID / Slug: <code style="color: var(--primary);">@Model.Id</code> • Total Suara Masuk: <strong style="color:#10B981;">@Model.TotalVotes Suara</strong>
                </div>
            </div>
        </div>

        <!-- 3-Interface Shortcut Banner (Dinamis Sesuai Tipe Konten) -->
        @{
            var effectiveId = !string.IsNullOrWhiteSpace(Model.Id)
                ? Model.Id
                : (!string.IsNullOrWhiteSpace(Model.Input.Id) 
                    ? Model.Input.Id 
                    : (Request.Query["id"].ToString() ?? "tolak-angin-live"));
            if (string.IsNullOrWhiteSpace(effectiveId)) effectiveId = "tolak-angin-live";

            var isPhoto = Model.Input.ContentType.Equals("PhotoComment", StringComparison.OrdinalIgnoreCase);
            var isGame = Model.Input.ContentType.Equals("Game", StringComparison.OrdinalIgnoreCase);
            var siteParam = isPhoto ? "Gedung Sate Bandung" : "Surabaya";

            var editToken = TokenService.GenerateVoteToken(effectiveId, siteParam, "onpremise", expiryMinutes: 0);

            var screenUrl = isPhoto 
                ? $"/Screen/PhotoComment?token={editToken}" 
                : (isGame ? $"/Screen/Game?token={editToken}" : $"/Screen/DynamicContent?token={editToken}");

            var controllerUrl = isPhoto 
                ? $"/PhotoComment?token={editToken}" 
                : $"/Vote?token={editToken}";

            var reportUrl = $"/Admin/DynamicContents/Report?token={editToken}";
        }
        <div class="interfaces-banner">
            <span class="banner-text">🌐 Uji & Salin 3 Tampilan Interface:</span>
            <div class="pills-group">
                <a href="@screenUrl" target="_blank" class="btn-pill btn-pill-instruction" id="linkScreenInstruction" title="Layar Utama Videotron / Layar LED">
                    @(isPhoto ? "📺 Screen Live (Photo)" : (isGame ? "🎮 Screen Game (LED)" : "🖥️ Instruction (LED)"))
                </a>
                <a href="@controllerUrl" target="_blank" class="btn-pill btn-pill-controller" id="linkControllerMobile" title="Halaman Controller Pengunjung di HP">
                    @(isPhoto ? "📸 Mobile Camera (HP)" : "📱 Controller (HP)")
                </a>
                <a href="@reportUrl" target="_blank" class="btn-pill btn-pill-result" id="linkSummaryReport" title="Laporan Hasil & Ringkasan Data">
                    📊 Summary Report
                </a>
                @if (!isPhoto && !isGame)
                {
                    <a href="/Screen/Instruction?token=@editToken" target="_blank" class="btn-pill" style="background: rgba(148, 163, 184, 0.15); color: #CBD5E1; border: 1px solid rgba(148, 163, 184, 0.3);">
                        ℹ️ Instruction Only
                    </a>
                }
            </div>
        </div>

        <form method="post" asp-page-handler="Update" asp-route-id="@effectiveId">
            <input type="hidden" name="Id" value="@effectiveId" id="modelIdHidden" />
            <input type="hidden" asp-for="Input.Id" value="@effectiveId" />
            
            <!-- Section 1: Klien & Kampanye -->
            <div class="form-section" style="margin-bottom: 20px;">
                <div class="section-title">
                    <span>🏢</span>
                    <span>1. Informasi Klien & Kampanye</span>
                </div>

                <div class="form-grid">
                    <div>
                        <label class="form-label" for="clientName">Nama Klien / Brand:</label>
                        <input type="text" id="clientName" asp-for="Input.ClientName" class="form-control" required />
                    </div>

                    <div>
                        <label class="form-label" for="themeColor">Warna Aksen Brand:</label>
                        <input type="color" id="themeColor" asp-for="Input.ThemeColorHex" class="color-picker" />
                    </div>

                    <div class="form-grid-full">
                        <label class="form-label" for="campaignTitle">Judul Kampanye:</label>
                        <input type="text" id="campaignTitle" asp-for="Input.CampaignTitle" class="form-control" required />
                    </div>

                    <div class="form-grid-full">
                        <label class="form-label" for="brandLogo">Logo Brand:</label>
                        <div style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
                            <!-- Live Logo Thumbnail Preview -->
                            <div id="brandLogoPreviewWrap" style="width: 58px; height: 58px; border-radius: 12px; background: rgba(15, 23, 42, 0.9); border: 2px dashed rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; padding: 4px;">
                                <img id="brandLogoPreview" src="@Model.Input.BrandLogoUrl" alt="Logo Preview" style="max-width: 100%; max-height: 100%; object-fit: contain; display: @(!string.IsNullOrEmpty(Model.Input.BrandLogoUrl) ? "block" : "none");" onerror="this.style.display='none'; document.getElementById('brandLogoPlaceholder').style.display='block';" />
                                <span id="brandLogoPlaceholder" style="font-size: 22px; color: #64748B; display: @(string.IsNullOrEmpty(Model.Input.BrandLogoUrl) ? "block" : "none");">🏷️</span>
                            </div>

                            <!-- Input and Upload Action Controls -->
                            <div style="flex: 1; min-width: 280px; display: flex; flex-direction: column; gap: 6px;">
                                <div style="display: flex; gap: 8px; align-items: center;">
                                    <input type="text" id="brandLogo" asp-for="Input.BrandLogoUrl" class="form-control" placeholder="/images/logo.png atau URL web" oninput="updateLogoPreview(this.value)" style="flex: 1;" />
                                    
                                    <input type="file" id="fileBrandLogo" accept="image/png,image/svg+xml,image/jpeg,image/webp" style="display: none;" onchange="handleBrandLogoUpload(this)" />
                                    <button type="button" class="btn-upload-ad" onclick="document.getElementById('fileBrandLogo').click()" style="display: flex; align-items: center; gap: 6px; padding: 11px 16px; font-weight: 700; font-size: 13px; white-space: nowrap; cursor: pointer; background: rgba(14, 165, 233, 0.15); border-color: rgba(56, 189, 248, 0.4); color: #38BDF8;">
                                        📁 Upload Logo
                                    </button>
                                    <button type="button" class="btn-upload-ad" onclick="clearBrandLogo()" title="Hapus Logo" style="padding: 11px 14px; color: #F87171; cursor: pointer; border-color: rgba(239, 68, 68, 0.3);">
                                        ✕
                                    </button>
                                </div>
                                <div id="brandLogoStatus" style="font-size: 12px; color: var(--text-muted);">
                                    Format didukung: PNG (transparan disarankan), SVG, JPG, WEBP. Maks 10MB.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-grid-full">
                        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 14px; font-weight: 700;">
                            <input type="checkbox" asp-for="Input.IsActive" style="width: 18px; height: 18px; accent-color: var(--primary);" />
                            <span>Status Kampanye Aktif (Ditayangkan di Videotron)</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Section 2: Parameter Dynamic Content & Partisipasi (Revisi Arsitektur) -->
            <div class="form-section" style="margin-bottom: 20px;">
                <div class="section-title">
                    <span>⚙️</span>
                    <span>2. Konfigurasi Dynamic Content & Kebijakan Partisipasi</span>
                </div>

                <div class="form-grid">
                    <div class="form-grid-full">
                        <label class="form-label" for="contentType">Tipe Dynamic Content:</label>
                        <select id="contentType" asp-for="Input.ContentType" class="form-control" onchange="toggleContentType()">
                            <option value="Survey">📊 Survey (Modul 7: Jajak Pendapat / Polling Publik)</option>
                            <option value="BrandIQ">🧠 BrandIQ / Quiz (Modul 7: Trivia Tanya Jawab Kuis)</option>
                            <option value="BrandGenius">🎯 Brand Genius Game (Modul 4: Tebak Logo Omitted / On-Premise Brand Game)</option>
                            <option value="PhotoComment">📸 PhotoComment (Modul 6: Live Comment with Photo & Face Slot)</option>
                            <option value="Game">🎮 Interactive Game (Modul 1 & 3: RPS / Digital Pet Aquarium)</option>
                        </select>
                        <div class="form-hint">Pilih format interaksi videotron sesuai dokumen spesifikasi.</div>

                        <!-- Legend Tipe Konten -->
                        <div style="margin-top: 10px; background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 12px 16px; font-size: 12px; line-height: 1.6;">
                            <div style="font-weight: 800; color: #38BDF8; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                                <span>📖</span>
                                <span>Panduan / Legend Tipe Dynamic Content:</span>
                            </div>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 8px; color: #CBD5E1;">
                                <div><strong style="color: #60A5FA;">📊 Survey:</strong> Polling 1x partisipasi per HP, persentase pilihan realtime di LED.</div>
                                <div><strong style="color: #A78BFA;">🧠 BrandIQ (Quiz):</strong> Kuis tanya jawab pengetahuan brand, opsi benar/salah & leaderboard akurasi.</div>
                                <div><strong style="color: #FCD34D;">🎯 Brand Genius Game:</strong> Tebak logo brand dengan potongan disamarkan/omitted. Audiens diwajibkan melihat LED fisik (On-Premise). Live counter Benar vs Salah di layar. Boleh main berulang kali.</div>
                                <div><strong style="color: #F472B6;">📸 PhotoComment:</strong> Pengunjung selfie dengan outline panduan wajah dan kirim ucapan/komentar ke billboard.</div>
                                <div><strong style="color: #34D399;">🎮 Interactive Game:</strong> Mini-game SignalR interaktif layar penuh (Batu Gunting Kertas / Digital Pet Aquarium).</div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="form-label" for="participationMode">Mode Partisipasi Partisipan:</label>
                        <select id="participationMode" asp-for="Input.ParticipationMode" class="form-control" onchange="toggleGapDuration()">
                            <option value="onetime">🔒 onetime (1x Voting Permanen per HP)</option>
                            <option value="multipletime">🔁 multipletime (Boleh Berulang dengan Jeda Waktu)</option>
                        </select>
                        <div class="form-hint">onetime mencegah spam; multipletime mengizinkan pengulangan setelah jeda durasi.</div>
                    </div>

                    <div id="gapDurationGroup" style="display: @(Model.Input.ParticipationMode == "multipletime" ? "block" : "none");">
                        <label class="form-label" for="gapDuration">Jeda Waktu Partisipasi Berulang (Menit):</label>
                        <input type="number" id="gapDuration" asp-for="Input.GapDurationMinutes" class="form-control" min="1" max="1440" value="@Model.Input.GapDurationMinutes" />
                        <div class="form-hint">Durasi jeda (gap duration) sebelum pengunjung boleh submit suara kembali.</div>
                    </div>

                    <div>
                        <label class="form-label" for="locationTagDetect">Deteksi Lokasi GPS Videotron (locationTag):</label>
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; padding-top: 10px; font-size: 14px; font-weight: 700;">
                            <input type="checkbox" id="locationTagDetect" asp-for="Input.LocationTagDetect" style="width: 20px; height: 20px; accent-color: var(--primary);" />
                            <span>Aktifkan Deteksi GPS (locationTag: detect)</span>
                        </label>
                        <div class="form-hint">Mendeteksi koordinat GPS perangkat pengguna untuk memvalidasi audiens di titik LED.</div>
                    </div>

                    <div class="form-grid-full">
                        <label class="form-label" for="welcomeMessage">Pesan Sambutan (Welcome Message):</label>
                        <input type="text" id="welcomeMessage" asp-for="Input.WelcomeMessage" class="form-control" placeholder="contoh: Selamat Datang di Interaktif DOOH Warna Warni" />
                        <div class="form-hint">Pesan yang ditampilkan di layar smartphone partisipan saat membuka URL.</div>
                    </div>

                    <div class="form-grid-full">
                        <label class="form-label" for="instructionComment">Instruksi Partisipan (Instruction / Comment):</label>
                        <input type="text" id="instructionComment" asp-for="Input.InstructionComment" class="form-control" placeholder="contoh: Masukkan nama & nomor WhatsApp untuk kesempatan memenangkan merchandise eksklusif" />
                        <div class="form-hint">Panduan instruksi pengisian nama dan nomor handphone pada controller HP.</div>
                    </div>
                </div>
            </div>

            <!-- Section Game Config (Khusus ContentType == Game) -->
            <div class="form-section" id="gameConfigSection" style="margin-bottom: 20px; display: none; border-color: #F59E0B; background: rgba(245, 158, 11, 0.05);">
                <div class="section-title" style="color: #F59E0B;">
                    <span>🎮</span>
                    <span>Konfigurasi Game Statis (Plug-and-Play)</span>
                </div>

                <div class="form-grid">
                    <div>
                        <label class="form-label" for="gameFolderSelect">Pilih Folder Game (wwwroot/games/):</label>
                        <select id="gameFolderSelect" class="form-control" onchange="document.getElementById('gameFolderInput').value = this.value;">
                            <option value="">-- Pilih dari Game yang Terpasang --</option>
                            @foreach (var g in Model.AvailableGames)
                            {
                                <option value="@g" selected="@(Model.Input.GameFolder == g)">@g</option>
                            }
                        </select>
                        <div class="form-hint">Pilih folder game statis yang sudah ada di direktori server.</div>
                    </div>

                    <div>
                        <label class="form-label" for="gameFolderInput">Atau Ketik Nama Folder Game:</label>
                        <input type="text" id="gameFolderInput" asp-for="Input.GameFolder" class="form-control" placeholder="contoh: rock-paper-scissors" />
                        <div class="form-hint">Folder yang dicari sistem di <code>wwwroot/games/{folder}/</code>.</div>
                    </div>

                    <div>
                        <label class="form-label" for="gameEntryFile">File Entry HTML:</label>
                        <input type="text" id="gameEntryFile" asp-for="Input.GameEntryFile" class="form-control" placeholder="index.html" />
                        <div class="form-hint">Default: <code>index.html</code></div>
                    </div>

                    <div>
                        <label class="form-label" for="gameCustomParams">Parameter URL Kustom (Opsional):</label>
                        <input type="text" id="gameCustomParams" asp-for="Input.GameCustomParams" class="form-control" placeholder="contoh: mode=auto&p2=KOMPUTER" />
                        <div class="form-hint">Parameter yang otomatis diteruskan ke URL game (misal: <code>mode=auto</code>).</div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Materi Iklan LED -->
            <div class="form-section" style="margin-bottom: 20px;">
                <div class="section-title">
                    <span>📺</span>
                    <span>3. Materi Iklan Layar LED</span>
                </div>

                <div class="form-grid">
                    <div>
                        <label class="form-label" for="headline">Headline Iklan:</label>
                        <input type="text" id="headline" asp-for="Input.AdHeadline" class="form-control" />
                    </div>

                    <div>
                        <label class="form-label" for="subheadline">Sub-Headline Iklan:</label>
                        <input type="text" id="subheadline" asp-for="Input.AdSubheadline" class="form-control" />
                    </div>

                    <div class="form-grid-full">
                        <label class="form-label" for="bannerImage">Poster / Banner Materi Iklan:</label>
                        <div style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
                            <!-- Live Banner Thumbnail Preview -->
                            <div id="bannerPreviewWrap" style="width: 100px; height: 58px; border-radius: 10px; background: rgba(15, 23, 42, 0.9); border: 2px dashed rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; padding: 2px;">
                                <img id="bannerPreview" src="@Model.Input.BannerImageUrl" alt="Poster Preview" style="max-width: 100%; max-height: 100%; object-fit: cover; border-radius: 8px; display: @(!string.IsNullOrEmpty(Model.Input.BannerImageUrl) ? "block" : "none");" onerror="this.style.display='none'; document.getElementById('bannerPlaceholder').style.display='block';" />
                                <span id="bannerPlaceholder" style="font-size: 22px; color: #64748B; display: @(string.IsNullOrEmpty(Model.Input.BannerImageUrl) ? "block" : "none");">🖼️</span>
                            </div>

                            <!-- Input and Upload Action Controls -->
                            <div style="flex: 1; min-width: 280px; display: flex; flex-direction: column; gap: 6px;">
                                <div style="display: flex; gap: 8px; align-items: center;">
                                    <input type="text" id="bannerImage" asp-for="Input.BannerImageUrl" class="form-control" placeholder="/images/materi_iklan.jpg atau URL web" oninput="updateBannerPreview(this.value); reloadCanvasImage();" style="flex: 1;" />
                                    
                                    <input type="file" id="fileBannerPoster" accept="image/jpeg,image/png,image/webp,image/svg+xml" style="display: none;" onchange="handleBannerFileUpload(this)" />
                                    <button type="button" class="btn-upload-ad" onclick="document.getElementById('fileBannerPoster').click()" style="display: flex; align-items: center; gap: 6px; padding: 11px 16px; font-weight: 700; font-size: 13px; white-space: nowrap; cursor: pointer; background: rgba(245, 158, 11, 0.15); border-color: rgba(245, 158, 11, 0.4); color: #FCD34D;">
                                        📁 Upload Poster
                                    </button>
                                    <button type="button" class="btn-upload-ad" onclick="clearBannerImage()" title="Hapus Poster" style="padding: 11px 14px; color: #F87171; cursor: pointer; border-color: rgba(239, 68, 68, 0.3);">
                                        ✕
                                    </button>
                                </div>
                                <div id="bannerPosterStatus" style="font-size: 12px; color: var(--text-muted);">
                                    Format didukung: JPG, PNG, WEBP, SVG (Rasio lanskap videotron disarankan). Maks 20MB.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section PhotoComment Slot Config (Khusus ContentType == PhotoComment) -->
            <div class="form-section" id="photoCommentSlotSection" style="margin-bottom: 24px; border-color: rgba(245, 158, 11, 0.4); background: rgba(245, 158, 11, 0.03); display: none;">
                <div class="section-title" style="color: #FBBF24;">
                    <span>🎯</span>
                    <span>Konfigurasi Slot Wajah & Ucapan (Live Photo Comment)</span>
                </div>

                <!-- Hidden Input for SlotConfigJson -->
                <input type="hidden" id="slotConfigJson" asp-for="Input.SlotConfigJson" />

                <!-- Mode Switch Toggle: Otomatis (AI) vs Manual -->
                <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 18px 20px; margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
                        <div>
                            <label class="form-label" style="margin-bottom: 2px; font-size: 14px; font-weight: 800; color: #FFFFFF;">
                                🎯 Mode Penentuan Posisi Wajah:
                            </label>
                            <div style="font-size: 12px; color: var(--text-muted);">
                                Pilih apakah sistem mencari wajah otomatis dengan AI, atau Anda menentukan area wajah sendiri secara manual.
                            </div>
                        </div>

                        <!-- The Switch Toggle Button -->
                        <div class="mode-switch-pills">
                            <button type="button" id="btnModeAuto" class="mode-switch-btn active" onclick="switchSlotMode('auto')">
                                <span style="font-size: 16px;">🤖</span>
                                <span>Otomatis (AI)</span>
                            </button>
                            <button type="button" id="btnModeManual" class="mode-switch-btn" onclick="switchSlotMode('manual')">
                                <span style="font-size: 16px;">✍️</span>
                                <span>Manual (Pilih Sendiri)</span>
                            </button>
                        </div>
                    </div>

                    <!-- AI Control Strip -->
                    <div id="aiModeBar" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 12px 16px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 12px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-size: 20px;">⚡</span>
                            <div>
                                <strong style="color: #38BDF8; font-size: 13px; display: block;">Deteksi Wajah Otomatis (OpenCV AI)</strong>
                                <span id="aiStatusText" style="font-size: 12px; color: #94A3B8;">AI otomatis memindai gambar billboard dan menetapkan koordinat slot wajah.</span>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <button type="button" id="btnDetectFace" class="btn-detect-ai" onclick="runAiDetection()">
                                <span id="aiSpinIcon" style="display: inline-block;">🔍</span> Pindai Wajah dengan AI
                            </button>
                        </div>
                    </div>

                    <!-- AI Multiple Faces Selector (Shows if >1 faces detected) -->
                    <div id="aiMultiFacesRow" style="display: none; margin-top: 10px; padding: 10px 14px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 10px;">
                        <span style="font-size: 12px; color: #6EE7B7; font-weight: 700; margin-right: 8px;">👥 Ditemukan beberapa wajah. Pilih wajah yang ingin digantikan partisipan:</span>
                        <div id="aiFacePills" style="display: inline-flex; gap: 6px; flex-wrap: wrap;"></div>
                    </div>

                    <!-- Manual Instructions (Shows when Manual mode is active) -->
                    <div id="manualModeBar" style="display: none; padding: 12px 16px; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 12px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-size: 20px;">🖐️</span>
                            <span style="font-size: 12px; color: #FCD34D;">
                                <strong>Mode Manual Aktif:</strong> Geser (drag) kotak <strong>🟢 Hijau (Slot Wajah)</strong> dan <strong>🟡 Kuning (Slot Ucapan)</strong> pada kanvas di bawah, atau seret sudut kanan bawah untuk mengubah ukuran. Anda juga dapat klik dan seret pada kanvas untuk menggambar kotak baru.
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Upload Helper & Billboard Preview Toolbar -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
                    <span style="font-size: 13px; font-weight: 700; color: #E2E8F0;">
                        🖼️ Kanvas Desain Billboard Interaktif (Rasio 1200 x 560):
                    </span>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <input type="file" id="fileBillboard" accept="image/jpeg,image/png,image/webp" style="display: none;" onchange="handleBillboardFileUpload(this)" />
                        <button type="button" class="btn-upload-ad" onclick="document.getElementById('fileBillboard').click()">
                            📁 Upload File Materi Iklan Baru (JPG/PNG)
                        </button>
                        <button type="button" class="btn-refresh-preview" onclick="reloadCanvasImage()" title="Segarkan gambar kanvas">
                            🔄 Refresh Kanvas
                        </button>
                    </div>
                </div>

                <!-- The Interactive Canvas Container -->
                <div class="slot-canvas-wrap" id="slotCanvasWrap">
                    <!-- Billboard Image Background -->
                    <img id="slotCanvasBgImg" src="@(!string.IsNullOrWhiteSpace(Model.Input.BannerImageUrl) ? Model.Input.BannerImageUrl : "/images/tolak_billboard_clean.png")" alt="Billboard Creative" class="slot-canvas-img" />

                    <!-- Draggable & Resizable Face Box -->
                    <div id="slotFaceBox" class="slot-box slot-box-face" title="Slot Wajah Partisipan">
                        <div class="slot-box-badge">🟢 Slot Wajah</div>
                        <div class="slot-box-mask-preview" id="faceMaskPreview"></div>
                        <div class="slot-resize-handle" id="faceResizeHandle"></div>
                    </div>

                    <!-- Draggable & Resizable Speech Bubble Box -->
                    <div id="slotSpeechBox" class="slot-box slot-box-speech" title="Slot Balon Ucapan Partisipan">
                        <div class="slot-box-badge" style="background: rgba(245, 158, 11, 0.9);">💬 Slot Ucapan</div>
                        <div style="font-size: 10px; color: #0F172A; font-weight: 700; padding: 4px; pointer-events: none; line-height: 1.2;">
                            "Pesan & Ucapan Pengunjung..."
                        </div>
                        <div class="slot-resize-handle" id="speechResizeHandle" style="border-color: #F59E0B;"></div>
                    </div>
                </div>

                <!-- Fine Tuning & Coordinate Inputs -->
                <div style="margin-top: 16px; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: 14px; padding: 16px 20px;">
                    <div style="font-size: 13px; font-weight: 800; color: #FFFFFF; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between;">
                        <span>📐 Koordinat & Parameter Visual (Tersinkronisasi Otomatis)</span>
                        <button type="button" class="btn-reset-coords" onclick="resetSlotCoordinates()">↩️ Reset Default</button>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px;">
                        <!-- Face Coordinates -->
                        <div>
                            <label class="form-label" style="font-size: 11px;">Slot Wajah X (%):</label>
                            <input type="number" step="0.01" id="inputFaceX" class="form-control" oninput="updateBoxFromInputs()" />
                        </div>
                        <div>
                            <label class="form-label" style="font-size: 11px;">Slot Wajah Y (%):</label>
                            <input type="number" step="0.01" id="inputFaceY" class="form-control" oninput="updateBoxFromInputs()" />
                        </div>
                        <div>
                            <label class="form-label" style="font-size: 11px;">Lebar Wajah Width (%):</label>
                            <input type="number" step="0.01" id="inputFaceW" class="form-control" oninput="updateBoxFromInputs()" />
                        </div>
                        <div>
                            <label class="form-label" style="font-size: 11px;">Tinggi Wajah Height (%):</label>
                            <input type="number" step="0.01" id="inputFaceH" class="form-control" oninput="updateBoxFromInputs()" />
                        </div>

                        <!-- Shape -->
                        <div>
                            <label class="form-label" style="font-size: 11px;">Bentuk Masking Wajah:</label>
                            <select id="selectFaceShape" class="form-control" onchange="updateBoxFromInputs()">
                                <option value="ellipse">Ellipse / Oval (Natural Face Blend)</option>
                                <option value="circle">Circle / Lingkaran</option>
                                <option value="rounded">Rounded Rectangle (Sudut Melengkung)</option>
                                <option value="rectangle">Rectangle / Kotak Penuh</option>
                            </select>
                        </div>

                        <!-- Speech Coordinates -->
                        <div>
                            <label class="form-label" style="font-size: 11px;">Slot Ucapan X (%):</label>
                            <input type="number" step="0.01" id="inputSpeechX" class="form-control" oninput="updateBoxFromInputs()" />
                        </div>
                        <div>
                            <label class="form-label" style="font-size: 11px;">Slot Ucapan Y (%):</label>
                            <input type="number" step="0.01" id="inputSpeechY" class="form-control" oninput="updateBoxFromInputs()" />
                        </div>
                        <div>
                            <label class="form-label" style="font-size: 11px;">Lebar Ucapan Width (%):</label>
                            <input type="number" step="0.01" id="inputSpeechW" class="form-control" oninput="updateBoxFromInputs()" />
                        </div>
                        <div>
                            <label class="form-label" style="font-size: 11px;">Tinggi Ucapan Height (%):</label>
                            <input type="number" step="0.01" id="inputSpeechH" class="form-control" oninput="updateBoxFromInputs()" />
                        </div>

                        <!-- Colors -->
                        <div>
                            <label class="form-label" style="font-size: 11px;">Warna Latar Balon Ucapan:</label>
                            <div style="display: flex; gap: 8px;">
                                <input type="color" id="pickerSpeechBg" class="color-picker" style="height: 38px;" onchange="document.getElementById('inputSpeechBg').value = this.value; updateBoxFromInputs();" />
                                <input type="text" id="inputSpeechBg" class="form-control" value="#FEE87D" oninput="updateBoxFromInputs()" />
                            </div>
                        </div>
                        <div>
                            <label class="form-label" style="font-size: 11px;">Warna Teks Ucapan:</label>
                            <div style="display: flex; gap: 8px;">
                                <input type="color" id="pickerSpeechColor" class="color-picker" style="height: 38px;" onchange="document.getElementById('inputSpeechColor').value = this.value; updateBoxFromInputs();" />
                                <input type="text" id="inputSpeechColor" class="form-control" value="#1E293B" oninput="updateBoxFromInputs()" />
                            </div>
                        </div>

                        <!-- Advanced Overlays -->
                        <div style="grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-top: 6px;">
                            <!-- Collar Overlay -->
                            <div style="background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 12px 14px;">
                                <label class="form-label" style="font-size: 12px; font-weight: 700; color: #E2E8F0; margin-bottom: 8px;">👔 URL Overlay Kerah / Badan Depan (Opsional):</label>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <div id="collarPreviewWrap" style="width: 52px; height: 52px; border-radius: 10px; background: rgba(15, 23, 42, 0.9); border: 2px dashed rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; padding: 2px;">
                                        <img id="collarOverlayPreview" src="" alt="Collar Preview" style="max-width: 100%; max-height: 100%; object-fit: contain; display: none;" onerror="this.style.display='none'; document.getElementById('collarPlaceholder').style.display='block';" />
                                        <span id="collarPlaceholder" style="font-size: 22px; color: #64748B;">👔</span>
                                    </div>
                                    <div style="flex: 1; display: flex; flex-direction: column; gap: 6px;">
                                        <div style="display: flex; gap: 6px; align-items: center;">
                                            <input type="text" id="inputCollarOverlay" class="form-control" style="font-size: 12px; padding: 8px 10px;" placeholder="/images/tolak_endorser_guide.png" oninput="updateCollarPreview(this.value); updateBoxFromInputs();" />
                                            <input type="file" id="fileCollarOverlay" accept="image/png,image/svg+xml,image/webp,image/jpeg" style="display: none;" onchange="handleOverlayFileUpload(this, 'collar')" />
                                            <button type="button" class="btn-upload-ad" onclick="document.getElementById('fileCollarOverlay').click()" style="display: flex; align-items: center; gap: 4px; padding: 8px 12px; font-weight: 700; font-size: 12px; white-space: nowrap; cursor: pointer; background: rgba(14, 165, 233, 0.15); border-color: rgba(56, 189, 248, 0.4); color: #38BDF8;">
                                                📁 Upload
                                            </button>
                                            <button type="button" class="btn-upload-ad" onclick="clearCollarOverlay()" title="Hapus Overlay Kerah" style="padding: 8px 10px; color: #F87171; cursor: pointer; border-color: rgba(239, 68, 68, 0.3);">
                                                ✕
                                            </button>
                                        </div>
                                        <div id="collarOverlayStatus" style="font-size: 11px; color: var(--text-muted);">
                                            Format: PNG transparan disarankan. Kosongkan jika tidak ada overlay.
                                        </div>
                                    </div>
                                </div>
                                <div class="form-hint" style="margin-top: 6px;">Digunakan bila leher/dada partisipan perlu terselip di balik kerah pakaian (kosongkan jika tanpa overlay).</div>
                            </div>

                            <!-- Body Guide Silhouette -->
                            <div style="background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 12px 14px;">
                                <label class="form-label" style="font-size: 12px; font-weight: 700; color: #E2E8F0; margin-bottom: 8px;">👤 URL Siluet Panduan Kamera HP (Opsional):</label>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <div id="bodyGuidePreviewWrap" style="width: 52px; height: 52px; border-radius: 10px; background: rgba(15, 23, 42, 0.9); border: 2px dashed rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; padding: 2px;">
                                        <img id="bodyGuidePreview" src="" alt="Siluet Preview" style="max-width: 100%; max-height: 100%; object-fit: contain; display: none;" onerror="this.style.display='none'; document.getElementById('bodyGuidePlaceholder').style.display='block';" />
                                        <span id="bodyGuidePlaceholder" style="font-size: 22px; color: #64748B;">👤</span>
                                    </div>
                                    <div style="flex: 1; display: flex; flex-direction: column; gap: 6px;">
                                        <div style="display: flex; gap: 6px; align-items: center;">
                                            <input type="text" id="inputBodyGuide" class="form-control" style="font-size: 12px; padding: 8px 10px;" placeholder="/images/tolak_endorser_guide.png" oninput="updateBodyGuidePreview(this.value); updateBoxFromInputs();" />
                                            <input type="file" id="fileBodyGuide" accept="image/png,image/svg+xml,image/webp,image/jpeg" style="display: none;" onchange="handleOverlayFileUpload(this, 'body')" />
                                            <button type="button" class="btn-upload-ad" onclick="document.getElementById('fileBodyGuide').click()" style="display: flex; align-items: center; gap: 4px; padding: 8px 12px; font-weight: 700; font-size: 12px; white-space: nowrap; cursor: pointer; background: rgba(14, 165, 233, 0.15); border-color: rgba(56, 189, 248, 0.4); color: #38BDF8;">
                                                📁 Upload
                                            </button>
                                            <button type="button" class="btn-upload-ad" onclick="clearBodyGuideOverlay()" title="Hapus Siluet Panduan" style="padding: 8px 10px; color: #F87171; cursor: pointer; border-color: rgba(239, 68, 68, 0.3);">
                                                ✕
                                            </button>
                                        </div>
                                        <div id="bodyGuideStatus" style="font-size: 11px; color: var(--text-muted);">
                                            Format: PNG transparan disarankan. Kosongkan jika tidak ada overlay.
                                        </div>
                                    </div>
                                </div>
                                <div class="form-hint" style="margin-top: 6px;">Siluet transparan di kamera HP pengunjung agar posisi pas (kosongkan jika tanpa overlay).</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 4: Pertanyaan & Opsi -->
            <div class="form-section" id="sectionQuestionOptions" style="margin-bottom: 24px;">
                <div class="section-title">
                    <span>❓</span>
                    <span>4. Pertanyaan & Opsi Jawaban</span>
                </div>

                <div id="quizNotice" style="display: none; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 12px; padding: 12px 16px; font-size: 13px; color: #6EE7B7; font-weight: 600;">
                    🎯 <strong>Mode BrandIQ (Kuis):</strong> Pilih salah satu opsi sebagai <strong>Kunci Jawaban Benar</strong> dengan memilih tombol radio "Benar" pada opsi jawaban yang tepat.
                </div>

                <div>
                    <label class="form-label" for="questionText">Teks Pertanyaan Konten / Kuis:</label>
                    <textarea id="questionText" asp-for="Input.QuestionText" class="form-control" rows="2" required></textarea>
                </div>

                <div>
                    <label class="form-label" style="margin-bottom: 12px;">Daftar Opsi Jawaban:</label>
                    
                    @for (int i = 0; i < Model.Input.Options.Count; i++)
                    {
                        <div class="option-row">
                            <input type="hidden" name="Input.Options[@i].Id" value="@Model.Input.Options[i].Id" />
                            <input type="hidden" name="Input.Options[@i].OptionKey" value="@Model.Input.Options[i].OptionKey" />
                            
                            <div class="option-badge" style="background-color: @Model.Input.Options[i].ColorHex;">
                                @Model.Input.Options[i].OptionKey
                            </div>
                            
                            <input type="text" name="Input.Options[@i].OptionText" class="form-control" value="@Model.Input.Options[i].OptionText" required />
                            
                            <input type="text" name="Input.Options[@i].OptionImageUrl" class="form-control" placeholder="URL Ikon/Gambar" value="@Model.Input.Options[i].OptionImageUrl" />

                            <input type="color" name="Input.Options[@i].ColorHex" class="color-picker" value="@Model.Input.Options[i].ColorHex" />

                            <label class="quiz-correct-label quiz-only" style="display: none;" title="Pilih sebagai kunci jawaban yang benar">
                                <input type="radio" name="Input.CorrectOptionKey" value="@Model.Input.Options[i].OptionKey" @(Model.Input.Options[i].IsCorrect || Model.Input.Options[i].OptionKey.Equals(Model.Input.CorrectOptionKey, StringComparison.OrdinalIgnoreCase) ? "checked" : "") style="accent-color: #10B981; width: 16px; height: 16px;" />
                                <span>Benar</span>
                            </label>

                            <div class="vote-badge">
                                @Model.Input.Options[i].VoteCount suara
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Actions Card -->
            <div class="actions-card">
                <button type="submit" class="btn-save">
                    💾 Simpan Perubahan
                </button>
            </div>
        </form>

        <!-- Danger Zone: Reset & Delete -->
        <div class="actions-card" style="border-color: rgba(239, 68, 68, 0.3); background: rgba(239, 68, 68, 0.05);">
            <div>
                <strong style="color: #F87171; display: block; font-size: 15px;">Tindakan Manajemen Suara & Data:</strong>
                <span style="font-size: 13px; color: var(--text-muted);">Reset suara untuk memulai kampanye baru, atau hapus konten ini secara permanen.</span>
            </div>
            <div style="display: flex; gap: 12px;">
                <form method="post" asp-page-handler="ResetVotes" onsubmit="return confirm('Apakah Anda yakin ingin me-reset seluruh suara terkumpul ke 0? Data log partisipan akan dihapus.');" style="margin: 0;">
                    <button type="submit" class="btn-reset">
                        🔄 Reset Semua Suara (0)
                    </button>
                </form>

                <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Apakah Anda yakin ingin MENGHAPUS konten ini secara permanen? Tindakan ini tidak dapat dibatalkan.');" style="margin: 0;">
                    <button type="submit" class="btn-delete">
                        🗑️ Hapus Dynamic Content
                    </button>
                </form>
            </div>
        </div>

    </main>

    <script>
        function toggleContentType() {
            const type = document.getElementById("contentType").value;
            const isQuiz = (type === "BrandIQ" || type === "BrandGenius");
            const isBrandGenius = (type === "BrandGenius");
            const isGame = (type === "Game");
            const isPhoto = (type === "PhotoComment");

            const gameSection = document.getElementById("gameConfigSection");
            const questionSection = document.getElementById("sectionQuestionOptions");
            const photoSection = document.getElementById("photoCommentSlotSection");
            const questionInput = document.getElementById("questionText");

            if (gameSection) gameSection.style.display = isGame ? "flex" : "none";
            if (questionSection) questionSection.style.display = (isGame || isPhoto) ? "none" : "flex";
            if (photoSection) {
                photoSection.style.display = isPhoto ? "block" : "none";
                if (isPhoto) {
                    initSlotEditor();
                }
            }

            if (isPhoto) {
                const partMode = document.getElementById("participationMode");
                const gapDur = document.getElementById("gapDuration");
                if (partMode && partMode.value !== "multipletime") {
                    partMode.value = "multipletime";
                    toggleGapDuration();
                }
                if (gapDur && (!gapDur.value || gapDur.value === "10")) {
                    gapDur.value = "15";
                }
            }

            if (questionInput) {
                if (isGame || isPhoto) {
                    questionInput.removeAttribute("required");
                } else {
                    questionInput.setAttribute("required", "required");
                }
            }

            document.querySelectorAll(".option-row input[name$='.OptionText']").forEach((inp) => {
                if (isGame || isPhoto) {
                    inp.removeAttribute("required");
                } else {
                    inp.setAttribute("required", "required");
                }
            });

            // Quiz & Brand Genius elements
            const notice = document.getElementById("quizNotice");
            if (notice) {
                notice.style.display = isQuiz ? "block" : "none";
                if (isBrandGenius) {
                    notice.innerHTML = "🎯 <strong>Mode Brand Genius Game (Tebak Brand/Logo):</strong> Tentukan opsi yang benar sebagai kunci jawaban (radio 'Benar'). Logo yang disamarkan akan ditampilkan di layar LED.";
                } else {
                    notice.innerHTML = "🎯 <strong>Mode BrandIQ (Kuis):</strong> Pilih salah satu opsi sebagai <strong>Kunci Jawaban Benar</strong> dengan memilih tombol radio 'Benar' pada opsi jawaban yang tepat.";
                }
            }
            document.querySelectorAll(".quiz-only").forEach(el => {
                el.style.display = isQuiz ? "inline-flex" : "none";
            });

            // Dynamically update shortcut links in the banner
            const linkInstruction = document.getElementById("linkScreenInstruction");
            const linkController = document.getElementById("linkControllerMobile");
            const linkReport = document.getElementById("linkSummaryReport");
            const urlParams = new URLSearchParams(window.location.search);
            const contentId = ("@Model.Id" && "@Model.Id".trim() !== "") 
                ? "@Model.Id" 
                : (document.getElementById("modelIdHidden")?.value || urlParams.get("id") || "tolak-angin-live");

            if (linkInstruction && linkController) {
                if (isPhoto) {
                    linkInstruction.href = `/Screen/PhotoComment?id=${encodeURIComponent(contentId)}&site=Gedung%20Sate%20Bandung`;
                    linkInstruction.innerHTML = "📺 Screen Live (Photo)";
                    linkController.href = `/PhotoComment?id=${encodeURIComponent(contentId)}&site=Gedung%20Sate%20Bandung`;
                    linkController.innerHTML = "📸 Mobile Camera (HP)";
                } else if (isGame) {
                    linkInstruction.href = `/Screen/Game?id=${encodeURIComponent(contentId)}&site=Surabaya`;
                    linkInstruction.innerHTML = "🎮 Screen Game (LED)";
                    linkController.href = `/Vote?id=${encodeURIComponent(contentId)}&site=Surabaya`;
                    linkController.innerHTML = "📱 Controller (HP)";
                } else {
                    linkInstruction.href = `/Screen/DynamicContent?id=${encodeURIComponent(contentId)}&site=Surabaya`;
                    linkInstruction.innerHTML = "🖥️ Instruction (LED)";
                    linkController.href = `/Vote?id=${encodeURIComponent(contentId)}&site=Surabaya`;
                    linkController.innerHTML = "📱 Controller (HP)";
                }
            }
            if (linkReport) {
                linkReport.href = `/Admin/DynamicContents/Report?id=${encodeURIComponent(contentId)}`;
            }
        }

        function toggleGapDuration() {
            const mode = document.getElementById("participationMode").value;
            const gapGroup = document.getElementById("gapDurationGroup");
            if (gapGroup) {
                gapGroup.style.display = (mode === "multipletime") ? "block" : "none";
            }
        }

        // ==========================================
        // MODULE 6: DYNAMIC BILLBOARD SLOT EDITOR
        // ==========================================
        let slotState = {
            detectionMode: "auto",
            faceX: 77.08,
            faceY: 1.79,
            faceWidth: 13.33,
            faceHeight: 39.29,
            faceShape: "ellipse",
            speechX: 49.00,
            speechY: 66.43,
            speechWidth: 48.33,
            speechHeight: 28.93,
            speechBgColor: "#FEE87D",
            speechTextColor: "#1E293B",
            collarOverlayUrl: "/images/tolak_endorser_guide.png",
            bodyGuideUrl: "/images/tolak_endorser_guide.png"
        };

        let isSlotInitialized = false;
        let detectedFacesList = [];

        function initSlotEditor() {
            if (isSlotInitialized) return;
            isSlotInitialized = true;

            const jsonInput = document.getElementById("slotConfigJson");
            if (jsonInput && jsonInput.value && jsonInput.value.trim().startsWith("{")) {
                try {
                    const parsed = JSON.parse(jsonInput.value);
                    const getVal = (camel, pascal, fallback) => {
                        if (parsed[camel] !== undefined && parsed[camel] !== null) return parsed[camel];
                        if (parsed[pascal] !== undefined && parsed[pascal] !== null) return parsed[pascal];
                        return fallback;
                    };
                    slotState.detectionMode = getVal("detectionMode", "DetectionMode", slotState.detectionMode);
                    slotState.faceX = parseFloat(getVal("faceX", "FaceX", slotState.faceX));
                    slotState.faceY = parseFloat(getVal("faceY", "FaceY", slotState.faceY));
                    slotState.faceWidth = parseFloat(getVal("faceWidth", "FaceWidth", slotState.faceWidth));
                    slotState.faceHeight = parseFloat(getVal("faceHeight", "FaceHeight", slotState.faceHeight));
                    slotState.faceShape = getVal("faceShape", "FaceShape", slotState.faceShape);

                    slotState.speechX = parseFloat(getVal("speechX", "SpeechX", slotState.speechX));
                    slotState.speechY = parseFloat(getVal("speechY", "SpeechY", slotState.speechY));
                    slotState.speechWidth = parseFloat(getVal("speechWidth", "SpeechWidth", slotState.speechWidth));
                    slotState.speechHeight = parseFloat(getVal("speechHeight", "SpeechHeight", slotState.speechHeight));
                    slotState.speechBgColor = getVal("speechBgColor", "SpeechBgColor", slotState.speechBgColor);
                    slotState.speechTextColor = getVal("speechTextColor", "SpeechTextColor", slotState.speechTextColor);

                    slotState.collarOverlayUrl = getVal("collarOverlayUrl", "CollarOverlayUrl", slotState.collarOverlayUrl);
                    slotState.bodyGuideUrl = getVal("bodyGuideUrl", "BodyGuideUrl", slotState.bodyGuideUrl);
                } catch (e) {
                    console.warn("Gagal parsing SlotConfigJson:", e);
                }
            }

            syncInputsFromState();
            syncCanvasFromState();
            switchSlotMode(slotState.detectionMode || "auto", false);
            setupCanvasDraggables();
        }

        function switchSlotMode(mode, save = true) {
            slotState.detectionMode = mode;
            const btnAuto = document.getElementById("btnModeAuto");
            const btnManual = document.getElementById("btnModeManual");
            const aiBar = document.getElementById("aiModeBar");
            const manualBar = document.getElementById("manualModeBar");

            if (mode === "manual") {
                if (btnAuto) btnAuto.classList.remove("active");
                if (btnManual) btnManual.classList.add("active");
                if (aiBar) aiBar.style.display = "none";
                if (manualBar) manualBar.style.display = "flex";
            } else {
                if (btnManual) btnManual.classList.remove("active");
                if (btnAuto) btnAuto.classList.add("active");
                if (manualBar) manualBar.style.display = "none";
                if (aiBar) aiBar.style.display = "flex";
            }

            if (save) serializeStateToJson();
        }

        function syncInputsFromState() {
            const setVal = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.value = (val !== null && val !== undefined) ? val : "";
            };

            setVal("inputFaceX", Number(slotState.faceX).toFixed(2));
            setVal("inputFaceY", Number(slotState.faceY).toFixed(2));
            setVal("inputFaceW", Number(slotState.faceWidth).toFixed(2));
            setVal("inputFaceH", Number(slotState.faceHeight).toFixed(2));
            setVal("selectFaceShape", slotState.faceShape || "ellipse");

            setVal("inputSpeechX", Number(slotState.speechX).toFixed(2));
            setVal("inputSpeechY", Number(slotState.speechY).toFixed(2));
            setVal("inputSpeechW", Number(slotState.speechWidth).toFixed(2));
            setVal("inputSpeechH", Number(slotState.speechHeight).toFixed(2));
            setVal("inputSpeechBg", slotState.speechBgColor || "#FEE87D");
            setVal("pickerSpeechBg", slotState.speechBgColor && slotState.speechBgColor.startsWith("#") ? slotState.speechBgColor : "#FEE87D");
            setVal("inputSpeechColor", slotState.speechTextColor || "#1E293B");
            setVal("pickerSpeechColor", slotState.speechTextColor && slotState.speechTextColor.startsWith("#") ? slotState.speechTextColor : "#1E293B");

            setVal("inputCollarOverlay", slotState.collarOverlayUrl || "");
            setVal("inputBodyGuide", slotState.bodyGuideUrl || "");
            updateCollarPreview(slotState.collarOverlayUrl || "");
            updateBodyGuidePreview(slotState.bodyGuideUrl || "");
        }

        function syncCanvasFromState() {
            const faceBox = document.getElementById("slotFaceBox");
            const speechBox = document.getElementById("slotSpeechBox");
            const maskPreview = document.getElementById("faceMaskPreview");

            if (faceBox) {
                faceBox.style.left = slotState.faceX + "%";
                faceBox.style.top = slotState.faceY + "%";
                faceBox.style.width = slotState.faceWidth + "%";
                faceBox.style.height = slotState.faceHeight + "%";
            }

            if (maskPreview) {
                if (slotState.faceShape === "circle" || slotState.faceShape === "ellipse") {
                    maskPreview.style.borderRadius = "50%";
                } else if (slotState.faceShape === "rounded") {
                    maskPreview.style.borderRadius = "12px";
                } else {
                    maskPreview.style.borderRadius = "0";
                }
            }

            if (speechBox) {
                speechBox.style.left = slotState.speechX + "%";
                speechBox.style.top = slotState.speechY + "%";
                speechBox.style.width = slotState.speechWidth + "%";
                speechBox.style.height = slotState.speechHeight + "%";
                speechBox.style.background = slotState.speechBgColor || "#FEE87D";
                speechBox.style.color = slotState.speechTextColor || "#1E293B";
            }
        }

        function updateBoxFromInputs() {
            const getNum = (id, fallback) => {
                const el = document.getElementById(id);
                const n = parseFloat(el?.value);
                return isNaN(n) ? fallback : n;
            };

            slotState.faceX = getNum("inputFaceX", slotState.faceX);
            slotState.faceY = getNum("inputFaceY", slotState.faceY);
            slotState.faceWidth = Math.max(3, getNum("inputFaceW", slotState.faceWidth));
            slotState.faceHeight = Math.max(3, getNum("inputFaceH", slotState.faceHeight));
            slotState.faceShape = document.getElementById("selectFaceShape")?.value || "ellipse";

            slotState.speechX = getNum("inputSpeechX", slotState.speechX);
            slotState.speechY = getNum("inputSpeechY", slotState.speechY);
            slotState.speechWidth = Math.max(5, getNum("inputSpeechW", slotState.speechWidth));
            slotState.speechHeight = Math.max(5, getNum("inputSpeechH", slotState.speechHeight));
            slotState.speechBgColor = document.getElementById("inputSpeechBg")?.value || "#FEE87D";
            slotState.speechTextColor = document.getElementById("inputSpeechColor")?.value || "#1E293B";

            slotState.collarOverlayUrl = document.getElementById("inputCollarOverlay")?.value?.trim() || null;
            slotState.bodyGuideUrl = document.getElementById("inputBodyGuide")?.value?.trim() || null;

            syncCanvasFromState();
            serializeStateToJson();
        }

        function serializeStateToJson() {
            const cleanState = {
                detectionMode: slotState.detectionMode || "auto",
                faceX: parseFloat(Number(slotState.faceX).toFixed(2)),
                faceY: parseFloat(Number(slotState.faceY).toFixed(2)),
                faceWidth: parseFloat(Number(slotState.faceWidth).toFixed(2)),
                faceHeight: parseFloat(Number(slotState.faceHeight).toFixed(2)),
                faceShape: slotState.faceShape || "ellipse",
                speechX: parseFloat(Number(slotState.speechX).toFixed(2)),
                speechY: parseFloat(Number(slotState.speechY).toFixed(2)),
                speechWidth: parseFloat(Number(slotState.speechWidth).toFixed(2)),
                speechHeight: parseFloat(Number(slotState.speechHeight).toFixed(2)),
                speechBgColor: slotState.speechBgColor || "#FEE87D",
                speechTextColor: slotState.speechTextColor || "#1E293B",
                collarOverlayUrl: slotState.collarOverlayUrl || null,
                bodyGuideUrl: slotState.bodyGuideUrl || null
            };
            const jsonStr = JSON.stringify(cleanState);
            const hiddenInput = document.getElementById("slotConfigJson");
            if (hiddenInput) hiddenInput.value = jsonStr;
        }

        function resetSlotCoordinates() {
            slotState = {
                detectionMode: slotState.detectionMode || "auto",
                faceX: 77.08,
                faceY: 1.79,
                faceWidth: 13.33,
                faceHeight: 39.29,
                faceShape: "ellipse",
                speechX: 49.00,
                speechY: 66.43,
                speechWidth: 48.33,
                speechHeight: 28.93,
                speechBgColor: "#FEE87D",
                speechTextColor: "#1E293B",
                collarOverlayUrl: "/images/tolak_endorser_guide.png",
                bodyGuideUrl: "/images/tolak_endorser_guide.png"
            };
            syncInputsFromState();
            syncCanvasFromState();
            serializeStateToJson();
        }

        function reloadCanvasImage() {
            const bannerInp = document.getElementById("bannerImage");
            const bgImg = document.getElementById("slotCanvasBgImg");
            if (bgImg && bannerInp) {
                bgImg.src = bannerInp.value.trim() || "/images/tolak_billboard_clean.png";
            }
        }

        function updateLogoPreview(url) {
            const preview = document.getElementById("brandLogoPreview");
            const placeholder = document.getElementById("brandLogoPlaceholder");
            if (!preview || !placeholder) return;
            if (url && url.trim().length > 0) {
                preview.src = url.trim();
                preview.style.display = "block";
                placeholder.style.display = "none";
            } else {
                preview.style.display = "none";
                placeholder.style.display = "block";
            }
        }

        function clearBrandLogo() {
            const input = document.getElementById("brandLogo");
            if (input) {
                input.value = "";
                updateLogoPreview("");
            }
            const status = document.getElementById("brandLogoStatus");
            if (status) status.innerHTML = "Logo dikosongkan.";
        }

        async function handleBrandLogoUpload(input) {
            if (!input.files || input.files.length === 0) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append("logoFile", file);

            const status = document.getElementById("brandLogoStatus");
            if (status) status.innerHTML = "⏳ Mengunggah logo brand...";

            try {
                const res = await fetch("/api/photo-comment/upload-brand-logo", {
                    method: "POST",
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.fileUrl) {
                    const logoInp = document.getElementById("brandLogo");
                    if (logoInp) {
                        logoInp.value = data.fileUrl;
                        updateLogoPreview(data.fileUrl);
                    }
                    if (status) status.innerHTML = "✅ Logo berhasil diunggah: <strong style='color:#38BDF8;'>" + data.fileUrl + "</strong>";
                } else {
                    if (status) status.innerHTML = "❌ Gagal mengunggah logo: " + (data.message || "Unknown error");
                }
            } catch (err) {
                if (status) status.innerHTML = "❌ Error upload: " + err.message;
            } finally {
                input.value = "";
            }
        }

        function updateBannerPreview(url) {
            const preview = document.getElementById("bannerPreview");
            const placeholder = document.getElementById("bannerPlaceholder");
            if (!preview || !placeholder) return;
            if (url && url.trim().length > 0) {
                preview.src = url.trim();
                preview.style.display = "block";
                placeholder.style.display = "none";
            } else {
                preview.style.display = "none";
                placeholder.style.display = "block";
            }
        }

        function clearBannerImage() {
            const input = document.getElementById("bannerImage");
            if (input) {
                input.value = "";
                updateBannerPreview("");
                reloadCanvasImage();
            }
            const status = document.getElementById("bannerPosterStatus");
            if (status) status.innerHTML = "Poster dikosongkan.";
        }

        async function handleBannerFileUpload(input) {
            if (!input.files || input.files.length === 0) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append("imageFile", file);

            const status = document.getElementById("bannerPosterStatus");
            if (status) status.innerHTML = "⏳ Mengunggah poster materi iklan...";

            try {
                const res = await fetch("/api/photo-comment/upload-billboard", {
                    method: "POST",
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.fileUrl) {
                    const bannerInp = document.getElementById("bannerImage");
                    if (bannerInp) {
                        bannerInp.value = data.fileUrl;
                        updateBannerPreview(data.fileUrl);
                        reloadCanvasImage();
                    }
                    if (status) status.innerHTML = "✅ Poster berhasil diunggah: <strong style='color:#FCD34D;'>" + data.fileUrl + "</strong>";

                    if (typeof slotState !== "undefined" && slotState.detectionMode === "auto" && typeof runAiDetection === "function") {
                        setTimeout(() => runAiDetection(), 300);
                    }
                } else {
                    if (status) status.innerHTML = "❌ Gagal mengunggah poster: " + (data.message || "Unknown error");
                }
            } catch (err) {
                if (status) status.innerHTML = "❌ Error upload: " + err.message;
            } finally {
                input.value = "";
            }
        }

        async function handleBillboardFileUpload(input) {
            if (!input.files || input.files.length === 0) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append("imageFile", file);

            const statusText = document.getElementById("aiStatusText");
            if (statusText) statusText.innerHTML = "⏳ Mengunggah gambar billboard...";

            try {
                const res = await fetch("/api/photo-comment/upload-billboard", {
                    method: "POST",
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.fileUrl) {
                    const bannerInp = document.getElementById("bannerImage");
                    if (bannerInp) {
                        bannerInp.value = data.fileUrl;
                        updateBannerPreview(data.fileUrl);
                    }
                    reloadCanvasImage();

                    if (statusText) statusText.innerHTML = "✅ Gambar berhasil diunggah.";

                    if (slotState.detectionMode === "auto") {
                        setTimeout(() => runAiDetection(), 300);
                    }
                } else {
                    alert("Gagal mengunggah gambar: " + (data.message || "Unknown error"));
                }
            } catch (err) {
                alert("Error upload billboard: " + err.message);
            }
        }

        function updateCollarPreview(url) {
            const preview = document.getElementById("collarOverlayPreview");
            const placeholder = document.getElementById("collarPlaceholder");
            if (!preview || !placeholder) return;
            if (url && url.trim().length > 0) {
                preview.src = url.trim();
                preview.style.display = "block";
                placeholder.style.display = "none";
            } else {
                preview.style.display = "none";
                placeholder.style.display = "block";
            }
        }

        function clearCollarOverlay() {
            const input = document.getElementById("inputCollarOverlay");
            if (input) {
                input.value = "";
                updateCollarPreview("");
                updateBoxFromInputs();
            }
            const status = document.getElementById("collarOverlayStatus");
            if (status) status.innerHTML = "Overlay kerah dikosongkan (tanpa overlay).";
        }

        function updateBodyGuidePreview(url) {
            const preview = document.getElementById("bodyGuidePreview");
            const placeholder = document.getElementById("bodyGuidePlaceholder");
            if (!preview || !placeholder) return;
            if (url && url.trim().length > 0) {
                preview.src = url.trim();
                preview.style.display = "block";
                placeholder.style.display = "none";
            } else {
                preview.style.display = "none";
                placeholder.style.display = "block";
            }
        }

        function clearBodyGuideOverlay() {
            const input = document.getElementById("inputBodyGuide");
            if (input) {
                input.value = "";
                updateBodyGuidePreview("");
                updateBoxFromInputs();
            }
            const status = document.getElementById("bodyGuideStatus");
            if (status) status.innerHTML = "Siluet panduan dikosongkan (tanpa overlay).";
        }

        async function handleOverlayFileUpload(input, targetType) {
            if (!input.files || input.files.length === 0) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append("overlayFile", file);

            const isCollar = targetType === "collar";
            const status = document.getElementById(isCollar ? "collarOverlayStatus" : "bodyGuideStatus");
            if (status) status.innerHTML = "⏳ Mengunggah file overlay...";

            try {
                const res = await fetch("/api/photo-comment/upload-overlay", {
                    method: "POST",
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.fileUrl) {
                    const inp = document.getElementById(isCollar ? "inputCollarOverlay" : "inputBodyGuide");
                    if (inp) {
                        inp.value = data.fileUrl;
                        if (isCollar) updateCollarPreview(data.fileUrl);
                        else updateBodyGuidePreview(data.fileUrl);
                        updateBoxFromInputs();
                    }
                    if (status) status.innerHTML = "✅ Berhasil diunggah: <strong style='color:#38BDF8;'>" + data.fileUrl + "</strong>";
                } else {
                    if (status) status.innerHTML = "❌ Gagal: " + (data.message || "Unknown error");
                }
            } catch (err) {
                if (status) status.innerHTML = "❌ Error upload: " + err.message;
            } finally {
                input.value = "";
            }
        }

        async function runAiDetection() {
            const bannerInp = document.getElementById("bannerImage");
            const imageUrl = (bannerInp && bannerInp.value.trim()) ? bannerInp.value.trim() : "/images/tolak_billboard_clean.png";

            const btn = document.getElementById("btnDetectFace");
            const spin = document.getElementById("aiSpinIcon");
            const status = document.getElementById("aiStatusText");

            if (btn) btn.disabled = true;
            if (spin) spin.innerHTML = "⏳";
            if (status) status.innerHTML = "🔍 OpenCV AI sedang memindai wajah manusia...";

            const formData = new FormData();
            formData.append("imageUrl", imageUrl);

            try {
                const res = await fetch("/api/photo-comment/detect-face", {
                    method: "POST",
                    body: formData
                });
                const data = await res.json();

                if (data.success && data.faces && data.faces.length > 0) {
                    detectedFacesList = data.faces;
                    const primary = data.faces[0];

                    slotState.faceX = primary.x;
                    slotState.faceY = primary.y;
                    slotState.faceWidth = primary.width;
                    slotState.faceHeight = primary.height;

                    syncInputsFromState();
                    syncCanvasFromState();
                    serializeStateToJson();

                    if (status) {
                        status.innerHTML = `✅ <strong>AI Berhasil:</strong> Terdeteksi ${data.faceCount} wajah! Koordinat diterapkan (X: ${primary.x}%, Y: ${primary.y}%, W: ${primary.width}%, H: ${primary.height}%).`;
                    }

                    // Multi face buttons
                    const multiRow = document.getElementById("aiMultiFacesRow");
                    const pillBox = document.getElementById("aiFacePills");
                    if (data.faceCount > 1 && multiRow && pillBox) {
                        multiRow.style.display = "block";
                        pillBox.innerHTML = "";
                        data.faces.forEach((f, idx) => {
                            const pill = document.createElement("button");
                            pill.type = "button";
                            pill.className = "face-pill-btn" + (idx === 0 ? " active" : "");
                            pill.innerHTML = `Wajah #${idx + 1} (${f.width}×${f.height}%)`;
                            pill.onclick = () => {
                                document.querySelectorAll(".face-pill-btn").forEach(p => p.classList.remove("active"));
                                pill.classList.add("active");
                                slotState.faceX = f.x;
                                slotState.faceY = f.y;
                                slotState.faceWidth = f.width;
                                slotState.faceHeight = f.height;
                                syncInputsFromState();
                                syncCanvasFromState();
                                serializeStateToJson();
                            };
                            pillBox.appendChild(pill);
                        });
                    } else if (multiRow) {
                        multiRow.style.display = "none";
                    }
                } else {
                    if (status) {
                        status.innerHTML = `⚠️ <strong>AI:</strong> Tidak terdeteksi wajah manusia pada gambar ini. Silakan gunakan <strong>Mode Manual</strong> untuk menentukan area wajah.`;
                    }
                }
            } catch (err) {
                if (status) status.innerHTML = `❌ Error deteksi AI: ${err.message}`;
            } finally {
                if (btn) btn.disabled = false;
                if (spin) spin.innerHTML = "🔍";
            }
        }

        // ==========================================
        // DRAG & RESIZE CANVAS INTERACTION
        // ==========================================
        function setupCanvasDraggables() {
            const canvas = document.getElementById("slotCanvasWrap");
            const faceBox = document.getElementById("slotFaceBox");
            const speechBox = document.getElementById("slotSpeechBox");
            const faceResize = document.getElementById("faceResizeHandle");
            const speechResize = document.getElementById("speechResizeHandle");

            if (!canvas) return;

            let activeAction = null; // 'dragFace' | 'dragSpeech' | 'resizeFace' | 'resizeSpeech'
            let startX = 0, startY = 0;
            let initialBox = { x: 0, y: 0, w: 0, h: 0 };

            function startInteraction(e, action, current) {
                e.preventDefault();
                e.stopPropagation();
                activeAction = action;
                startX = e.clientX;
                startY = e.clientY;
                initialBox = Object.assign({}, current);
                document.addEventListener("pointermove", onPointerMove);
                document.addEventListener("pointerup", onPointerUp);
            }

            if (faceBox) {
                faceBox.addEventListener("pointerdown", (e) => {
                    if (e.target === faceResize) return;
                    startInteraction(e, "dragFace", {
                        x: slotState.faceX,
                        y: slotState.faceY,
                        w: slotState.faceWidth,
                        h: slotState.faceHeight
                    });
                });
            }

            if (faceResize) {
                faceResize.addEventListener("pointerdown", (e) => {
                    startInteraction(e, "resizeFace", {
                        x: slotState.faceX,
                        y: slotState.faceY,
                        w: slotState.faceWidth,
                        h: slotState.faceHeight
                    });
                });
            }

            if (speechBox) {
                speechBox.addEventListener("pointerdown", (e) => {
                    if (e.target === speechResize) return;
                    startInteraction(e, "dragSpeech", {
                        x: slotState.speechX,
                        y: slotState.speechY,
                        w: slotState.speechWidth,
                        h: slotState.speechHeight
                    });
                });
            }

            if (speechResize) {
                speechResize.addEventListener("pointerdown", (e) => {
                    startInteraction(e, "resizeSpeech", {
                        x: slotState.speechX,
                        y: slotState.speechY,
                        w: slotState.speechWidth,
                        h: slotState.speechHeight
                    });
                });
            }

            function onPointerMove(e) {
                if (!activeAction) return;
                const rect = canvas.getBoundingClientRect();
                const deltaXPercent = ((e.clientX - startX) / rect.width) * 100;
                const deltaYPercent = ((e.clientY - startY) / rect.height) * 100;

                if (activeAction === "dragFace") {
                    let newX = Math.max(0, Math.min(100 - initialBox.w, initialBox.x + deltaXPercent));
                    let newY = Math.max(0, Math.min(100 - initialBox.h, initialBox.y + deltaYPercent));
                    slotState.faceX = Math.round(newX * 100) / 100;
                    slotState.faceY = Math.round(newY * 100) / 100;
                } else if (activeAction === "resizeFace") {
                    let newW = Math.max(4, Math.min(100 - initialBox.x, initialBox.w + deltaXPercent));
                    let newH = Math.max(4, Math.min(100 - initialBox.y, initialBox.h + deltaYPercent));
                    slotState.faceWidth = Math.round(newW * 100) / 100;
                    slotState.faceHeight = Math.round(newH * 100) / 100;
                } else if (activeAction === "dragSpeech") {
                    let newX = Math.max(0, Math.min(100 - initialBox.w, initialBox.x + deltaXPercent));
                    let newY = Math.max(0, Math.min(100 - initialBox.h, initialBox.y + deltaYPercent));
                    slotState.speechX = Math.round(newX * 100) / 100;
                    slotState.speechY = Math.round(newY * 100) / 100;
                } else if (activeAction === "resizeSpeech") {
                    let newW = Math.max(6, Math.min(100 - initialBox.x, initialBox.w + deltaXPercent));
                    let newH = Math.max(6, Math.min(100 - initialBox.y, initialBox.h + deltaYPercent));
                    slotState.speechWidth = Math.round(newW * 100) / 100;
                    slotState.speechHeight = Math.round(newH * 100) / 100;
                }

                syncInputsFromState();
                syncCanvasFromState();
                serializeStateToJson();
            }

            function onPointerUp() {
                activeAction = null;
                document.removeEventListener("pointermove", onPointerMove);
                document.removeEventListener("pointerup", onPointerUp);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            toggleContentType();
        });
    </script>
</body>
</html>
