@page
@model CmsBillboard.DynamicContent.Pages.Admin.DynamicContents.CreateModel
@{
    Layout = null;
    ViewData["Title"] = "Tambah Dynamic Content Klien Baru — Admin Studio";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-base: #070B14;
            --bg-card: #0F172A;
            --bg-card-alt: #1E293B;
            --primary: #38BDF8;
            --primary-hover: #0284C7;
            --border: rgba(255, 255, 255, 0.1);
            --border-glow: rgba(56, 189, 248, 0.25);
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: 
                radial-gradient(circle at 10% 10%, rgba(30, 58, 138, 0.2) 0%, transparent 40%),
                radial-gradient(circle at 90% 90%, rgba(13, 148, 136, 0.15) 0%, transparent 40%);
        }

        .admin-nav {
            background: rgba(11, 19, 36, 0.9);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
            padding: 16px 36px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-logo {
            font-size: 20px;
            font-weight: 900;
            background: linear-gradient(135deg, #FF3366, #FF9933);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 1.5px;
        }

        .main-container {
            flex: 1;
            max-width: 960px;
            margin: 0 auto;
            width: 100%;
            padding: 32px 24px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .header-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(135deg, #0F172A, #1E293B);
            border: 1px solid var(--border-glow);
            border-radius: 20px;
            padding: 22px 28px;
        }

        .header-title {
            font-size: 22px;
            font-weight: 800;
        }

        .btn-back {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: rgba(30, 41, 59, 0.6);
            transition: all 0.2s ease;
        }

        .btn-back:hover {
            color: #FFFFFF;
            border-color: var(--primary);
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.4);
            color: #FCA5A5;
            padding: 14px 18px;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 600;
        }

        /* Form Card & Sections */
        .form-section {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 28px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 12px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }

        .form-grid-full {
            grid-column: span 2;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .form-control {
            width: 100%;
            background: #0B1120;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 600;
            color: #FFFFFF;
            outline: none;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
        }

        .form-hint {
            font-size: 11px;
            color: #64748B;
            margin-top: 4px;
        }

        /* Dynamic Options Styling */
        .option-row {
            display: grid;
            grid-template-columns: 45px 1.3fr 1fr 60px auto 40px;
            gap: 12px;
            align-items: center;
            background: rgba(30, 41, 59, 0.4);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 12px 16px;
            margin-bottom: 10px;
        }

        .quiz-correct-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 12px;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.35);
            border-radius: 10px;
            color: #10B981;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            user-select: none;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .quiz-correct-label:hover {
            background: rgba(16, 185, 129, 0.25);
        }

        .option-badge {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 16px;
            color: #FFFFFF;
        }

        .color-picker {
            width: 100%;
            height: 42px;
            padding: 2px;
            background: #0B1120;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            cursor: pointer;
        }

        .btn-remove-opt {
            background: rgba(239, 68, 68, 0.15);
            color: #EF4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 10px;
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-remove-opt:hover {
            background: #EF4444;
            color: #FFFFFF;
        }

        .btn-add-opt {
            background: rgba(56, 189, 248, 0.12);
            color: var(--primary);
            border: 1px dashed rgba(56, 189, 248, 0.4);
            border-radius: 12px;
            padding: 12px;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            width: 100%;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-add-opt:hover {
            background: rgba(56, 189, 248, 0.2);
            border-color: var(--primary);
        }

        /* Submit Button */
        .btn-save {
            background: linear-gradient(135deg, #38BDF8, #0284C7);
            color: #FFFFFF;
            border: none;
            border-radius: 16px;
            padding: 16px 28px;
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 0.5px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(2, 132, 199, 0.4);
            transition: all 0.2s ease;
            width: 100%;
        }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(2, 132, 199, 0.5);
        }
    </style>
</head>
<body>

    <header class="admin-nav">
        <span class="brand-logo">WARNA WARNI DYNAMIC DOOH</span>
        <a href="/Admin/Index" class="btn-back">← Kembali ke Dashboard</a>
    </header>

    <main class="main-container">
        
        <div class="header-box">
            <div>
                <h1 class="header-title">Tambah Dynamic Content Klien Baru</h1>
                <p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">
                    Formulir generator konten dinamis untuk kampanye klien (menghasilkan 3 interface otomatis).
                </p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert-error">
                <span>⚠️</span>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form method="post" id="createContentForm">
            
            <!-- Section 1: Klien & Kampanye -->
            <div class="form-section" style="margin-bottom: 20px;">
                <div class="section-title">
                    <span>🏢</span>
                    <span>1. Informasi Klien & Kampanye</span>
                </div>

                <div class="form-grid">
                    <div>
                        <label class="form-label" for="clientId">ID / Slug Unik Konten:</label>
                        <input type="text" id="clientId" asp-for="Input.Id" class="form-control" placeholder="contoh: grab-promo-2026, byd-electric" required />
                        <div class="form-hint">Digunakan dalam URL unik videotron & token. Huruf kecil, angka, dan minus.</div>
                        <span asp-validation-for="Input.Id" style="color:#F87171; font-size:12px;"></span>
                    </div>

                    <div>
                        <label class="form-label" for="clientName">Nama Klien / Brand:</label>
                        <input type="text" id="clientName" asp-for="Input.ClientName" class="form-control" placeholder="contoh: Samsung, Grab, Tolak Angin, BYD" required />
                    </div>

                    <div class="form-grid-full">
                        <label class="form-label" for="campaignTitle">Judul Kampanye:</label>
                        <input type="text" id="campaignTitle" asp-for="Input.CampaignTitle" class="form-control" placeholder="contoh: SURVEY KEPUASAN PENGGUNA GRAB INDONESIA" required />
                    </div>

                    <div>
                        <label class="form-label" for="themeColor">Warna Aksen Brand:</label>
                        <input type="color" id="themeColor" asp-for="Input.ThemeColorHex" class="color-picker" value="#0072FF" />
                    </div>

                    <div>
                        <label class="form-label" for="brandLogo">URL Logo Brand (Opsional):</label>
                        <input type="text" id="brandLogo" asp-for="Input.BrandLogoUrl" class="form-control" placeholder="/images/logo.png atau URL web" />
                    </div>
                </div>
            </div>

            <!-- Section 2: Parameter Dynamic Content & Partisipasi (Revisi Arsitektur) -->
            <div class="form-section" style="margin-bottom: 20px;">
                <div class="section-title">
                    <span>⚙️</span>
                    <span>2. Konfigurasi Dynamic Content & Kebijakan Partisipasi</span>
                </div>

                <div class="form-grid">
                    <div>
                        <label class="form-label" for="contentType">Tipe Dynamic Content (Modul 7):</label>
                        <select id="contentType" asp-for="Input.ContentType" class="form-control" onchange="toggleContentType()">
                            <option value="Survey">📊 Survey (Jajak Pendapat / Polling Publik)</option>
                            <option value="BrandIQ">🧠 BrandIQ (Kuis / Trivia Interaktif Brand)</option>
                            <option value="Game">🎮 Game (Interactive DOOH Game)</option>
                            <option value="PhotoComment">📸 PhotoComment (Live Comment with Photo - Modul 6)</option>
                        </select>
                        <div class="form-hint">Pilih format konten: Polling Survey, Kuis BrandIQ, Game Interaktif, atau Live Photo Comment.</div>
                    </div>

                    <div>
                        <label class="form-label" for="participationMode">Mode Partisipasi Partisipan:</label>
                        <select id="participationMode" asp-for="Input.ParticipationMode" class="form-control" onchange="toggleGapDuration()">
                            <option value="onetime">🔒 onetime (1x Voting Permanen per HP)</option>
                            <option value="multipletime">🔁 multipletime (Boleh Berulang dengan Jeda Waktu)</option>
                        </select>
                        <div class="form-hint">onetime mencegah spam; multipletime mengizinkan pengulangan setelah jeda durasi.</div>
                    </div>

                    <div id="gapDurationGroup" style="display: @(Model.Input.ParticipationMode == "multipletime" ? "block" : "none");">
                        <label class="form-label" for="gapDuration">Jeda Waktu Partisipasi Berulang (Menit):</label>
                        <input type="number" id="gapDuration" asp-for="Input.GapDurationMinutes" class="form-control" min="1" max="1440" value="@Model.Input.GapDurationMinutes" />
                        <div class="form-hint">Durasi jeda (gap duration) sebelum pengunjung boleh submit suara kembali.</div>
                    </div>

                    <div>
                        <label class="form-label" for="locationTagDetect">Deteksi Lokasi GPS Videotron (locationTag):</label>
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; padding-top: 10px; font-size: 14px; font-weight: 700;">
                            <input type="checkbox" id="locationTagDetect" asp-for="Input.LocationTagDetect" style="width: 20px; height: 20px; accent-color: var(--primary);" />
                            <span>Aktifkan Deteksi GPS (locationTag: detect)</span>
                        </label>
                        <div class="form-hint">Mendeteksi koordinat GPS perangkat pengguna untuk memvalidasi audiens di titik LED.</div>
                    </div>

                    <div class="form-grid-full">
                        <label class="form-label" for="welcomeMessage">Pesan Sambutan (Welcome Message):</label>
                        <input type="text" id="welcomeMessage" asp-for="Input.WelcomeMessage" class="form-control" placeholder="contoh: Selamat Datang di Interaktif DOOH Warna Warni" />
                        <div class="form-hint">Pesan yang ditampilkan di layar smartphone partisipan saat membuka URL.</div>
                    </div>

                    <div class="form-grid-full">
                        <label class="form-label" for="instructionComment">Instruksi Partisipan (Instruction / Comment):</label>
                        <input type="text" id="instructionComment" asp-for="Input.InstructionComment" class="form-control" placeholder="contoh: Masukkan nama & nomor WhatsApp untuk kesempatan memenangkan merchandise eksklusif" />
                        <div class="form-hint">Panduan instruksi pengisian nama dan nomor handphone pada controller HP.</div>
                    </div>
                </div>
            </div>

            <!-- Section Game Config (Khusus ContentType == Game) -->
            <div class="form-section" id="gameConfigSection" style="margin-bottom: 20px; display: none; border-color: #F59E0B; background: rgba(245, 158, 11, 0.05);">
                <div class="section-title" style="color: #F59E0B;">
                    <span>🎮</span>
                    <span>Konfigurasi Game Statis (Plug-and-Play)</span>
                </div>

                <div class="form-grid">
                    <div>
                        <label class="form-label" for="gameFolderSelect">Pilih Folder Game (wwwroot/games/):</label>
                        <select id="gameFolderSelect" class="form-control" onchange="document.getElementById('gameFolderInput').value = this.value;">
                            <option value="">-- Pilih dari Game yang Terpasang --</option>
                            @foreach (var g in Model.AvailableGames)
                            {
                                <option value="@g">@g</option>
                            }
                        </select>
                        <div class="form-hint">Pilih folder game statis yang sudah ada di direktori server.</div>
                    </div>

                    <div>
                        <label class="form-label" for="gameFolderInput">Atau Ketik Nama Folder Game:</label>
                        <input type="text" id="gameFolderInput" asp-for="Input.GameFolder" class="form-control" placeholder="contoh: rock-paper-scissors" />
                        <div class="form-hint">Folder yang dicari sistem di <code>wwwroot/games/{folder}/</code>.</div>
                    </div>

                    <div>
                        <label class="form-label" for="gameEntryFile">File Entry HTML:</label>
                        <input type="text" id="gameEntryFile" asp-for="Input.GameEntryFile" class="form-control" value="index.html" placeholder="index.html" />
                        <div class="form-hint">Default: <code>index.html</code></div>
                    </div>

                    <div>
                        <label class="form-label" for="gameCustomParams">Parameter URL Kustom (Opsional):</label>
                        <input type="text" id="gameCustomParams" asp-for="Input.GameCustomParams" class="form-control" placeholder="contoh: mode=auto&p2=KOMPUTER" />
                        <div class="form-hint">Parameter yang otomatis diteruskan ke URL game (misal: <code>mode=auto</code>).</div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Materi Iklan LED (Sisi Kiri) -->
            <div class="form-section" style="margin-bottom: 20px;">
                <div class="section-title">
                    <span>📺</span>
                    <span>3. Materi Iklan Layar LED (Sisi Kiri Videotron)</span>
                </div>

                <div class="form-grid">
                    <div>
                        <label class="form-label" for="headline">Headline Iklan:</label>
                        <input type="text" id="headline" asp-for="Input.AdHeadline" class="form-control" placeholder="contoh: REVOLUSI LAYAR LIPAT" />
                    </div>

                    <div>
                        <label class="form-label" for="subheadline">Sub-Headline Iklan:</label>
                        <input type="text" id="subheadline" asp-for="Input.AdSubheadline" class="form-control" placeholder="contoh: GALAXY Z FOLD5 - CASHBACK 2JT" />
                    </div>

                    <div class="form-grid-full">
                        <label class="form-label" for="bannerImage">URL / Path Poster Iklan:</label>
                        <input type="text" id="bannerImage" asp-for="Input.BannerImageUrl" class="form-control" placeholder="/images/samsung_galaxy_fold.svg atau link gambar klien" />
                        <div class="form-hint">Jika dikosongkan, default gambar placeholder vector akan digunakan.</div>
                    </div>
                </div>
            </div>

            <!-- Section 4: Pertanyaan & Opsi Jawaban (Pilihan Ganda) -->
            <div class="form-section" id="sectionQuestionOptions" style="margin-bottom: 24px;">
                <div class="section-title">
                    <span>❓</span>
                    <span>4. Pertanyaan & Opsi Pilihan Ganda (Modul 7)</span>
                </div>

                <div id="quizNotice" style="display: none; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 12px; padding: 12px 16px; font-size: 13px; color: #6EE7B7; font-weight: 600;">
                    🎯 <strong>Mode BrandIQ (Kuis):</strong> Pilih salah satu opsi sebagai <strong>Kunci Jawaban Benar</strong> dengan memilih tombol radio "Benar" pada opsi jawaban yang tepat.
                </div>

                <div>
                    <label class="form-label" for="questionText">Teks Pertanyaan Konten / Kuis:</label>
                    <textarea id="questionText" asp-for="Input.QuestionText" class="form-control" rows="2" placeholder="contoh: Fitur layanan Grab apa yang paling sering Anda gunakan saat jam sibuk?" required></textarea>
                </div>

                <div>
                    <label class="form-label" style="margin-bottom: 12px;">Daftar Opsi Jawaban (Minimal 2 Opsi):</label>
                    
                    <div id="optionsContainer">
                        @for (int i = 0; i < Model.Input.Options.Count; i++)
                        {
                            <div class="option-row" id="optRow_@i">
                                <div class="option-badge" style="background-color: @Model.Input.Options[i].ColorHex;" id="badge_@i">
                                    @Model.Input.Options[i].OptionKey
                                </div>
                                <input type="hidden" name="Input.Options[@i].OptionKey" value="@Model.Input.Options[i].OptionKey" id="key_@i" />
                                
                                <input type="text" name="Input.Options[@i].OptionText" class="form-control" placeholder="Teks Pilihan (contoh: GrabBike)" value="@Model.Input.Options[i].OptionText" required />
                                
                                <input type="text" name="Input.Options[@i].OptionImageUrl" class="form-control" placeholder="URL Ikon/Gambar (opsional)" value="@Model.Input.Options[i].OptionImageUrl" />

                                <input type="color" name="Input.Options[@i].ColorHex" class="color-picker" value="@Model.Input.Options[i].ColorHex" onchange="updateBadgeColor(@i, this.value)" />

                                <label class="quiz-correct-label quiz-only" style="display: none;" title="Pilih sebagai kunci jawaban yang benar">
                                    <input type="radio" name="Input.CorrectOptionKey" value="@Model.Input.Options[i].OptionKey" @(i == 0 ? "checked" : "") style="accent-color: #10B981; width: 16px; height: 16px;" />
                                    <span>Benar</span>
                                </label>
                                
                                <button type="button" class="btn-remove-opt" onclick="removeOptionRow(@i)" title="Hapus Opsi">✕</button>
                            </div>
                        }
                    </div>

                    <button type="button" class="btn-add-opt" onclick="addOptionRow()">
                        <span>➕</span>
                        <span>Tambah Opsi Jawaban Berikutnya</span>
                    </button>
                </div>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-save">
                💾 Simpan Dynamic Content & Generate 3 Tampilan Interface
            </button>
        </form>

    </main>

    <script>
        const alphabet = ["A", "B", "C", "D", "E", "F", "G", "H"];
        const defaultColors = ["#3B82F6", "#10B981", "#F59E0B", "#8B5CF6", "#EC4899", "#06B6D4"];

        function toggleContentType() {
            const type = document.getElementById("contentType").value;
            const isQuiz = (type === "BrandIQ");
            const isGame = (type === "Game");
            const isPhoto = (type === "PhotoComment");

            // Game Section Toggle
            const gameSection = document.getElementById("gameConfigSection");
            const questionSection = document.getElementById("sectionQuestionOptions");
            const questionInput = document.getElementById("questionText");

            if (gameSection) gameSection.style.display = isGame ? "flex" : "none";
            if (questionSection) questionSection.style.display = (isGame || isPhoto) ? "none" : "flex";

            if (isPhoto) {
                // Auto set defaults for PhotoComment (Modul 6)
                const partMode = document.getElementById("participationMode");
                const gapDur = document.getElementById("gapDuration");
                if (partMode) {
                    partMode.value = "multipletime";
                    toggleGapDuration();
                }
                if (gapDur && (!gapDur.value || gapDur.value === "10")) {
                    gapDur.value = "15";
                }
                const themeCol = document.getElementById("themeColorHex");
                if (themeCol && (themeCol.value === "#0072FF" || !themeCol.value)) {
                    themeCol.value = "#D97706";
                }
            }

            if (questionInput) {
                if (isGame || isPhoto) {
                    questionInput.removeAttribute("required");
                } else {
                    questionInput.setAttribute("required", "required");
                }
            }

            // Options Required Attribute
            document.querySelectorAll(".option-row input[name$='.OptionText']").forEach((inp, idx) => {
                if (isGame || isPhoto) {
                    inp.removeAttribute("required");
                } else if (idx < 2) {
                    inp.setAttribute("required", "required");
                }
            });

            // Quiz elements
            const notice = document.getElementById("quizNotice");
            if (notice) notice.style.display = isQuiz ? "block" : "none";
            document.querySelectorAll(".quiz-only").forEach(el => {
                el.style.display = isQuiz ? "inline-flex" : "none";
            });
        }

        function toggleGapDuration() {
            const mode = document.getElementById("participationMode").value;
            const gapGroup = document.getElementById("gapDurationGroup");
            if (gapGroup) {
                gapGroup.style.display = (mode === "multipletime") ? "block" : "none";
            }
        }

        function updateBadgeColor(index, color) {
            const badge = document.getElementById(`badge_${index}`);
            if (badge) {
                badge.style.backgroundColor = color;
            }
        }

        function removeOptionRow(index) {
            const rows = document.querySelectorAll(".option-row");
            if (rows.length <= 2) {
                alert("Konten pilihan ganda membutuhkan minimal 2 opsi jawaban.");
                return;
            }
            const targetRow = document.getElementById(`optRow_${index}`);
            if (targetRow) {
                targetRow.remove();
                reindexOptionRows();
            }
        }

        function addOptionRow() {
            const container = document.getElementById("optionsContainer");
            const currentRows = document.querySelectorAll(".option-row");
            const newIndex = currentRows.length;
            const letter = newIndex < alphabet.length ? alphabet[newIndex] : (newIndex + 1);
            const color = defaultColors[newIndex % defaultColors.length];
            const isQuiz = (document.getElementById("contentType").value === "BrandIQ");

            const rowHtml = `
                <div class="option-row" id="optRow_${newIndex}">
                    <div class="option-badge" style="background-color: ${color};" id="badge_${newIndex}">
                        ${letter}
                    </div>
                    <input type="hidden" name="Input.Options[${newIndex}].OptionKey" value="${letter}" id="key_${newIndex}" />
                    <input type="text" name="Input.Options[${newIndex}].OptionText" class="form-control" placeholder="Teks Pilihan (contoh: Pilihan ${letter})" required />
                    <input type="text" name="Input.Options[${newIndex}].OptionImageUrl" class="form-control" placeholder="URL Ikon/Gambar (opsional)" />
                    <input type="color" name="Input.Options[${newIndex}].ColorHex" class="color-picker" value="${color}" onchange="updateBadgeColor(${newIndex}, this.value)" />
                    <label class="quiz-correct-label quiz-only" style="display: ${isQuiz ? 'inline-flex' : 'none'};" title="Pilih sebagai kunci jawaban yang benar">
                        <input type="radio" name="Input.CorrectOptionKey" value="${letter}" style="accent-color: #10B981; width: 16px; height: 16px;" />
                        <span>Benar</span>
                    </label>
                    <button type="button" class="btn-remove-opt" onclick="removeOptionRow(${newIndex})" title="Hapus Opsi">✕</button>
                </div>
            `;

            container.insertAdjacentHTML("beforeend", rowHtml);
        }

        function reindexOptionRows() {
            const rows = document.querySelectorAll(".option-row");
            rows.forEach((row, idx) => {
                const letter = idx < alphabet.length ? alphabet[idx] : (idx + 1);
                row.id = `optRow_${idx}`;
                
                const badge = row.querySelector(".option-badge");
                if (badge) {
                    badge.id = `badge_${idx}`;
                    badge.innerText = letter;
                }

                const keyInput = row.querySelector("input[type='hidden']");
                if (keyInput) {
                    keyInput.id = `key_${idx}`;
                    keyInput.name = `Input.Options[${idx}].OptionKey`;
                    keyInput.value = letter;
                }

                const inputs = row.querySelectorAll("input[type='text']");
                if (inputs.length >= 2) {
                    inputs[0].name = `Input.Options[${idx}].OptionText`;
                    inputs[1].name = `Input.Options[${idx}].OptionImageUrl`;
                }

                const colorInput = row.querySelector("input[type='color']");
                if (colorInput) {
                    colorInput.name = `Input.Options[${idx}].ColorHex`;
                    colorInput.setAttribute("onchange", `updateBadgeColor(${idx}, this.value)`);
                }

                const radio = row.querySelector("input[type='radio']");
                if (radio) {
                    radio.value = letter;
                }

                const removeBtn = row.querySelector(".btn-remove-opt");
                if (removeBtn) {
                    removeBtn.setAttribute("onclick", `removeOptionRow(${idx})`);
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            toggleContentType();
        });
    </script>
</body>
</html>
