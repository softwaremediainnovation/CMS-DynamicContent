@page
@model CmsBillboard.DynamicContent.Pages.Admin.Surveys.CreateModel
@{
    Layout = null;
    ViewData["Title"] = "Tambah Survey Klien Baru — Admin Studio";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-base: #070B14;
            --bg-card: #0F172A;
            --bg-card-alt: #1E293B;
            --primary: #38BDF8;
            --primary-hover: #0284C7;
            --border: rgba(255, 255, 255, 0.1);
            --border-glow: rgba(56, 189, 248, 0.25);
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: 
                radial-gradient(circle at 10% 10%, rgba(30, 58, 138, 0.2) 0%, transparent 40%),
                radial-gradient(circle at 90% 90%, rgba(13, 148, 136, 0.15) 0%, transparent 40%);
        }

        .admin-nav {
            background: rgba(11, 19, 36, 0.9);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
            padding: 16px 36px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-logo {
            font-size: 20px;
            font-weight: 900;
            background: linear-gradient(135deg, #FF3366, #FF9933);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 1.5px;
        }

        .main-container {
            flex: 1;
            max-width: 960px;
            margin: 0 auto;
            width: 100%;
            padding: 32px 24px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .header-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(135deg, #0F172A, #1E293B);
            border: 1px solid var(--border-glow);
            border-radius: 20px;
            padding: 22px 28px;
        }

        .header-title {
            font-size: 22px;
            font-weight: 800;
        }

        .btn-back {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: rgba(30, 41, 59, 0.6);
            transition: all 0.2s ease;
        }

        .btn-back:hover {
            color: #FFFFFF;
            border-color: var(--primary);
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.4);
            color: #FCA5A5;
            padding: 14px 18px;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 600;
        }

        /* Form Card & Sections */
        .form-section {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 28px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 12px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }

        .form-grid-full {
            grid-column: span 2;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .form-control {
            width: 100%;
            background: #0B1120;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 600;
            color: #FFFFFF;
            outline: none;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
        }

        .form-hint {
            font-size: 11px;
            color: #64748B;
            margin-top: 4px;
        }

        /* Dynamic Options Styling */
        .option-row {
            display: grid;
            grid-template-columns: 50px 1fr 100px 40px;
            gap: 12px;
            align-items: center;
            background: rgba(30, 41, 59, 0.4);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 12px 16px;
            margin-bottom: 10px;
        }

        .option-badge {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 16px;
            color: #FFFFFF;
        }

        .color-picker {
            width: 100%;
            height: 42px;
            padding: 2px;
            background: #0B1120;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            cursor: pointer;
        }

        .btn-remove-opt {
            background: rgba(239, 68, 68, 0.15);
            color: #EF4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 10px;
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-remove-opt:hover {
            background: #EF4444;
            color: #FFFFFF;
        }

        .btn-add-opt {
            background: rgba(56, 189, 248, 0.12);
            color: var(--primary);
            border: 1px dashed rgba(56, 189, 248, 0.4);
            border-radius: 12px;
            padding: 12px;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            width: 100%;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-add-opt:hover {
            background: rgba(56, 189, 248, 0.2);
            border-color: var(--primary);
        }

        /* Submit Button */
        .btn-save {
            background: linear-gradient(135deg, #38BDF8, #0284C7);
            color: #FFFFFF;
            border: none;
            border-radius: 16px;
            padding: 16px 28px;
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 0.5px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(2, 132, 199, 0.4);
            transition: all 0.2s ease;
            width: 100%;
        }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(2, 132, 199, 0.5);
        }
    </style>
</head>
<body>

    <header class="admin-nav">
        <span class="brand-logo">WARNA WARNI DYNAMIC DOOH</span>
        <a href="/Admin/Index" class="btn-back">← Kembali ke Dashboard</a>
    </header>

    <main class="main-container">
        
        <div class="header-box">
            <div>
                <h1 class="header-title">Tambah Survey Klien Baru</h1>
                <p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">
                    Formulir generator konten dinamis untuk kampanye klien (menghasilkan 3 interface otomatis).
                </p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert-error">
                <span>⚠️</span>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form method="post" id="createSurveyForm">
            
            <!-- Section 1: Klien & Kampanye -->
            <div class="form-section" style="margin-bottom: 20px;">
                <div class="section-title">
                    <span>🏢</span>
                    <span>1. Informasi Klien & Kampanye</span>
                </div>

                <div class="form-grid">
                    <div>
                        <label class="form-label" for="clientId">ID / Slug Unik Survey:</label>
                        <input type="text" id="clientId" asp-for="Input.Id" class="form-control" placeholder="contoh: grab-promo-2026, byd-electric" required />
                        <div class="form-hint">Digunakan dalam URL unik videotron & token. Huruf kecil, angka, dan minus.</div>
                        <span asp-validation-for="Input.Id" style="color:#F87171; font-size:12px;"></span>
                    </div>

                    <div>
                        <label class="form-label" for="clientName">Nama Klien / Brand:</label>
                        <input type="text" id="clientName" asp-for="Input.ClientName" class="form-control" placeholder="contoh: Samsung, Grab, Tolak Angin, BYD" required />
                    </div>

                    <div class="form-grid-full">
                        <label class="form-label" for="campaignTitle">Judul Kampanye:</label>
                        <input type="text" id="campaignTitle" asp-for="Input.CampaignTitle" class="form-control" placeholder="contoh: SURVEY KEPUASAN PENGGUNA GRAB INDONESIA" required />
                    </div>

                    <div>
                        <label class="form-label" for="themeColor">Warna Aksen Brand:</label>
                        <input type="color" id="themeColor" asp-for="Input.ThemeColorHex" class="color-picker" value="#0072FF" />
                    </div>

                    <div>
                        <label class="form-label" for="brandLogo">URL Logo Brand (Opsional):</label>
                        <input type="text" id="brandLogo" asp-for="Input.BrandLogoUrl" class="form-control" placeholder="/images/logo.png atau URL web" />
                    </div>
                </div>
            </div>

            <!-- Section 2: Materi Iklan LED (Sisi Kiri) -->
            <div class="form-section" style="margin-bottom: 20px;">
                <div class="section-title">
                    <span>📺</span>
                    <span>2. Materi Iklan Layar LED (Sisi Kiri Videotron)</span>
                </div>

                <div class="form-grid">
                    <div>
                        <label class="form-label" for="headline">Headline Iklan:</label>
                        <input type="text" id="headline" asp-for="Input.AdHeadline" class="form-control" placeholder="contoh: REVOLUSI LAYAR LIPAT" />
                    </div>

                    <div>
                        <label class="form-label" for="subheadline">Sub-Headline Iklan:</label>
                        <input type="text" id="subheadline" asp-for="Input.AdSubheadline" class="form-control" placeholder="contoh: GALAXY Z FOLD5 - CASHBACK 2JT" />
                    </div>

                    <div class="form-grid-full">
                        <label class="form-label" for="bannerImage">URL / Path Poster Iklan:</label>
                        <input type="text" id="bannerImage" asp-for="Input.BannerImageUrl" class="form-control" placeholder="/images/samsung_galaxy_fold.svg atau link gambar klien" />
                        <div class="form-hint">Jika dikosongkan, default gambar placeholder vector akan digunakan.</div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Pertanyaan & Opsi Jawaban (Pilihan Ganda) -->
            <div class="form-section" style="margin-bottom: 24px;">
                <div class="section-title">
                    <span>❓</span>
                    <span>3. Pertanyaan & Opsi Pilihan Ganda (Modul 7)</span>
                </div>

                <div>
                    <label class="form-label" for="questionText">Teks Pertanyaan Survey:</label>
                    <textarea id="questionText" asp-for="Input.QuestionText" class="form-control" rows="2" placeholder="contoh: Fitur layanan Grab apa yang paling sering Anda gunakan saat jam sibuk?" required></textarea>
                </div>

                <div>
                    <label class="form-label" style="margin-bottom: 12px;">Daftar Opsi Jawaban (Minimal 2 Opsi):</label>
                    
                    <div id="optionsContainer">
                        @for (int i = 0; i < Model.Input.Options.Count; i++)
                        {
                            <div class="option-row" id="optRow_@i">
                                <div class="option-badge" style="background-color: @Model.Input.Options[i].ColorHex;" id="badge_@i">
                                    @Model.Input.Options[i].OptionKey
                                </div>
                                <input type="hidden" name="Input.Options[@i].OptionKey" value="@Model.Input.Options[i].OptionKey" id="key_@i" />
                                
                                <input type="text" name="Input.Options[@i].OptionText" class="form-control" placeholder="Teks Pilihan (contoh: GrabBike, Baterai, dll)" value="@Model.Input.Options[i].OptionText" required />
                                
                                <input type="color" name="Input.Options[@i].ColorHex" class="color-picker" value="@Model.Input.Options[i].ColorHex" onchange="updateBadgeColor(@i, this.value)" />
                                
                                <button type="button" class="btn-remove-opt" onclick="removeOptionRow(@i)" title="Hapus Opsi">✕</button>
                            </div>
                        }
                    </div>

                    <button type="button" class="btn-add-opt" onclick="addOptionRow()">
                        <span>➕</span>
                        <span>Tambah Opsi Jawaban Berikutnya</span>
                    </button>
                </div>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-save">
                💾 Simpan Survey & Generate 3 Tampilan Interface
            </button>
        </form>

    </main>

    <script>
        const alphabet = ["A", "B", "C", "D", "E", "F", "G", "H"];
        const defaultColors = ["#3B82F6", "#10B981", "#F59E0B", "#8B5CF6", "#EC4899", "#06B6D4"];

        function updateBadgeColor(index, color) {
            const badge = document.getElementById(`badge_${index}`);
            if (badge) {
                badge.style.backgroundColor = color;
            }
        }

        function removeOptionRow(index) {
            const rows = document.querySelectorAll(".option-row");
            if (rows.length <= 2) {
                alert("Survey pilihan ganda membutuhkan minimal 2 opsi jawaban.");
                return;
            }
            const targetRow = document.getElementById(`optRow_${index}`);
            if (targetRow) {
                targetRow.remove();
                reindexOptionRows();
            }
        }

        function addOptionRow() {
            const container = document.getElementById("optionsContainer");
            const currentRows = document.querySelectorAll(".option-row");
            const newIndex = currentRows.length;
            const letter = newIndex < alphabet.length ? alphabet[newIndex] : (newIndex + 1);
            const color = defaultColors[newIndex % defaultColors.length];

            const rowHtml = `
                <div class="option-row" id="optRow_${newIndex}">
                    <div class="option-badge" style="background-color: ${color};" id="badge_${newIndex}">
                        ${letter}
                    </div>
                    <input type="hidden" name="Input.Options[${newIndex}].OptionKey" value="${letter}" id="key_${newIndex}" />
                    <input type="text" name="Input.Options[${newIndex}].OptionText" class="form-control" placeholder="Teks Pilihan (contoh: Pilihan ${letter})" required />
                    <input type="color" name="Input.Options[${newIndex}].ColorHex" class="color-picker" value="${color}" onchange="updateBadgeColor(${newIndex}, this.value)" />
                    <button type="button" class="btn-remove-opt" onclick="removeOptionRow(${newIndex})" title="Hapus Opsi">✕</button>
                </div>
            `;

            container.insertAdjacentHTML("beforeend", rowHtml);
        }

        function reindexOptionRows() {
            const rows = document.querySelectorAll(".option-row");
            rows.forEach((row, idx) => {
                const letter = idx < alphabet.length ? alphabet[idx] : (idx + 1);
                row.id = `optRow_${idx}`;
                
                const badge = row.querySelector(".option-badge");
                if (badge) {
                    badge.id = `badge_${idx}`;
                    badge.innerText = letter;
                }

                const keyInput = row.querySelector("input[type='hidden']");
                if (keyInput) {
                    keyInput.id = `key_${idx}`;
                    keyInput.name = `Input.Options[${idx}].OptionKey`;
                    keyInput.value = letter;
                }

                const textInput = row.querySelector("input[type='text']");
                if (textInput) {
                    textInput.name = `Input.Options[${idx}].OptionText`;
                }

                const colorInput = row.querySelector("input[type='color']");
                if (colorInput) {
                    colorInput.name = `Input.Options[${idx}].ColorHex`;
                    colorInput.setAttribute("onchange", `updateBadgeColor(${idx}, this.value)`);
                }

                const removeBtn = row.querySelector(".btn-remove-opt");
                if (removeBtn) {
                    removeBtn.setAttribute("onclick", `removeOptionRow(${idx})`);
                }
            });
        }
    </script>
</body>
</html>
