@page
@model CmsBillboard.DynamicContent.Pages.Admin.Surveys.ReportModel
@{
    Layout = null;
    var survey = Model.Survey;
    var question = Model.Question;
    string activeCity = Model.City ?? "All";
    string activeSite = Model.SiteId ?? "All";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Executive Report: @(survey?.CampaignTitle ?? "Hasil Survey") — Warna Warni DOOH</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-base: #070B14;
            --bg-card: #0F172A;
            --bg-card-alt: #1E293B;
            --primary: #38BDF8;
            --primary-hover: #0284C7;
            --accent: #10B981;
            --gold: #F59E0B;
            --danger: #EF4444;
            --border: rgba(255, 255, 255, 0.08);
            --border-glow: rgba(56, 189, 248, 0.25);
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: 
                radial-gradient(circle at 10% 10%, rgba(30, 58, 138, 0.25) 0%, transparent 45%),
                radial-gradient(circle at 90% 90%, rgba(13, 148, 136, 0.2) 0%, transparent 45%);
        }

        /* Top Bar */
        .admin-nav {
            background: rgba(11, 19, 36, 0.9);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
            padding: 16px 36px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-box {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-logo {
            font-size: 20px;
            font-weight: 900;
            background: linear-gradient(135deg, #FF3366, #FF9933);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 1.5px;
        }

        .brand-tag {
            font-size: 13px;
            font-weight: 700;
            color: var(--primary);
            padding-left: 12px;
            border-left: 2px solid rgba(255, 255, 255, 0.15);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s ease;
            border: 1px solid var(--border);
        }

        .btn-secondary {
            background: rgba(30, 41, 59, 0.6);
            color: #FFFFFF;
        }

        .btn-secondary:hover {
            background: rgba(51, 65, 85, 0.8);
        }

        .btn-primary {
            background: linear-gradient(135deg, #0284C7, #38BDF8);
            color: #0F172A;
            font-weight: 800;
            border: none;
        }

        .btn-primary:hover {
            filter: brightness(1.1);
        }

        /* Container */
        .main-content {
            flex: 1;
            max-width: 1340px;
            margin: 0 auto;
            width: 100%;
            padding: 30px 36px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        /* Header Card */
        .report-header-card {
            background: linear-gradient(135deg, #0F172A, #1E293B);
            border: 1px solid var(--border-glow);
            border-radius: 20px;
            padding: 24px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        .client-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(56, 189, 248, 0.15);
            color: #38BDF8;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .campaign-name {
            font-size: 26px;
            font-weight: 900;
            line-height: 1.25;
            color: #FFFFFF;
        }

        .question-subtitle {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* Scope Filter Bar (Consolidated vs Kota vs Titik LED) */
        .filter-panel {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }

        .filter-group {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .filter-label {
            font-size: 13px;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .scope-pill {
            padding: 7px 16px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            color: #94A3B8;
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid var(--border);
            transition: all 0.2s ease;
        }

        .scope-pill:hover {
            color: #FFFFFF;
            background: rgba(51, 65, 85, 0.8);
        }

        .scope-pill.active {
            background: #38BDF8;
            color: #0F172A;
            font-weight: 800;
            border-color: #38BDF8;
        }

        .select-filter {
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid var(--border);
            color: #FFFFFF;
            padding: 7px 14px;
            border-radius: 10px;
            font-size: 13px;
            font-family: inherit;
            font-weight: 600;
            outline: none;
        }

        /* KPI Cards Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .kpi-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 20px 24px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            position: relative;
            overflow: hidden;
        }

        .kpi-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
        }

        .kpi-blue::before { background: #38BDF8; }
        .kpi-gold::before { background: #F59E0B; }
        .kpi-green::before { background: #10B981; }
        .kpi-purple::before { background: #A78BFA; }

        .kpi-title {
            font-size: 12px;
            font-weight: 800;
            color: var(--text-muted);
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .kpi-value {
            font-size: 32px;
            font-weight: 900;
            color: #FFFFFF;
            font-family: monospace;
            line-height: 1.1;
        }

        .kpi-sub {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
        }

        /* Analytical Grid */
        .analytics-grid {
            display: grid;
            grid-template-columns: 1.35fr 1fr;
            gap: 24px;
        }

        .panel-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 26px 28px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .panel-title {
            font-size: 18px;
            font-weight: 800;
            color: #FFFFFF;
        }

        .panel-badge {
            font-size: 12px;
            font-weight: 700;
            color: var(--primary);
            background: rgba(56, 189, 248, 0.12);
            padding: 4px 10px;
            border-radius: 8px;
        }

        /* Voting Bars */
        .option-row {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .option-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
        }

        .opt-tag {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border-radius: 6px;
            font-weight: 900;
            font-size: 12px;
            color: #FFFFFF;
            margin-right: 8px;
        }

        .progress-track {
            height: 24px;
            background: rgba(30, 41, 59, 0.7);
            border-radius: 8px;
            overflow: hidden;
            position: relative;
        }

        .progress-fill {
            height: 100%;
            border-radius: 8px;
            transition: width 0.8s ease;
            position: relative;
        }

        /* Demographic & Smartphone Intelligence */
        .device-stat-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .device-stat-item {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .device-info-line {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 700;
        }

        .bar-mini-track {
            height: 10px;
            background: rgba(30, 41, 59, 0.6);
            border-radius: 5px;
            overflow: hidden;
        }

        .bar-mini-fill {
            height: 100%;
            border-radius: 5px;
            background: linear-gradient(90deg, #38BDF8, #818CF8);
        }

        /* Tables */
        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            background: rgba(15, 23, 42, 0.8);
            padding: 12px 18px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 14px 18px;
            font-size: 13px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: rgba(30, 41, 59, 0.4);
        }

        /* Print styles */
        @@media print {
            body {
                background: #FFFFFF !important;
                color: #000000 !important;
            }
            .admin-nav, .filter-panel, .btn-action {
                display: none !important;
            }
            .panel-card, .kpi-card, .report-header-card {
                background: #FFFFFF !important;
                border: 1px solid #CCCCCC !important;
                color: #000000 !important;
                box-shadow: none !important;
            }
            .campaign-name, .kpi-value, .panel-title {
                color: #000000 !important;
            }
        }
    </style>
</head>
<body>

    <!-- Top Admin Bar -->
    <header class="admin-nav">
        <div class="brand-box">
            <span class="brand-logo">WARNA WARNI</span>
            <span class="brand-tag">EXECUTIVE DOOH REPORT</span>
        </div>
        <div class="nav-actions">
            <a href="/Admin/Index" class="btn-action btn-secondary">
                <span>🔙</span>
                <span>Dashboard</span>
            </a>
            <button onclick="window.print()" class="btn-action btn-secondary">
                <span>🖨️</span>
                <span>Cetak / PDF</span>
            </button>
            <button onclick="exportCsv()" class="btn-action btn-primary">
                <span>📥</span>
                <span>Download CSV Raw</span>
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">

        <!-- Header Card: Client Campaign Info -->
        <div class="report-header-card">
            <div>
                <div class="client-tag">
                    <span>🏢</span>
                    <span>@(survey?.ClientName ?? "Sponsor")</span>
                </div>
                <h1 class="campaign-name">@(survey?.CampaignTitle ?? "Laporan Hasil Survey DOOH")</h1>
                <p class="question-subtitle">❓ Pertanyaan: @(question?.QuestionText ?? "-")</p>
            </div>
            <div style="text-align: right;">
                <div style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Status Kampanye</div>
                <div style="font-size: 15px; font-weight: 900; color: #10B981; margin-top: 2px;">
                    @(survey?.IsActive == true ? "🟢 BERJALAN AKTIF" : "⚪ ARSIP")
                </div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">
                    ID: <code style="color: var(--primary);">@Model.Id</code>
                </div>
            </div>
        </div>

        <!-- Filter Bar: Consolidated / Per Kota / Per Titik LED -->
        <div class="filter-panel">
            <div class="filter-group">
                <span class="filter-label">Cakupan Data:</span>
                <a href="/Admin/Surveys/Report?id=@Model.Id&city=All&siteId=All" class="scope-pill @(activeCity == "All" && activeSite == "All" ? "active" : "")">
                    🇮🇩 Seluruh Indonesia (Consolidated)
                </a>
                @foreach (var city in Model.AvailableCities)
                {
                    <a href="/Admin/Surveys/Report?id=@Model.Id&city=@city&siteId=All" class="scope-pill @(activeCity == city && activeSite == "All" ? "active" : "")">
                        🏙️ @city
                    </a>
                }
            </div>

            <!-- Titik LED Dropdown Filter -->
            <div class="filter-group">
                <span class="filter-label">Titik LED Spesifik:</span>
                <select class="select-filter" onchange="location.href='/Admin/Surveys/Report?id=@Model.Id&city=@activeCity&siteId=' + this.value">
                    <option value="All" selected="@(activeSite == "All")">Semua Titik LED</option>
                    @foreach (var site in Model.AvailableSites)
                    {
                        <option value="@site" selected="@(activeSite == site)">📍 @site</option>
                    }
                </select>
            </div>
        </div>

        <!-- KPI Cards Grid -->
        <div class="kpi-grid">
            <div class="kpi-card kpi-blue">
                <div class="kpi-title">Total Suara Masuk</div>
                <div class="kpi-value">@Model.TotalVotes</div>
                <div class="kpi-sub">Verifikasi 1 Orang = 1 Suara</div>
            </div>
            <div class="kpi-card kpi-gold">
                <div class="kpi-title">Pilihan Terfavorit (Juara)</div>
                <div class="kpi-value" style="color: var(--gold); font-size: 24px;">
                    Opsi @Model.WinningOptionKey (@Model.WinningOptionPct%)
                </div>
                <div class="kpi-sub" title="@Model.WinningOptionText" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    @Model.WinningOptionText
                </div>
            </div>
            <div class="kpi-card kpi-green">
                <div class="kpi-title">Rata-Rata Waktu Respon</div>
                <div class="kpi-value">@(Model.AvgResponseTime)s</div>
                <div class="kpi-sub">Detik sejak scan hingga submit</div>
            </div>
            <div class="kpi-card kpi-purple">
                <div class="kpi-title">Titik LED Teraktif</div>
                <div class="kpi-value" style="font-size: 22px;">@Model.TopPerformingSite</div>
                <div class="kpi-sub">Partisipasi tertinggi audiens</div>
            </div>
        </div>

        <!-- Main Analytics: Voting Options vs Audience Smartphone Intelligence -->
        <div class="analytics-grid">
            
            <!-- Left: Hasil Voting Per Opsi -->
            <div class="panel-card">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">Distribusi Pilihan Audiens</h2>
                        <div style="font-size: 13px; color: var(--text-muted); margin-top: 2px;">
                            Akumulasi perolehan suara pada opsi A, B, C, D
                        </div>
                    </div>
                    <span class="panel-badge">Hasil Valid</span>
                </div>

                <div style="display: flex; flex-direction: column; gap: 18px;">
                    @foreach (var opt in Model.OptionStats)
                    {
                        <div class="option-row">
                            <div class="option-meta">
                                <div>
                                    <span class="opt-tag" style="background-color: @opt.Color;">@opt.Key</span>
                                    <strong style="color: #FFFFFF;">@opt.Text</strong>
                                </div>
                                <div>
                                    <span style="font-weight: 800; color: #FFFFFF; font-size: 16px;">@opt.Percentage%</span>
                                    <span style="color: var(--text-muted); font-size: 12px; margin-left: 6px;">(@opt.Count suara)</span>
                                </div>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width: @(opt.Percentage)%; background: @opt.Color;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Audience Smartphone & Device Intelligence (Nilai Jual Klien!) -->
            <div class="panel-card">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">Profil Smartphone Audiens</h2>
                        <div style="font-size: 13px; color: var(--text-muted); margin-top: 2px;">
                            Telemetri perangkat dari browser penonton
                        </div>
                    </div>
                    <span class="panel-badge" style="color: #10B981; background: rgba(16, 185, 129, 0.12);">Data Eksklusif</span>
                </div>

                <!-- Brand HP Audiens -->
                <div class="device-stat-list">
                    <div style="font-size: 12px; font-weight: 800; color: var(--primary); text-transform: uppercase; letter-spacing: 1px;">
                        📱 Brand Handphone Terdeteksi:
                    </div>
                    @if (Model.DeviceBrandStats.Any())
                    {
                        foreach (var b in Model.DeviceBrandStats.Take(5))
                        {
                            <div class="device-stat-item">
                                <div class="device-info-line">
                                    <span>@b.BrandName</span>
                                    <span style="color: var(--primary);">@b.Percentage% (@b.Count)</span>
                                </div>
                                <div class="bar-mini-track">
                                    <div class="bar-mini-fill" style="width: @(b.Percentage)%;"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="font-size: 13px; color: var(--text-muted);">Belum ada data telemetri brand HP terkumpul.</div>
                    }

                    <!-- Operating System Breakdown -->
                    <div style="margin-top: 10px; font-size: 12px; font-weight: 800; color: var(--primary); text-transform: uppercase; letter-spacing: 1px;">
                        ⚙️ Sistem Operasi:
                    </div>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        @foreach (var os in Model.OsStats)
                        {
                            <div style="background: rgba(30, 41, 59, 0.6); border: 1px solid var(--border); border-radius: 10px; padding: 6px 14px; font-size: 12px;">
                                <strong>@os.OsName:</strong> <span style="color: #38BDF8;">@os.Percentage%</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>

        <!-- Breakdown Antar Titik LED & Kota -->
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h2 class="panel-title">Perbandingan Performa Per Titik LED & Kota</h2>
                    <div style="font-size: 13px; color: var(--text-muted); margin-top: 2px;">
                        Evaluasi partisipasi audiens dan opsi favorit di masing-masing lokasi videotron
                    </div>
                </div>
                <span class="panel-badge">Multi-Location</span>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Titik LED / Lokasi</th>
                        <th>Kota</th>
                        <th>Total Partisipan</th>
                        <th>Kontribusi %</th>
                        <th>Opsi Favorit Titik Ini</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SiteStats.Any())
                    {
                        foreach (var site in Model.SiteStats)
                        {
                            <tr>
                                <td>
                                    <strong style="color: #FFFFFF;">📍 @site.SiteName</strong>
                                </td>
                                <td>
                                    <span style="color: var(--primary); font-weight: 700;">@site.City</span>
                                </td>
                                <td>
                                    <span style="font-weight: 800; font-family: monospace; font-size: 15px;">@site.TotalVotes</span> suara
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: #10B981;">@site.Percentage%</span>
                                </td>
                                <td>
                                    <span class="opt-tag" style="background-color: #3B82F6;">@site.TopOption</span>
                                    <span style="font-size: 12px; color: var(--text-muted);">Paling banyak dipilih</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 30px;">
                                Belum ada rincian data titik LED.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Recent Activity Log (50 Suara Terkini) -->
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h2 class="panel-title">Aktivitas Partisipasi Terkini (Raw Log)</h2>
                    <div style="font-size: 13px; color: var(--text-muted); margin-top: 2px;">
                        Sampel suara masuk real-time beserta telemetri perangkat audiens
                    </div>
                </div>
                <span class="panel-badge">50 Suara Terakhir</span>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Waktu (UTC/WIB)</th>
                        <th>Nama Audiens</th>
                        <th>Pilihan</th>
                        <th>Titik LED & Kota</th>
                        <th>Brand & Model HP</th>
                        <th>OS & Browser</th>
                        <th>Waktu Respon</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentLogs.Any())
                    {
                        foreach (var log in Model.RecentLogs)
                        {
                            <tr>
                                <td style="font-family: monospace; font-size: 12px; color: var(--text-muted);">
                                    @log.VotedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td>
                                    <strong>@log.UserName</strong>
                                </td>
                                <td>
                                    <span class="opt-tag" style="background-color: #38BDF8;">@log.OptionKey</span>
                                </td>
                                <td>
                                    <div><strong>@log.SiteId</strong></div>
                                    <div style="font-size: 11px; color: var(--text-muted);">@log.City</div>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: #FFFFFF;">@(log.DeviceBrand ?? "-")</span>
                                    <div style="font-size: 11px; color: var(--text-muted);">@(log.DeviceModel ?? "-")</div>
                                </td>
                                <td>
                                    <div>@(log.OperatingSystem ?? "-")</div>
                                    <div style="font-size: 11px; color: var(--text-muted);">@(log.BrowserName ?? "-")</div>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: #10B981;">@(log.TimeToVoteSeconds.HasValue ? $"{log.TimeToVoteSeconds.Value}s" : "-")</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 30px;">
                                Belum ada catatan aktivitas voting langsung.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </main>

    <script>
        function exportCsv() {
            const surveyId = "@Model.Id";
            const table = document.querySelectorAll("table")[1]; // raw logs table
            if (!table) return;

            let csv = [];
            const rows = table.querySelectorAll("tr");
            for (let i = 0; i < rows.length; i++) {
                let row = [], cols = rows[i].querySelectorAll("td, th");
                for (let j = 0; j < cols.length; j++) {
                    let text = cols[j].innerText.replace(/"/g, '""').replace(/\n/g, ' ');
                    row.push('"' + text + '"');
                }
                csv.push(row.join(","));
            }

            const csvFile = new Blob([csv.join("\n")], { type: "text/csv;charset=utf-8;" });
            const downloadLink = document.createElement("a");
            downloadLink.download = `WWM_DOOH_Report_${surveyId}.csv`;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
</body>
</html>
