@using CmsBillboard.DynamicContent.Services
@using System.Security.Claims
@{
    var activeMenu = (ViewData["ActiveMenu"] as string) ?? "campaigns";
    var localLanIp = NetworkHelper.GetLocalLanIp();
    var port = Context.Request.Host.Port ?? 5215;
    var serverBaseUrl = $"{Context.Request.Scheme}://{localLanIp}:{port}";
    var adminName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name ?? "Administrator";
    var adminRole = User.FindFirstValue(ClaimTypes.Role) ?? "Admin";
    var userInitial = string.IsNullOrEmpty(adminName) ? "A" : adminName.Substring(0, 1).ToUpperInvariant();
}

<style>
    /* ========================================================
       UNIFIED CMS ADMIN NAVBAR
       Theme: High-End Enterprise SaaS (Slate / Cobalt / Neutral)
       ======================================================== */
    .admin-global-navbar {
        background: #0D1321;
        border-bottom: 1px solid #1F293D;
        position: sticky;
        top: 0;
        z-index: 1050;
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .admin-nav-inner {
        max-width: 1440px;
        margin: 0 auto;
        padding: 0 24px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .admin-nav-left {
        display: flex;
        align-items: center;
        gap: 28px;
    }

    .admin-brand-link {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: inherit;
        flex-shrink: 0;
    }

    .admin-brand-badge {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: linear-gradient(135deg, #2563EB, #1D4ED8);
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 15px;
        box-shadow: 0 2px 6px rgba(37, 99, 235, 0.35);
    }

    .admin-brand-info {
        display: flex;
        flex-direction: column;
    }

    .admin-brand-title {
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #FFFFFF;
        line-height: 1.2;
    }

    .admin-brand-sub {
        font-size: 10px;
        font-weight: 700;
        color: #94A3B8;
        letter-spacing: 0.8px;
        text-transform: uppercase;
    }

    /* Navbar Menu Items */
    .admin-nav-menu {
        display: flex;
        align-items: center;
        gap: 4px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .admin-nav-item-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 8px;
        color: #94A3B8;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.15s ease;
        position: relative;
        white-space: nowrap;
    }

    .admin-nav-item-link svg {
        width: 16px;
        height: 16px;
        opacity: 0.85;
        flex-shrink: 0;
    }

    .admin-nav-item-link:hover {
        color: #FFFFFF;
        background: #182234;
    }

    .admin-nav-item-link.active {
        color: #FFFFFF;
        background: rgba(37, 99, 235, 0.12);
        border: 1px solid rgba(59, 130, 246, 0.25);
        font-weight: 700;
    }

    .admin-nav-item-link.active svg {
        color: #60A5FA;
        opacity: 1;
    }

    .admin-nav-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .admin-nav-badge-live {
        background: rgba(16, 185, 129, 0.12);
        color: #34D399;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .admin-nav-badge-game {
        background: rgba(245, 158, 11, 0.12);
        color: #FBBF24;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    /* Navbar Right Utilities */
    .admin-nav-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
    }



    /* SignalR Live Indicator */
    .admin-engine-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.25);
        padding: 5px 10px;
        border-radius: 8px;
        font-size: 11.5px;
        font-weight: 600;
        color: #34D399;
    }

    .admin-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #10B981;
        box-shadow: 0 0 6px rgba(16, 185, 129, 0.8);
        animation: admin-pulse-dot 2s infinite ease-in-out;
    }

    @@keyframes admin-pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* User Profile Pill */
    .admin-user-box {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 4px 10px;
        background: #182234;
        border: 1px solid #1F293D;
        border-radius: 8px;
    }

    .admin-user-avatar {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        background: #2563EB;
        color: #FFFFFF;
        font-weight: 700;
        font-size: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .admin-user-name {
        font-size: 12.5px;
        font-weight: 600;
        color: #FFFFFF;
    }

    .admin-user-role {
        font-size: 10px;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 4px;
        background: rgba(59, 130, 246, 0.15);
        color: #60A5FA;
    }

    /* Logout Button */
    .admin-btn-logout {
        background: transparent;
        color: #94A3B8;
        border: 1px solid #1F293D;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.15s ease;
    }

    .admin-btn-logout:hover {
        background: rgba(239, 68, 68, 0.12);
        border-color: rgba(239, 68, 68, 0.35);
        color: #F87171;
    }

    @@media (max-width: 900px) {
        .admin-nav-inner {
            height: auto;
            padding: 12px 16px;
            flex-wrap: wrap;
        }
        .admin-nav-left {
            gap: 16px;
            width: 100%;
            justify-content: space-between;
        }
        .admin-nav-menu {
            overflow-x: auto;
            width: 100%;
            padding: 6px 0;
        }
    }

    @@media print {
        .admin-global-navbar {
            display: none !important;
        }
    }
</style>

<header class="admin-global-navbar">
    <div class="admin-nav-inner">
        <!-- Brand & Main Navigation -->
        <div class="admin-nav-left">
            <a href="/Admin" class="admin-brand-link" title="Dashboard Utama Admin">
                <div class="admin-brand-badge">W</div>
                <div class="admin-brand-info">
                    <span class="admin-brand-title">Warna Warni</span>
                    <span class="admin-brand-sub">DOOH CMS Studio</span>
                </div>
            </a>

            <!-- Admin Menus with Active Status -->
            <nav>
                <ul class="admin-nav-menu">
                    <li>
                        <a href="/Admin" class="admin-nav-item-link @(activeMenu == "campaigns" ? "active" : "")" title="Daftar & Manajemen Dynamic Content">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                            <span>Kampanye & Konten</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/PhotoModeration" class="admin-nav-item-link @(activeMenu == "photo-moderation" ? "active" : "")" title="Moderasi Live Photo & Greetings Pengunjung">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                <circle cx="12" cy="13" r="4"></circle>
                            </svg>
                            <span>Moderasi Live Photo</span>
                            <span class="admin-nav-badge admin-nav-badge-live">Live</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/PetModeration" class="admin-nav-item-link @(activeMenu == "pet-moderation" ? "active" : "")" title="Moderasi Virtual Aquarium DOOH">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                            </svg>
                            <span>Moderasi Aquarium</span>
                            <span class="admin-nav-badge admin-nav-badge-game">Game</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/DynamicContents/Create" class="admin-nav-item-link @(activeMenu == "create-content" ? "active" : "")" title="Form Generator Konten Dinamis Klien Baru">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            <span>Buat Konten Baru</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- Right Utilities -->
        <div class="admin-nav-right">
            <!-- Quick Link to Screen Portal -->
            <a href="/" target="_blank" class="admin-nav-item-link" style="font-size: 12px; padding: 6px 10px;" title="Buka Portal Beranda DOOH Studio di tab baru">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                <span class="d-none d-lg-inline">Pratinjau Studio</span>
            </a>

            <!-- SignalR Status Indicator -->
            <div class="admin-engine-pill" title="Koneksi WebSocket SignalR Server Berjalan Normal">
                <span class="admin-status-dot"></span>
                <span class="d-none d-xl-inline">SignalR Aktif</span>
            </div>

            <!-- User Profile Box -->
            <div class="admin-user-box">
                <div class="admin-user-avatar">@userInitial</div>
                <div class="d-none d-md-flex align-items-center gap-2">
                    <span class="admin-user-name">@adminName</span>
                    <span class="admin-user-role">@adminRole</span>
                </div>
            </div>

            <!-- Logout Button Form -->
            <form method="post" asp-page="/Admin/Login" asp-page-handler="Logout" style="margin: 0;">
                <button type="submit" class="admin-btn-logout" title="Keluar dari sesi CMS Admin">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span class="d-none d-sm-inline">Keluar</span>
                </button>
            </form>
        </div>
    </div>
</header>
