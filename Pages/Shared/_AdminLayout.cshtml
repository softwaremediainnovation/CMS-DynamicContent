@using System.Security.Claims
@{
    var activeMenu = (ViewData["ActiveMenu"] as string) ?? "campaigns";
    var adminName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name ?? "Administrator";
    var adminRole = User.FindFirstValue(ClaimTypes.Role) ?? "Admin";
    var userInitial = string.IsNullOrEmpty(adminName) ? "A" : adminName.Substring(0, 1).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --sidebar-width: 260px;
            --bg-sidebar: #0A0E17;
            --bg-main: #0E131F;
            --bg-card: #141B2B;
            --bg-card-hover: #1A2438;
            --bg-subtle: #182236;
            --border-subtle: #1F2C44;
            --border-strong: #2D3E60;
            --primary: #2563EB;
            --primary-hover: #1D4ED8;
            --primary-light: #3B82F6;
            --primary-subtle: rgba(37, 99, 235, 0.12);
            --accent-emerald: #10B981;
            --accent-emerald-subtle: rgba(16, 185, 129, 0.12);
            --accent-amber: #F59E0B;
            --accent-amber-subtle: rgba(245, 158, 11, 0.12);
            --accent-purple: #8B5CF6;
            --accent-purple-subtle: rgba(139, 92, 246, 0.12);
            --danger: #EF4444;
            --danger-subtle: rgba(239, 68, 68, 0.12);
            --text-main: #F8FAFC;
            --text-secondary: #94A3B8;
            --text-tertiary: #64748B;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        /* ========================================================
           SIDEBAR KIRI (Left Sidebar Navigation)
           ======================================================== */
        .admin-sidebar {
            width: var(--sidebar-width);
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border-subtle);
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Sidebar Brand */
        .sidebar-brand-box {
            padding: 22px 20px 20px;
            border-bottom: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: inherit;
        }

        .sidebar-brand-badge {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: linear-gradient(135deg, #2563EB, #1D4ED8);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.35);
            flex-shrink: 0;
        }

        .sidebar-brand-title {
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: #FFFFFF;
            line-height: 1.2;
        }

        .sidebar-brand-sub {
            font-size: 10.5px;
            font-weight: 700;
            color: var(--text-secondary);
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        /* Sidebar Navigation Scrollable Area */
        .sidebar-nav-wrap {
            flex: 1;
            overflow-y: auto;
            padding: 20px 14px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .sidebar-nav-wrap::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar-nav-wrap::-webkit-scrollbar-thumb {
            background: #1F2C44;
            border-radius: 4px;
        }

        .sidebar-section-label {
            font-size: 10.5px;
            font-weight: 700;
            color: var(--text-tertiary);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 0 10px 6px;
        }

        .sidebar-menu-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-nav-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            border-radius: 8px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.15s ease;
            border: 1px solid transparent;
        }

        .sidebar-nav-item-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-nav-item svg {
            width: 17px;
            height: 17px;
            opacity: 0.8;
            flex-shrink: 0;
        }

        .sidebar-nav-item:hover {
            color: #FFFFFF;
            background: var(--bg-subtle);
        }

        .sidebar-nav-item.active {
            color: #FFFFFF;
            background: var(--primary-subtle);
            border-color: rgba(59, 130, 246, 0.28);
            font-weight: 700;
        }

        .sidebar-nav-item.active svg {
            color: var(--primary-light);
            opacity: 1;
        }

        .sidebar-badge {
            font-size: 10px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .sidebar-badge-live {
            background: var(--accent-emerald-subtle);
            color: #34D399;
            border: 1px solid rgba(16, 185, 129, 0.25);
        }

        .sidebar-badge-game {
            background: var(--accent-amber-subtle);
            color: #FBBF24;
            border: 1px solid rgba(245, 158, 11, 0.25);
        }

        /* Sidebar Bottom Profile Card */
        .sidebar-bottom-box {
            padding: 16px;
            border-top: 1px solid var(--border-subtle);
            background: #080C14;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* SignalR Status Indicator */
        .sidebar-engine-pill {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 11.5px;
            font-weight: 600;
            color: #34D399;
            padding: 0 4px;
        }

        .sidebar-status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #10B981;
            box-shadow: 0 0 6px rgba(16, 185, 129, 0.8);
            animation: status-pulse-dot 2s infinite ease-in-out;
        }

        @@keyframes status-pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.85); }
        }

        .sidebar-user-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 8px 10px;
            background: var(--bg-subtle);
            border: 1px solid var(--border-subtle);
            border-radius: 8px;
        }

        .sidebar-user-left {
            display: flex;
            align-items: center;
            gap: 9px;
            overflow: hidden;
        }

        .sidebar-user-avatar {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: #2563EB;
            color: #FFFFFF;
            font-weight: 800;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .sidebar-user-name {
            font-size: 12.5px;
            font-weight: 700;
            color: #FFFFFF;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-user-role {
            font-size: 10px;
            font-weight: 600;
            color: var(--text-secondary);
        }

        .sidebar-btn-logout {
            background: transparent;
            color: var(--text-tertiary);
            border: none;
            padding: 4px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s ease;
        }

        .sidebar-btn-logout:hover {
            color: #F87171;
            background: var(--danger-subtle);
        }

        /* ========================================================
           MAIN CONTENT WRAPPER (Sebelah Kanan Sidebar)
           ======================================================== */
        .admin-main-wrapper {
            margin-left: var(--sidebar-width);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            min-width: 0;
        }

        /* Mobile Header */
        .admin-mobile-topbar {
            display: none;
            background: var(--bg-sidebar);
            border-bottom: 1px solid var(--border-subtle);
            padding: 12px 18px;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .sidebar-toggle-btn {
            background: transparent;
            border: 1px solid var(--border-subtle);
            color: #FFFFFF;
            border-radius: 6px;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        /* Responsive Overlay */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.65);
            backdrop-filter: blur(4px);
            z-index: 999;
        }

        @@media (max-width: 992px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }
            .admin-sidebar.open {
                transform: translateX(0);
            }
            .sidebar-overlay.open {
                display: block;
            }
            .admin-main-wrapper {
                margin-left: 0;
            }
            .admin-mobile-topbar {
                display: flex;
            }
        }

        @@media print {
            .admin-sidebar, .admin-mobile-topbar {
                display: none !important;
            }
            .admin-main-wrapper {
                margin-left: 0 !important;
            }
        }
    </style>
</head>
<body>

    <!-- Mobile Overlay Backdrop -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- ========================================================
         SIDEBAR KIRI (Menu Samping Kiri)
         ======================================================== -->
    <aside class="admin-sidebar" id="adminSidebar">
        <!-- Brand Header -->
        <a href="/Admin" class="sidebar-brand-box" title="Dashboard Utama Admin">
            <div class="sidebar-brand-badge">W</div>
            <div>
                <div class="sidebar-brand-title">Warna Warni</div>
                <div class="sidebar-brand-sub">DOOH CMS Studio</div>
            </div>
        </a>

        <!-- Navigation Scrollable Area -->
        <div class="sidebar-nav-wrap">
            <!-- Section 1: Dynamic Content Utama -->
            <div>
                <div class="sidebar-section-label">Manajemen Utama</div>
                <ul class="sidebar-menu-list">
                    <li>
                        <a href="/Admin" class="sidebar-nav-item @(activeMenu == "campaigns" ? "active" : "")">
                            <div class="sidebar-nav-item-left">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="14" width="7" height="7"></rect>
                                    <rect x="3" y="14" width="7" height="7"></rect>
                                </svg>
                                <span>Kampanye &amp; Konten</span>
                            </div>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/DynamicContents/Create" class="sidebar-nav-item @(activeMenu == "create-content" ? "active" : "")">
                            <div class="sidebar-nav-item-left">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Buat Konten Baru</span>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Section 2: Moderasi Live Audiens -->
            <div>
                <div class="sidebar-section-label">Moderasi Audiens</div>
                <ul class="sidebar-menu-list">
                    <li>
                        <a href="/Admin/PhotoModeration" class="sidebar-nav-item @(activeMenu == "photo-moderation" ? "active" : "")">
                            <div class="sidebar-nav-item-left">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                    <circle cx="12" cy="13" r="4"></circle>
                                </svg>
                                <span>Moderasi Live Photo</span>
                            </div>
                            <span class="sidebar-badge sidebar-badge-live">Live</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/PetModeration" class="sidebar-nav-item @(activeMenu == "pet-moderation" ? "active" : "")">
                            <div class="sidebar-nav-item-left">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                                </svg>
                                <span>Moderasi Aquarium</span>
                            </div>
                            <span class="sidebar-badge sidebar-badge-game">Game</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Section 3: Layar & Pratinjau Publik -->
            <div>
                <div class="sidebar-section-label">Pratinjau Layar</div>
                <ul class="sidebar-menu-list">
                    <li>
                        <a href="/" target="_blank" class="sidebar-nav-item">
                            <div class="sidebar-nav-item-left">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                    <line x1="8" y1="21" x2="16" y2="21"></line>
                                    <line x1="12" y1="17" x2="12" y2="21"></line>
                                </svg>
                                <span>Portal Layar Studio</span>
                            </div>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.6">
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                <polyline points="15 3 21 3 21 9"></polyline>
                                <line x1="10" y1="14" x2="21" y2="3"></line>
                            </svg>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Sidebar Bottom (Profile & Status) -->
        <div class="sidebar-bottom-box">
            <!-- Engine Status -->
            <div class="sidebar-engine-pill">
                <span class="sidebar-status-dot"></span>
                <span>SignalR Engine Aktif</span>
            </div>

            <!-- User Profile & Logout -->
            <div class="sidebar-user-card">
                <div class="sidebar-user-left">
                    <div class="sidebar-user-avatar">@userInitial</div>
                    <div style="min-width: 0;">
                        <div class="sidebar-user-name">@adminName</div>
                        <div class="sidebar-user-role">@adminRole</div>
                    </div>
                </div>

                <form method="post" asp-page="/Admin/Login" asp-page-handler="Logout" style="margin: 0;">
                    <button type="submit" class="sidebar-btn-logout" title="Keluar dari sesi CMS">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- ========================================================
         MAIN CONTENT AREA (Sebelah Kanan)
         ======================================================== -->
    <div class="admin-main-wrapper">
        <!-- Mobile Header Bar -->
        <div class="admin-mobile-topbar">
            <div style="display: flex; align-items: center; gap: 10px;">
                <button class="sidebar-toggle-btn" onclick="toggleSidebar()" title="Buka menu navigasi">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <span style="font-size: 14px; font-weight: 800; color: #FFFFFF;">Warna Warni DOOH</span>
            </div>
            <div class="sidebar-engine-pill" style="font-size: 11px;">
                <span class="sidebar-status-dot"></span>
                <span>Online</span>
            </div>
        </div>

        @RenderBody()
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            if (sidebar && overlay) {
                sidebar.classList.toggle('open');
                overlay.classList.toggle('open');
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
