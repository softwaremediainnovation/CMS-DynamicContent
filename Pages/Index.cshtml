    let activeChannelKey = 'samsung';
    let activeCityIndex = 0;
    let qrInstance = null;

    function switchChannel(channelKey, btnEl) {
        if (!channels[channelKey]) return;
        activeChannelKey = channelKey;
        activeCityIndex = 0;

        // Update active class on sidebar
        document.querySelectorAll('.channel-btn').forEach(btn => btn.classList.remove('active'));
        if (btnEl) btnEl.classList.add('active');

        renderCockpit();
    }

    function selectCity(cityIndex) {
        activeCityIndex = cityIndex;
        renderCockpit();
    }

    function getBaseOrigin() {
        return window.location.origin;
    }

    function renderCockpit() {
        const ch = channels[activeChannelKey];
        const city = ch.cities[activeCityIndex] || ch.cities[0];

        // Meta Titles
        document.getElementById('cockpitCategory').innerText = ch.category;
        document.getElementById('cockpitChannelId').innerText = ch.id;
        document.getElementById('cockpitTitle').innerText = ch.title;
        document.getElementById('cockpitSubtitle').innerText = ch.subtitle;
        document.getElementById('bezelFeedName').innerText = ch.id + ' • ' + city.name.toUpperCase();
        document.getElementById('bezelRuleText').innerText = ch.rule;
        document.getElementById('bezelTechText').innerText = ch.tech;
        document.getElementById('videotronStage').innerHTML = ch.previewHtml;

        // City Pills
        const cityPillsContainer = document.getElementById('cockpitCityPills');
        cityPillsContainer.innerHTML = '';
        ch.cities.forEach((c, idx) => {
            const chip = document.createElement('span');
            chip.className = 'city-chip' + (idx === activeCityIndex ? ' active' : '');
            chip.innerText = c.name;
            chip.onclick = () => selectCity(idx);
            cityPillsContainer.appendChild(chip);
        });

        // Computed URLs
        const fullScreenUrl = ch.screenPath + city.token;
        const fullMobileUrl = getBaseOrigin() + ch.mobilePath + city.token;

        document.getElementById('btnLaunchScreen').href = fullScreenUrl;
        document.getElementById('btnLaunchMobile').href = fullMobileUrl;
        
        const auxBtn = document.getElementById('btnAuxAction');
        if (ch.auxPath) {
            auxBtn.style.display = '';
            auxBtn.href = ch.auxPath.includes('?') ? ch.auxPath : ch.auxPath + city.token;
            auxBtn.querySelector('span').innerText = ch.auxLabel || 'Laporan';
        } else {
            auxBtn.style.display = 'none';
        }

        // Generate Instant QR Code
        const qrContainer = document.getElementById('liveQrContainer');
        qrContainer.innerHTML = '';

        try {
            if (typeof QRCode !== 'undefined') {
                new QRCode(qrContainer, {
                    text: fullMobileUrl,
                    width: 112,
                    height: 112,
                    colorDark: '#070B12',
                    colorLight: '#FFFFFF',
                    correctLevel: QRCode.CorrectLevel.M
                });
            } else {
                qrContainer.innerHTML = '<span style="font-size: 10px; color: #000;">QR Engine</span>';
            }
        } catch (e) {
            console.error('QR Render error: ', e);
        }
    }

    function copyActiveMobileUrl(btnElement) {
        const ch = channels[activeChannelKey];
        const city = ch.cities[activeCityIndex] || ch.cities[0];
        const fullMobileUrl = getBaseOrigin() + ch.mobilePath + city.token;
        copyToClipboard(fullMobileUrl, btnElement);
    }

    function copyToClipboard(text, btnElement) {
        if (!navigator.clipboard) {
            const input = document.createElement('textarea');
            input.value = text;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            showCopyFeedback(btnElement);
            return;
        }

        navigator.clipboard.writeText(text).then(function() {
            showCopyFeedback(btnElement);
        }).catch(function(err) {
            console.error('Clipboard copy error: ', err);
        });
    }

    function showCopyFeedback(btnElement) {
        if (!btnElement) return;
        const span = btnElement.querySelector('span');
        const originalText = span ? span.innerText : btnElement.innerText;
        if (span) {
            span.innerText = 'Tersalin!';
        } else {
            btnElement.innerText = 'Tersalin!';
        }
        btnElement.style.color = '#34D399';
        btnElement.style.borderColor = 'rgba(16, 185, 129, 0.4)';

        setTimeout(function() {
            if (span) {
                span.innerText = originalText;
            } else {
                btnElement.innerText = originalText;
            }
            btnElement.style.color = '';
            btnElement.style.borderColor = '';
        }, 1500);
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        renderCockpit();
    });
